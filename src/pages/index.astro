import ProblemSection from '@/components/sections/ProblemSection.astro';
import SolutionSection from '@/components/sections/SolutionSection.astro';
import ProcessSection from '@/components/sections/ProcessSection.astro';
import ScenariosSection from '@/components/sections/ScenariosSection.astro';
import ComparisonSection from '@/components/sections/ComparisonSection.astro';
import SafetySection from '@/components/sections/SafetySection.astro';
import TeamSection from '@/components/sections/TeamSection.astro';
import VideoSection from '@/components/sections/VideoSection.astro';
