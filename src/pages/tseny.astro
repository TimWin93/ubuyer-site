---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { CONTACTS, SITE_URL } from '@/consts';
import CheckCircle2 from '@lucide/astro/icons/circle-check';
import Star from '@lucide/astro/icons/star';
import Wallet from '@lucide/astro/icons/wallet';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import MessageCircle from '@lucide/astro/icons/message-circle';
import FileText from '@lucide/astro/icons/file-text';
import Receipt from '@lucide/astro/icons/receipt';
import ShieldCheck from '@lucide/astro/icons/shield-check';
import Building2 from '@lucide/astro/icons/building-2';
import MousePointer2 from '@lucide/astro/icons/mouse-pointer-2';
import ShoppingCart from '@lucide/astro/icons/shopping-cart';
import MapPin from '@lucide/astro/icons/map-pin';
import Truck from '@lucide/astro/icons/truck';
import Package from '@lucide/astro/icons/package';
import TrendingUp from '@lucide/astro/icons/trending-up';
import Rocket from '@lucide/astro/icons/rocket';
import Zap from '@lucide/astro/icons/zap';

const title = 'Цены на самовыкупы Wildberries — от 450 ₽/шт | UBuyer';
const description =
  'Стоимость живых самовыкупов на Wildberries: 450–500 ₽/шт в зависимости от объёма. Полный цикл от заказа до отгрузки, договор, акты, 0 банов за 3 года. От 100 выкупов.';

const tg = CONTACTS.telegram;

// AutoSend в чат Анастасии — контекст 'pricing'
const PRICING_MESSAGE = 'Хочу рассчитать стоимость выкупов под мою карточку';
const PRICING_CHAT_URL = `https://t.me/Manager_UBuyer?text=${encodeURIComponent(PRICING_MESSAGE)}`;

const tiers = [
  { volume: 'от 100 выкупов',  price: '500', popular: false, label: 'Старт',       hint: 'для новинок и тестов гипотез' },
  { volume: 'от 500 выкупов',  price: '470', popular: true,  label: 'Популярный',  hint: 'для роста существующей карточки' },
  { volume: 'от 1000 выкупов', price: '450', popular: false, label: 'Объём',       hint: 'для акций, ИУ, масштаба' },
];

const flowSteps = [
  { Icon: MousePointer2, n: '01', title: 'Кликер ищет товар по ключу',  text: 'Живой человек с телефоном листает каталог, смотрит конкурентов, читает отзывы. WB видит органическое поведение — не переходы по прямой ссылке. Если товара нет в выдаче, кликер сигнализирует менеджеру ещё до заказа.' },
  { Icon: ShoppingCart,  n: '02', title: 'Заказ — корзина из нескольких товаров', text: 'Каждый аккаунт берёт корзину: ваш товар плюс несколько позиций других клиентов. Часть заказов намеренно отклоняется — как у реального покупателя. WB видит обычного человека, не аномалию.' },
  { Icon: MapPin,        n: '03', title: 'Выдача в ПВЗ — 3000+ точек',         text: 'Каждый заказ — отдельная точка в другом районе Москвы или МО. WB штрафовал конкурентов именно за кластеризацию: все заборы в одном квартале — красный флаг для алгоритма. У нас нет кластеризации по определению.' },
  { Icon: Truck,         n: '04', title: 'Доставка — свой автопарк',           text: 'Один QR — одна точка. Один и тот же водитель появляется на одном ПВЗ не чаще раза в 80 дней. Никаких газелей, никаких пачек листов с кодами. Со стороны — обычный человек забрал посылку и уехал.' },
  { Icon: Package,       n: '05', title: 'Склад — сортировка и переупаковка',  text: '2500 м² в Москве, без выходных. Расконсолидация → сортировка по клиентам → учёт → переупаковка → отгрузка обратно на WB. Вы видите в реальном времени: что на складе, сколько штук, по каким артикулам.' },
  { Icon: TrendingUp,    n: '06', title: 'Отгрузка обратно — товар в обороте',  text: 'Выкупленный товар возвращается на ваш склад WB. Остатки не сгорают, оборот не страдает. Это и есть отличие живых выкупов от «сжигания товара» — товар не выбывает из продаж.' },
];

const compareThem = [
  { row: 'Аккаунты', val: 'Боты, эмуляторы, виртуальные SIM, свежерегистрации' },
  { row: 'ПВЗ', val: 'Кластеризация — заборы в одном квартале' },
  { row: 'Поведение', val: 'Скрипт, прямые переходы по ссылкам, выкуп через WB-кошелёк' },
  { row: 'Антифрод WB-2026', val: 'СПП-30 дней, пессимизация, каскадное удаление отзывов' },
  { row: 'Договор и акты', val: 'Чаще нет, физлица, без отчётности' },
];
const compareUs = [
  { row: 'Аккаунты', val: 'Профили с историей 3+ лет (3000+), своя SIM и банковская карта' },
  { row: 'ПВЗ', val: '3000+ ПВЗ Москвы и МО, отдельная точка на каждый заказ' },
  { row: 'Поведение', val: 'Кликер ищет вручную, корзина из 2-3 товаров, реальный отказ-ratio' },
  { row: 'Антифрод WB-2026', val: '0 банов клиентов за 3 года работы' },
  { row: 'Договор и акты', val: 'ИП Кирилюк, договор + счёт + акт после каждой партии' },
];

const scenarios = [
  {
    Icon: Rocket,
    badge: 'ЗАПУСК НОВИНКИ',
    tariff: 'Тариф «Старт»',
    price: 'от 100 выкупов · 500 ₽/шт',
    desc: 'Карточка без истории продаж. Нужно вкатить алгоритм, набрать первичные конверсии, разорвать «замкнутый круг новинки».',
    case: '161 выкуп → 25–30 органических заказов в день',
    budget: 'от 50–80к ₽ за услугу + оборотные',
  },
  {
    Icon: TrendingUp,
    badge: 'РОСТ КАРТОЧКИ',
    tariff: 'Тариф «Популярный»',
    price: 'от 500 выкупов · 470 ₽/шт',
    desc: 'Карточка есть, продаётся, но застряла на 30–50 странице. Нужен направленный сигнал по конкретным ключам для подъёма в ТОП.',
    case: '«Лесенка» 50 выкупов/артикул × 100 артикулов за 2+ года → 0 банов',
    budget: 'от 235к ₽ за услугу + оборотные',
  },
  {
    Icon: Zap,
    badge: 'МАСШТАБ · АКЦИИ · ИУ',
    tariff: 'Тариф «Объём»',
    price: 'от 1000 выкупов · 450 ₽/шт',
    desc: 'Большие задачи: вход в акцию по премиальной цене, выполнение плана ИУ, масштабирование магазина с большим ассортиментом.',
    case: '2000 выкупов «лесенка по цене» → акция ×2 выше рынка · 12 000 заказов / 10 дней → план ИУ закрыт',
    budget: 'от 450к ₽ за услугу + оборотные',
  },
];

const timing = [
  { period: '1–2 недели', text: 'Первые изменения позиций — карточка начинает подниматься по основным ключам' },
  { period: '3–4 недели', text: 'Устойчивый рост — позиция закрепляется, появляется органический трафик' },
  { period: '+5–7 дней после', text: 'Карточка продолжает расти — доставляются последние заказы, алгоритм фиксирует устойчивость' },
  { period: 'Дальше', text: 'Зависит от воронки (CTR фото, конверсия в корзину, цена, SEO). Сильная воронка = органика держит позицию' },
];

const faqs = [
  {
    q: 'Почему ваши выкупы дороже рынка?',
    a: 'Цена 450–500 ₽ — это полный цикл с живой инфраструктурой. Кликер ищет товар вручную, выкуп через один из 3000+ ПВЗ, доставка нашим водителем (не агрегатор), переупаковка на нашем складе 2500 м², возврат на ваш склад WB. Дешёвые сервисы (100–150 ₽) обычно работают через софт-клики и кластеризацию ПВЗ — это то, что WB научился ловить через ИМИЗР и пессимизацию в 2026.',
  },
  {
    q: 'Можно ли заказать меньше 100 выкупов?',
    a: 'Технически минимум — 50 выкупов на 1 артикул (это нижняя граница, при которой алгоритм WB замечает изменения). Договор заключаем от 100 заказов. Объём меньше 50 не даёт статистически значимого сигнала — мы за него не берёмся, чтобы клиент не платил за результат, который физически не появится.',
  },
  {
    q: 'От чего зависит итоговая цена?',
    a: 'От объёма (тариф 500/470/450 ₽), от доп.услуг (отзывы +100 ₽/шт по желанию), от упаковочного материала под специфику товара, от оборотных средств (1% комиссии от потраченной суммы). Все компоненты считаем до договора, в итоговой смете нет «всплывающих» сюрпризов.',
  },
  {
    q: 'Что такое оборотные средства и куда они идут?',
    a: 'Это деньги на сами покупки товара на WB — отдельно от оплаты услуг. Уходят через реальные покупки на ваш кабинет (к нам не попадают). Наша комиссия 1% — только от фактически потраченной суммы. Всё, что не потратили — возвращается. Каждое движение фиксируется в вашей Google-таблице ежедневно.',
  },
  {
    q: 'Гарантируете ли вы конкретные позиции?',
    a: 'Нет. Алгоритм WB динамичен, зависит от десятков факторов вне нашего контроля (изменения в выдаче конкурентов, обновления алгоритма, сезонность). Мы гарантируем: выполнение объёма по ТЗ, прозрачный отчёт, возврат товара в оборот, 0 блокировок по нашей вине (так уже 3 года). Реалистичные ожидания обсуждаем до договора.',
  },
  {
    q: 'Можно ли оплатить частями?',
    a: 'Да. Большие стратегии (от 500 выкупов) делим на партии — каждая партия закрывается актом и считается отдельно. Под крупные проекты обсуждаем индивидуальный график платежей. Малые объёмы (100–300) — обычно одной оплатой.',
  },
  {
    q: 'Работаете ли с НДС? С ИП на УСН?',
    a: 'Работаем и с ИП, и с ООО. Безналичный расчёт через расчётный счёт. Систему налогообложения обсуждаем под вашу — у нас гибкость и по УСН, и по НДС.',
  },
  {
    q: 'Что входит в цену кроме самого выкупа?',
    a: 'Кликер ищет товар по ключам вручную · Заказ через корзину с другими товарами (не один артикул) · Выдача через 3000+ ПВЗ — отдельная точка на каждый заказ · Доставка нашими водителями (не агрегатор) · Расконсолидация и сортировка на складе · Переупаковка · Отгрузка обратно на ваш склад WB · Поддержка через Telegram-чат (15–20 наших людей в чате клиента) · Google-таблица с движением каждого выкупа. Дополнительно оплачивается только упаковочный материал и опционально отзывы +100 ₽/шт.',
  },
  {
    q: 'Что если стратегия идёт хуже, чем ожидалось?',
    a: 'Если объём идёт по плану, а карточка не растёт — анализируем причину (часто это слабый CTR фото, плохое SEO внутри карточки, проблемы с ценой). Если мы видим проблему до старта — честно говорим и не берём заявку. Если проблема выяснилась в процессе — корректируем стратегию (бесплатно). Не «качаем» бюджет ради денег.',
  },
  {
    q: 'Куда уходят выкупленные товары?',
    a: 'Возвращаются на ваш склад WB. Это ключевое отличие живых выкупов от «раздач» и софта: товар не выбывает из оборота. Вы продолжаете продавать те же артикулы, просто с прокачанной позицией.',
  },
];

// FAQPage Schema entities — соответствуют DOM ниже
const faqEntities = faqs.map((f) => ({
  '@type': 'Question',
  name: f.q,
  acceptedAnswer: { '@type': 'Answer', text: f.a },
}));
---

<BaseLayout title={title} description={description} path="/tseny/">
  <!-- Schema.org: Service + AggregateOffer + BreadcrumbList + FAQPage -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify([
    {
      '@context': 'https://schema.org',
      '@type': 'Service',
      '@id': `${SITE_URL}/tseny/#service`,
      name: 'Самовыкупы на Wildberries — живые покупатели, полный цикл',
      serviceType: 'Marketplace promotion',
      provider: { '@id': `${SITE_URL}/#organization` },
      areaServed: { '@type': 'Country', name: 'Russia' },
      description:
        'Живые самовыкупы товаров на Wildberries через инфраструктуру 3000+ покупательских профилей и 3000+ ПВЗ Москвы и МО. Полный цикл от заказа до возврата товара на склад WB. 0 блокировок за 3 года.',
      offers: {
        '@type': 'AggregateOffer',
        priceCurrency: 'RUB',
        lowPrice: '450',
        highPrice: '500',
        offerCount: 3,
        offers: [
          {
            '@type': 'Offer',
            name: 'Тариф Старт — от 100 выкупов',
            price: '500',
            priceCurrency: 'RUB',
            priceSpecification: {
              '@type': 'UnitPriceSpecification',
              price: '500',
              priceCurrency: 'RUB',
              unitText: 'выкуп',
              referenceQuantity: { '@type': 'QuantitativeValue', value: '100', unitText: 'шт' },
            },
          },
          {
            '@type': 'Offer',
            name: 'Тариф Популярный — от 500 выкупов',
            price: '470',
            priceCurrency: 'RUB',
            priceSpecification: {
              '@type': 'UnitPriceSpecification',
              price: '470',
              priceCurrency: 'RUB',
              unitText: 'выкуп',
              referenceQuantity: { '@type': 'QuantitativeValue', value: '500', unitText: 'шт' },
            },
          },
          {
            '@type': 'Offer',
            name: 'Тариф Объём — от 1000 выкупов',
            price: '450',
            priceCurrency: 'RUB',
            priceSpecification: {
              '@type': 'UnitPriceSpecification',
              price: '450',
              priceCurrency: 'RUB',
              unitText: 'выкуп',
              referenceQuantity: { '@type': 'QuantitativeValue', value: '1000', unitText: 'шт' },
            },
          },
        ],
      },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE_URL}/` },
        { '@type': 'ListItem', position: 2, name: 'Цены', item: `${SITE_URL}/tseny/` },
      ],
    },
    {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqEntities,
    },
  ])} />

  <!-- =========================== HERO =========================== -->
  <section class="relative pt-14 pb-16 lg:pt-20 lg:pb-24" style="overflow-x: clip;">
    <div class="pointer-events-none absolute inset-0">
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[900px] h-[500px] rounded-full opacity-20 blur-[120px] bg-gradient-to-b from-brand-accent to-transparent"></div>
    </div>
    <div class="pointer-events-none absolute inset-0 opacity-[0.06]" style="background-image: radial-gradient(circle, #3D8EF8 1px, transparent 1px); background-size: 40px 40px;"></div>

    <div class="container relative">
      <div class="max-w-4xl">
        <div class="tag mb-7 !tracking-normal !normal-case">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-accent-2 animate-glow-pulse"></span>
          Цены и условия · Wildberries · OZON
        </div>

        <h1 class="text-brand-text mb-6 text-[1.875rem] sm:text-5xl lg:text-6xl">
          Цены на самовыкупы Wildberries —<br />
          <span class="text-brand-accent text-glow">3 тарифа от 450 ₽/шт</span>
        </h1>

        <p class="text-brand-muted text-lg leading-relaxed mb-10 max-w-3xl">
          Прайс простой: 3 тарифа в зависимости от объёма — 500 / 470 / 450 ₽ за выкуп.
          Ниже подробно: что входит в полный цикл услуги, как считаются оборотные средства
          и почему дешёвые сервисы в 2026 году обходятся дороже из-за пессимизации WB.
        </p>

        <!-- stat-strip -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-10">
          <div class="rounded-2xl border border-brand-border bg-brand-surface px-5 py-4">
            <span class="text-2xl font-bold font-mono text-brand-accent block leading-none mb-1.5">от 450 ₽</span>
            <p class="text-xs text-brand-muted leading-snug">за выкуп при объёме 1000+</p>
          </div>
          <div class="rounded-2xl border border-brand-border bg-brand-surface px-5 py-4">
            <span class="text-2xl font-bold font-mono text-brand-accent block leading-none mb-1.5">100</span>
            <p class="text-xs text-brand-muted leading-snug">минимальный объём для договора</p>
          </div>
          <div class="rounded-2xl border border-brand-border bg-brand-surface px-5 py-4">
            <span class="text-2xl font-bold font-mono text-brand-accent block leading-none mb-1.5">1%</span>
            <p class="text-xs text-brand-muted leading-snug">комиссия с оборотных средств</p>
          </div>
          <div class="rounded-2xl border border-brand-border bg-brand-surface px-5 py-4">
            <span class="text-2xl font-bold font-mono text-brand-accent block leading-none mb-1.5">0</span>
            <p class="text-xs text-brand-muted leading-snug">банов клиентов за 3 года</p>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row gap-3">
          <a href={PRICING_CHAT_URL} class="btn-primary" data-cta="tseny_hero_primary">
            Рассчитать под мою карточку
            <ArrowRight size={16} />
          </a>
          <a href="#vhodit" class="btn-ghost">
            Сначала разобраться, что входит
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================== ТАРИФЫ =========================== -->
  <section id="tariffs" class="section section-alt">
    <div class="container">
      <div class="max-w-2xl mx-auto text-center mb-12">
        <div class="tag mb-5">Стоимость выкупов</div>
        <h2 class="text-brand-text mb-4">Три тарифа в зависимости от объёма</h2>
        <p class="text-brand-muted text-lg">
          Чем больше выкупов в стратегии — тем ниже цена за единицу. Это работает потому что фиксированная
          часть инфраструктуры (профили, ПВЗ, водители, склад) одинаково загружена при объёме 100 и 1000.
        </p>
      </div>

      <!-- 3 тарифа -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 max-w-3xl mx-auto mb-10">
        {tiers.map((t) => (
          <div class={`relative rounded-2xl p-6 text-center flex flex-col items-center gap-2 transition-all ${
            t.popular
              ? 'bg-brand-accent border-2 border-brand-accent-2 shadow-[0_0_48px_rgba(61,142,248,0.55)] sm:scale-[1.06] z-10'
              : 'card'
          }`}>
            {t.popular && (
              <span class="absolute -top-3.5 left-1/2 -translate-x-1/2 text-xs font-bold bg-emerald-500 text-white px-3.5 py-1 rounded-full uppercase tracking-wide whitespace-nowrap">
                Популярный
              </span>
            )}
            <span class={`text-[0.7rem] font-mono uppercase tracking-widest ${t.popular ? 'text-white/70' : 'text-brand-accent'}`}>
              {t.label}
            </span>
            <span class={`text-xs font-medium ${t.popular ? 'text-white/80' : 'text-brand-muted'}`}>
              {t.volume}
            </span>
            <div class="flex items-end gap-1">
              <span class={`text-4xl font-bold font-mono ${t.popular ? 'text-white' : 'text-brand-text'}`}>
                {t.price}
              </span>
              <span class={`text-sm mb-2 ${t.popular ? 'text-white/60' : 'text-brand-muted'}`}>
                ₽/шт
              </span>
            </div>
            <p class={`text-xs leading-snug ${t.popular ? 'text-white/75' : 'text-brand-muted'}`}>
              {t.hint}
            </p>
          </div>
        ))}
      </div>

      <!-- доп-карточка отзывы -->
      <div class="max-w-md mx-auto rounded-2xl border border-brand-accent/25 bg-brand-accent-dim p-5 text-center mb-10">
        <div class="flex items-center justify-center gap-1.5 mb-2">
          <Star size={14} class="text-brand-accent-2" />
          <p class="text-sm font-semibold text-brand-text">
