---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Target from '@lucide/astro/icons/target';
import TrendingUp from '@lucide/astro/icons/trending-up';

const scenarios = await getCollection('scenarii', ({ data }) => !data.draft);
---

<BaseLayout title="Сценарии" description="Сценарии роста карточки на Wildberries через контролируемый оборот." path="/scenarii" noindex={true}>
  <div class="container section">
    <h1 class="mb-12">Сценарии</h1>

    <!-- Featured: рекомендательные полки — точечная стратегия канала -->
    <a
      href="/polki/"
      class="group relative block rounded-3xl border border-brand-border bg-brand-surface
             overflow-hidden hover:border-brand-accent/40 transition-all duration-300 mb-10"
    >
      <div class="pointer-events-none absolute -top-32 -right-32 w-96 h-96 rounded-full
                  opacity-30 blur-3xl bg-gradient-to-br from-brand-accent to-transparent
                  group-hover:opacity-50 transition-opacity duration-500">
      </div>

      <div class="relative p-8 md:p-10">
        <div class="flex items-center gap-3 mb-5">
          <div class="w-10 h-10 rounded-xl bg-brand-accent-dim border border-brand-accent/30
                      flex items-center justify-center shrink-0">
            <Target size={20} class="text-brand-accent" />
          </div>
          <p class="text-brand-accent text-xs uppercase tracking-widest font-semibold">
            FEATURED · РЕКОМЕНДАТЕЛЬНЫЕ ПОЛКИ
          </p>
        </div>

        <h2 class="text-brand-text text-2xl md:text-3xl font-bold leading-tight mb-4">
          Встанем в полки конкретных топ-конкурентов
          <span class="text-brand-accent">за 7 дней</span>
        </h2>

        <p class="text-brand-muted text-base md:text-lg leading-relaxed mb-6 max-w-2xl">
          До 70% выручки крупных селлеров на WB идёт с рекомендательных полок.
          Точечный таргет к нужному топу — то, чего нет в рекламном кабинете WB.
        </p>

        <div class="inline-flex items-center gap-2 text-brand-accent font-semibold
                    group-hover:gap-3 transition-all duration-200">
          <span>Открыть полный разбор канала</span>
          <ArrowRight size={18} class="shrink-0" />
        </div>
      </div>
    </a>

    <!-- Featured: индивидуальные условия — добор оборота до плана -->
    <a
      href="/scenarii/individualnye-usloviya-wb/"
      class="group relative block rounded-3xl border border-brand-border bg-brand-surface
             overflow-hidden hover:border-brand-accent/40 transition-all duration-300 mb-10"
    >
      <div class="pointer-events-none absolute -top-32 -right-32 w-96 h-96 rounded-full
                  opacity-30 blur-3xl bg-gradient-to-br from-brand-accent to-transparent
                  group-hover:opacity-50 transition-opacity duration-500">
      </div>

      <div class="relative p-8 md:p-10">
        <div class="flex items-center gap-3 mb-5">
          <div class="w-10 h-10 rounded-xl bg-brand-accent-dim border border-brand-accent/30
                      flex items-center justify-center shrink-0">
            <TrendingUp size={20} class="text-brand-accent" />
          </div>
          <p class="text-brand-accent text-xs uppercase tracking-widest font-semibold">
            FEATURED · ПЛАН ПО ИУ
          </p>
        </div>

        <h2 class="text-brand-text text-2xl md:text-3xl font-bold leading-tight mb-4">
          Не успеваете выполнить план по индивидуальным условиям?
          <span class="text-brand-accent">Доберём оборот</span>
        </h2>

        <p class="text-brand-muted text-base md:text-lg leading-relaxed mb-6 max-w-2xl">
          Не выполнили план — WB пересчитает квартал по базовым ставкам и выставит доплату
          в десятки миллионов. Закрываем недостающий оборот живыми выкупами в срок.
        </p>

        <div class="inline-flex items-center gap-2 text-brand-accent font-semibold
                    group-hover:gap-3 transition-all duration-200">
          <span>Открыть разбор сегмента</span>
          <ArrowRight size={18} class="shrink-0" />
        </div>
      </div>
    </a>

    <h2 class="text-xl font-semibold mb-6 text-brand-text">Остальные сценарии роста</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {scenarios.map((s) => (
        <a href={`/scenarii/${s.slug}`} class="block border rounded-xl p-6 hover:shadow-md transition-shadow">
          <h3 class="text-lg font-semibold mb-2">{s.data.title}</h3>
          <p class="text-gray-600 text-sm">{s.data.pain}</p>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
