---
import ArrowRight from '@lucide/astro/icons/arrow-right';
import { polkiData } from '@/data/polki';

const d = polkiData.hero;

// AutoSend в чат с Анастасией: текст уходит как первое user-сообщение,
// она отвечает по триггеру из 00-системной-инструкции.md (см. блок про /polki).
// Сообщение максимально явное — чтобы Анастасия не путала «полки» с
// позициями в выдаче или физическими складами (реальный кейс 29.05.2026).
const POLKI_MESSAGE = polkiData.finalCta.chatMessage;
const POLKI_CHAT_URL = `https://t.me/Manager_UBuyer?text=${encodeURIComponent(POLKI_MESSAGE)}`;
---

<section class="relative pt-14 pb-20 lg:pt-20 lg:pb-28" style="overflow-x: clip;">
  <!-- фоновое свечение -->
  <div class="pointer-events-none absolute inset-0">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[900px] h-[500px]
                rounded-full opacity-20 blur-[120px]
                bg-gradient-to-b from-brand-accent to-transparent"></div>
  </div>

  <!-- сетка точек -->
  <div class="pointer-events-none absolute inset-0 opacity-[0.06]"
       style="background-image: radial-gradient(circle, #3D8EF8 1px, transparent 1px); background-size: 40px 40px;"></div>

  <div class="container relative">
    <div class="max-w-3xl">

      <!-- eyebrow -->
      <div class="tag mb-7 reveal !tracking-normal !normal-case">
        <span class="w-1.5 h-1.5 rounded-full bg-brand-accent-2 animate-glow-pulse"></span>
        {d.eyebrow}
      </div>

      <!-- H1 -->
      <h1 class="text-brand-text mb-6 reveal text-[1.875rem] sm:text-5xl lg:text-6xl" style="animation-delay:0.1s">
        {d.h1Pre}
        <span class="text-brand-accent text-glow">{d.h1Accent}</span>
      </h1>

      <!-- lead -->
      <p class="text-brand-text/80 text-lg leading-relaxed mb-8 reveal max-w-2xl" style="animation-delay:0.15s">
        {d.lead}
      </p>

      <!-- буллеты -->
      <ul class="flex flex-col gap-2.5 mb-10 reveal" style="animation-delay:0.2s">
        {d.bullets.map((item) => (
          <li class="flex items-start gap-3 text-sm sm:text-base text-brand-text/75">
            <span class="w-1.5 h-1.5 rounded-full bg-brand-accent shrink-0 mt-2.5"></span>
            <span>{item}</span>
          </li>
        ))}
      </ul>

      <!-- CTA -->
      <div class="flex flex-col sm:flex-row sm:items-center gap-4 reveal mb-12" style="animation-delay:0.3s">
        <a href={POLKI_CHAT_URL} data-magnetic data-cta="hero_primary" class="btn-primary">
          {d.primaryCta}
          <ArrowRight size={16} />
        </a>
        <a href={POLKI_CHAT_URL} data-cta="hero_primary" class="text-brand-accent text-sm hover:text-brand-accent-hover transition-colors">
          {d.secondaryCta} →
        </a>
      </div>

      <!-- trust strip -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 reveal" style="animation-delay:0.4s">
        {d.trustStrip.map((s) => (
          <div class="rounded-2xl border border-brand-border bg-brand-surface px-5 py-4">
            <span class="font-mono font-bold text-2xl text-brand-accent block leading-none mb-2">{s.value}</span>
            <p class="text-xs text-brand-muted leading-snug">{s.caption}</p>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>

<script>
  // scroll reveal
  const observer = new IntersectionObserver(
    (entries) => entries.forEach(e => e.isIntersecting && e.target.classList.add('visible')),
    { threshold: 0.1 }
  );
  document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

  // magnetic CTA (same pattern as HeroSection)
  const isCoarse = window.matchMedia('(pointer: coarse)').matches;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!isCoarse && !reduceMotion) {
    const STRENGTH = 0.22;
    const RADIUS = 90;
    document.querySelectorAll<HTMLElement>('[data-magnetic]').forEach((btn) => {
      btn.style.transition = 'transform 220ms cubic-bezier(0.16, 1, 0.3, 1)';
      btn.style.willChange = 'transform';
      let inside = false;
      window.addEventListener('pointermove', (e) => {
        const r = btn.getBoundingClientRect();
        const cx = r.left + r.width / 2;
        const cy = r.top + r.height / 2;
        const dx = e.clientX - cx;
        const dy = e.clientY - cy;
        const dist = Math.hypot(dx, dy);
        if (dist > RADIUS) {
          if (inside) { btn.style.transform = ''; inside = false; }
          return;
        }
        inside = true;
        btn.style.transform = `translate(${dx * STRENGTH}px, ${dy * STRENGTH}px)`;
      });
      btn.addEventListener('pointerleave', () => {
        btn.style.transform = '';
        inside = false;
      });
    });
  }
</script>
