---
import XCircle from '@lucide/astro/icons/circle-x';
import CheckCircle2 from '@lucide/astro/icons/circle-check';
import Layers from '@lucide/astro/icons/layers';
import { polkiData } from '@/data/polki';

const d = polkiData.mixStrategy;
---

<section class="section">
  <div class="container">

    <div class="max-w-3xl mb-10">
      <div class="tag mb-6">{d.eyebrow}</div>
      <h2 class="text-brand-text mb-5">{d.h2}</h2>
      <p class="text-brand-muted text-lg leading-relaxed">
        {d.intro}
      </p>
    </div>

    <!-- Сравнительная таблица WB Реклама / UBuyer -->
    <div class="rounded-2xl border border-brand-border bg-brand-surface overflow-hidden mb-6">

      <!-- header row -->
      <div class="grid grid-cols-1 md:grid-cols-[180px_1fr_1fr] border-b border-brand-border bg-brand-bg/50">
        <div class="px-5 py-4 hidden md:block">
          <p class="text-brand-muted text-xs uppercase tracking-widest font-semibold">Параметр</p>
        </div>
        <div class="px-5 py-4 border-l border-brand-border md:border-l flex items-center gap-2">
          <XCircle size={16} class="text-red-400/70 shrink-0" />
          <p class="text-brand-text text-xs uppercase tracking-widest font-semibold">WB Реклама</p>
        </div>
        <div class="px-5 py-4 border-l border-brand-border bg-brand-accent-dim/40 flex items-center gap-2">
          <CheckCircle2 size={16} class="text-brand-accent shrink-0" />
          <p class="text-brand-accent text-xs uppercase tracking-widest font-semibold">UBuyer</p>
        </div>
      </div>

      <!-- comparison rows -->
      {d.comparison.map((row) => (
        <div class="grid grid-cols-1 md:grid-cols-[180px_1fr_1fr] border-b border-brand-border last:border-b-0">
          <div class="px-5 py-4 bg-brand-bg/30">
            <p class="text-brand-muted text-xs uppercase tracking-wider font-semibold">{row.param}</p>
          </div>
          <div class="px-5 py-4 border-l border-brand-border">
            <p class="text-brand-muted text-sm leading-relaxed">{row.wbAds}</p>
          </div>
          <div class="px-5 py-4 border-l border-brand-border bg-brand-accent-dim/20">
            <p class="text-brand-text text-sm leading-relaxed">{row.ubuyer}</p>
          </div>
        </div>
      ))}

    </div>

    <!-- Вывод про комбинированную стратегию -->
    <div class="rounded-2xl border border-brand-accent/30 bg-brand-accent-dim p-6 max-w-3xl flex gap-4">
      <Layers size={22} class="text-brand-accent shrink-0 mt-1" />
      <div>
        <p class="text-brand-accent text-xs uppercase tracking-widest font-semibold mb-3">
          {d.conclusion.title}
        </p>
        <p class="text-brand-text/90 text-base leading-relaxed">
          {d.conclusion.body}
        </p>
      </div>
    </div>

  </div>
</section>
