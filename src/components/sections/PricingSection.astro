---
import { CONTACTS } from '@/consts';
import CheckCircle2 from '@lucide/astro/icons/circle-check';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Star from '@lucide/astro/icons/star';
import Info from '@lucide/astro/icons/info';

const tiers = [
  { volume: 'от 100 выкупов', price: '500', popular: false },
  { volume: 'от 500 выкупов', price: '470', popular: true  },
  { volume: 'от 1000 выкупов',price: '450', popular: false },
];
---

<section id="pricing" class="section border-t border-brand-border bg-brand-surface/30">
  <div class="container">
    <div class="max-w-2xl mx-auto text-center mb-14">
      <div class="tag mb-5">Стоимость</div>
      <h2 class="text-brand-text mb-4">Прозрачная стоимость</h2>
      <p class="text-brand-muted text-lg">
        В цену входит полный цикл — от заказа до отгрузки на склад.<br />
        Никаких скрытых платежей.
      </p>
    </div>

    <!-- полоса доверия — официальная работа -->
    <div class="flex flex-wrap justify-center gap-x-8 gap-y-2 mb-12 text-xs text-brand-muted">
      <span class="flex items-center gap-1.5">
        <CheckCircle2 size={12} class="text-brand-accent shrink-0" />
        Договор до старта работ
      </span>
      <span class="flex items-center gap-1.5">
        <CheckCircle2 size={12} class="text-brand-accent shrink-0" />
        Счёт на оплату — для вашей бухгалтерии
      </span>
      <span class="flex items-center gap-1.5">
        <CheckCircle2 size={12} class="text-brand-accent shrink-0" />
        Акты выполненных работ после каждой партии
      </span>
      <span class="flex items-center gap-1.5">
        <CheckCircle2 size={12} class="text-brand-accent shrink-0" />
        Работаем с ИП и ООО
      </span>
    </div>

    <!-- тарифы -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 max-w-2xl mx-auto mb-8">
      {tiers.map((t) => (
        <div class={`relative rounded-2xl p-6 text-center flex flex-col items-center gap-3 transition-all ${
          t.popular
            ? 'bg-brand-accent border border-brand-accent shadow-btn scale-[1.04]'
            : 'card'
        }`}>
          {t.popular && (
            <span class="absolute -top-3 left-1/2 -translate-x-1/2
                         text-xs font-semibold bg-brand-accent-2 text-brand-bg
                         px-3 py-1 rounded-full">
              популярный
            </span>
          )}
          <span class={`text-xs font-medium ${t.popular ? 'text-white/70' : 'text-brand-muted'}`}>
            {t.volume}
          </span>
          <div class="flex items-end gap-1">
            <span class={`text-4xl font-bold font-mono ${t.popular ? 'text-white' : 'text-brand-text'}`}>
              {t.price}
            </span>
            <span class={`text-sm mb-2 ${t.popular ? 'text-white/60' : 'text-brand-muted'}`}>
              руб./шт
            </span>
          </div>
          <CheckCircle2 size={16} class={t.popular ? 'text-white/50' : 'text-brand-accent'} />
        </div>
      ))}
    </div>

    <!-- отзывы -->
    <div class="max-w-sm mx-auto rounded-2xl border border-brand-border bg-brand-surface
                p-5 text-center mb-12">
      <div class="flex items-center justify-center gap-1.5 mb-2">
        <Star size={14} class="text-brand-accent-2" />
        <p class="text-sm font-semibold text-brand-text">
          Отзывы — <span class="text-brand-accent">100 руб./шт</span>
        </p>
      </div>
      <p class="text-xs text-brand-muted">
        Подключите к выкупам — и карточка получает и позиции, и конверсию одновременно
      </p>
    </div>

    <!-- оборотные средства -->
    <div class="max-w-2xl mx-auto rounded-2xl border border-brand-border bg-brand-surface p-5 mb-10">
      <div class="flex items-start gap-4">
        <div class="w-9 h-9 rounded-xl bg-brand-accent/10 border border-brand-accent/20
                    flex items-center justify-center shrink-0 mt-0.5">
          <Info size={16} class="text-brand-accent" />
        </div>
        <div>
          <p class="text-brand-text text-sm font-semibold mb-2">Про оборотные средства</p>
          <p class="text-brand-muted text-sm leading-relaxed mb-3">
            Помимо оплаты услуг вносятся <span class="text-brand-text font-medium">оборотные средства</span> —
            деньги на покупку ваших товаров. Через реальные покупки они поступают
            на ваш кабинет WB, а не к нам. Неизрасходованный остаток возвращается полностью
            по завершении стратегии.
          </p>
          <div class="flex flex-wrap gap-x-5 gap-y-1.5 text-xs text-brand-muted">
            <span class="flex items-center gap-1.5">
              <CheckCircle2 size={12} class="text-brand-accent" />
              Комиссия 1% от фактически потраченной суммы
            </span>
            <span class="flex items-center gap-1.5">
              <CheckCircle2 size={12} class="text-brand-accent" />
              Остаток возвращается полностью
            </span>
            <span class="flex items-center gap-1.5">
              <CheckCircle2 size={12} class="text-brand-accent" />
              Все движения денег — в вашей таблице ежедневно
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- CTA -->
    <div class="text-center">
      <p class="text-brand-muted mb-6 text-sm">
        Точная стоимость зависит от категории и артикула —<br />
        рассчитаем бесплатно за 15 минут.
      </p>
      <a href={CONTACTS.telegram} target="_blank" rel="noopener" class="btn-primary">
        Получить точный расчёт
        <ArrowRight size={16} />
      </a>
      <p class="mt-3 text-xs text-brand-muted">
        Считаем бесплатно &nbsp;·&nbsp; Без обязательств &nbsp;·&nbsp; Ответим в Telegram
      </p>
    </div>
  </div>
</section>
