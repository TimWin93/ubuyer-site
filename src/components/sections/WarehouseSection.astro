---
---

<section class="section border-t border-brand-border bg-brand-surface/30">
  <div class="container">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">

      <!-- левая: текст -->
      <div>
        <div class="tag mb-6">Наша инфраструктура</div>
        <h2 class="text-brand-text mb-5">
          Собственный склад<br />фулфилмента в Москве
        </h2>
        <p class="text-brand-muted text-lg leading-relaxed">
          2 500 м² в Москве. Товар проходит через наши руки от приёмки до возврата на WB —
          без посредников, без сбоев. Это и есть причина нулевых блокировок за 3 года.
        </p>
      </div>

      <!-- правая: превью → клик открывает видео -->
      <div
        class="rounded-2xl border border-brand-border relative group cursor-pointer overflow-hidden"
        id="warehouse-video-trigger"
      >
        <!-- светлый фон под 3D-иллюстрацию -->
        <div class="bg-[#F0F4FF] flex items-center justify-center p-6 lg:p-8">
          <img
            src="/images/warehouse/wh-3d.webp"
            alt="Склад UBuyer"
            width="480"
            height="380"
            loading="lazy"
            class="w-full max-w-sm mx-auto object-contain select-none
                   group-hover:scale-105 transition-transform duration-300"
          />
        </div>

        <!-- полоска снизу с кнопкой -->
        <div class="bg-brand-surface border-t border-brand-border px-5 py-4
                    flex items-center justify-between gap-4">
          <div>
            <p class="text-brand-text text-sm font-semibold">Видео со склада</p>
            <p class="text-brand-muted text-xs mt-0.5">Реальная инфраструктура — посмотрите изнутри</p>
          </div>
          <div class="flex items-center gap-2.5 shrink-0
                      bg-brand-cta hover:bg-brand-cta-hover text-white text-sm font-semibold
                      px-4 py-2.5 rounded-xl transition-colors duration-200 shadow-sm">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="translate-x-0.5">
              <polygon points="5,3 19,12 5,21"/>
            </svg>
            Смотреть
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- Лайтбокс -->
<div
  id="warehouse-video-modal"
  class="fixed inset-0 z-50 items-center justify-center p-4 hidden"
  aria-modal="true"
  role="dialog"
>
  <div id="warehouse-video-backdrop" class="absolute inset-0 bg-black/85 backdrop-blur-sm"></div>

  <div class="relative z-10 w-full max-w-3xl mx-auto">
    <button
      id="warehouse-video-close"
      class="absolute -top-10 right-0 text-white/70 hover:text-white transition-colors p-2"
      aria-label="Закрыть"
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>

    <video
      id="warehouse-video-modal-player"
      src="/videos/warehouse.mp4"
      controls
      playsinline
      class="w-full rounded-2xl shadow-2xl"
    />
  </div>
</div>

<script>
  const trigger  = document.getElementById('warehouse-video-trigger');
  const modal    = document.getElementById('warehouse-video-modal');
  const backdrop = document.getElementById('warehouse-video-backdrop');
  const closeBtn = document.getElementById('warehouse-video-close');
  const player   = document.getElementById('warehouse-video-modal-player') as HTMLVideoElement;

  function openModal() {
    modal?.classList.remove('hidden');
    modal?.classList.add('flex');
    document.body.style.overflow = 'hidden';
    player?.play();
  }

  function closeModal() {
    modal?.classList.remove('flex');
    modal?.classList.add('hidden');
    document.body.style.overflow = '';
    if (player) { player.pause(); player.currentTime = 0; }
  }

  trigger?.addEventListener('click', openModal);
  closeBtn?.addEventListener('click', closeModal);
  backdrop?.addEventListener('click', closeModal);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });
</script>
