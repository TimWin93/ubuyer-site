---
import MapPin from '@lucide/astro/icons/map-pin';
import Star from '@lucide/astro/icons/star';
import Package from '@lucide/astro/icons/package';
import Truck from '@lucide/astro/icons/truck';
import BarChart3 from '@lucide/astro/icons/chart-bar';
import RefreshCcw from '@lucide/astro/icons/refresh-cw';

const services = [
  { icon: Package,     text: 'Приём, хранение и учёт товара' },
  { icon: RefreshCcw,  text: 'Переупаковка и маркировка под стандарты WB/OZON' },
  { icon: Truck,       text: 'Ежедневные отгрузки на склады маркетплейсов' },
  { icon: BarChart3,   text: 'Проверка на брак, расфасовка, расконсолидация' },
];
---

<section class="section border-t border-brand-border bg-brand-surface/30">
  <div class="container">

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">

      <!-- левая: текст -->
      <div>
        <div class="tag mb-6">Наш склад</div>
        <h2 class="text-brand-text mb-5">
          Собственный склад<br />фулфилмента в Москве
        </h2>
        <p class="text-brand-muted text-lg leading-relaxed mb-8">
          2 500 м² в Москве. Принимаем товар клиентов, храним, переупаковываем
          и отгружаем на WB и OZON каждый день — всё под одной крышей.
        </p>

        <!-- цифры -->
        <div class="grid grid-cols-2 gap-3 mb-8">
          <div class="rounded-2xl border border-brand-border bg-brand-surface p-5">
            <p class="text-3xl font-bold font-mono text-brand-text">2 500</p>
            <p class="text-xs text-brand-muted mt-1">м² площадь склада</p>
          </div>
          <div class="rounded-2xl border border-brand-border bg-brand-surface p-5">
            <div class="flex items-center gap-1.5 mb-1">
              <p class="text-3xl font-bold font-mono text-brand-text">4.7</p>
              <Star size={18} class="text-yellow-400 fill-yellow-400 mb-0.5" />
            </div>
            <p class="text-xs text-brand-muted">рейтинг на Яндекс.Картах</p>
          </div>
        </div>

        <!-- адрес -->
        <a
          href="https://yandex.ru/maps/org/yubayyer/103132722552/"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-3 rounded-xl border border-brand-border bg-brand-surface
                 px-4 py-3 text-sm text-brand-muted hover:border-brand-border-2
                 hover:text-brand-text transition-colors mb-8 group"
        >
          <MapPin size={16} class="text-brand-accent shrink-0" />
          <span>ул. Руставели, 14, стр. 12, Москва</span>
          <span class="ml-auto text-brand-accent opacity-0 group-hover:opacity-100 transition-opacity text-xs">
            Открыть карту →
          </span>
        </a>

        <!-- услуги -->
        <ul class="space-y-3">
          {services.map(({ icon: Icon, text }) => (
            <li class="flex items-start gap-3 rounded-xl border border-brand-border
                       bg-brand-surface px-4 py-3 hover:border-brand-border-2 transition-colors">
              <Icon size={16} class="text-brand-accent shrink-0 mt-0.5" />
              <span class="text-sm text-brand-muted">{text}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- правая: фото + карта -->
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div class="rounded-2xl overflow-hidden border border-brand-border col-span-2">
            <img
              src="/images/warehouse/wh-pallets.jpg"
              alt="Склад UBuyer — паллеты с товаром внутри"
              class="w-full h-52 object-cover"
              loading="lazy"
            />
          </div>
          <div class="rounded-2xl overflow-hidden border border-brand-border">
            <img
              src="/images/warehouse/wh-loading.jpg"
              alt="Погрузка товара со склада UBuyer"
              class="w-full h-40 object-cover"
              loading="lazy"
            />
          </div>
          <div class="rounded-2xl overflow-hidden border border-brand-border">
            <img
              src="/images/warehouse/wh-yard.jpg"
              alt="Паллеты с товаром на складе UBuyer"
              class="w-full h-40 object-cover"
              loading="lazy"
            />
          </div>
        </div>

        <!-- Яндекс карта -->
        <div class="rounded-2xl overflow-hidden border border-brand-border h-64 lg:h-72">
          <iframe
            src="https://yandex.ru/map-widget/v1/?org=103132722552&ll=37.600433%2C55.811407&z=16"
            width="100%"
            height="100%"
            frameborder="0"
            allowfullscreen
            loading="lazy"
            title="Склад UBuyer на карте"
          ></iframe>
        </div>
      </div>

    </div>
  </div>
</section>
