---
import Star from '@lucide/astro/icons/star';
---

<section class="section border-t border-brand-border bg-brand-surface/30">
  <div class="container">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">

      <!-- левая: текст -->
      <div>
        <div class="tag mb-6">Наша инфраструктура</div>
        <h2 class="text-brand-text mb-5">
          Собственный склад<br />фулфилмента в Москве
        </h2>
        <p class="text-brand-muted text-lg leading-relaxed mb-8">
          2 500 м² в Москве. Товар проходит через наши руки от приёмки до возврата на WB —
          без посредников, без сбоев. Это и есть причина нулевых блокировок за 3 года.
        </p>

        <!-- цифры -->
        <div class="grid grid-cols-2 gap-3">
          <div class="rounded-2xl border border-brand-border bg-brand-surface p-5">
            <p class="text-3xl font-bold font-mono text-brand-text">2 500</p>
            <p class="text-xs text-brand-muted mt-1">м² площадь склада</p>
          </div>
          <div class="rounded-2xl border border-brand-border bg-brand-surface p-5">
            <div class="flex items-center gap-1.5 mb-1">
              <p class="text-3xl font-bold font-mono text-brand-text">4.7</p>
              <Star size={18} class="text-yellow-400 fill-yellow-400 mb-0.5" />
            </div>
            <p class="text-xs text-brand-muted">рейтинг на Яндекс.Картах</p>
          </div>
        </div>
      </div>

      <!-- правая: видео -->
      <div
        class="rounded-2xl overflow-hidden border border-brand-border relative group cursor-pointer aspect-video"
        id="warehouse-video-trigger"
      >
        <video
          src="/videos/warehouse.mp4"
          autoplay
          muted
          loop
          playsinline
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 flex items-center justify-center
                    bg-black/20 opacity-0 group-hover:opacity-100 transition-opacity duration-200">
          <div class="w-12 h-12 rounded-full bg-white/90 flex items-center justify-center shadow-lg">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="#0A0F1E" class="translate-x-0.5">
              <polygon points="5,3 19,12 5,21"/>
            </svg>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- Лайтбокс -->
<div
  id="warehouse-video-modal"
  class="fixed inset-0 z-50 items-center justify-center p-4 hidden"
  aria-modal="true"
  role="dialog"
>
  <div id="warehouse-video-backdrop" class="absolute inset-0 bg-black/85 backdrop-blur-sm"></div>

  <div class="relative z-10 w-full max-w-3xl mx-auto">
    <button
      id="warehouse-video-close"
      class="absolute -top-10 right-0 text-white/70 hover:text-white transition-colors p-2"
      aria-label="Закрыть"
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>

    <video
      id="warehouse-video-modal-player"
      src="/videos/warehouse.mp4"
      controls
      playsinline
      class="w-full rounded-2xl shadow-2xl"
    />
  </div>
</div>

<script>
  const trigger  = document.getElementById('warehouse-video-trigger');
  const modal    = document.getElementById('warehouse-video-modal');
  const backdrop = document.getElementById('warehouse-video-backdrop');
  const closeBtn = document.getElementById('warehouse-video-close');
  const player   = document.getElementById('warehouse-video-modal-player') as HTMLVideoElement;

  function openModal() {
    modal?.classList.remove('hidden');
    modal?.classList.add('flex');
    document.body.style.overflow = 'hidden';
    player?.play();
  }

  function closeModal() {
    modal?.classList.remove('flex');
    modal?.classList.add('hidden');
    document.body.style.overflow = '';
    if (player) { player.pause(); player.currentTime = 0; }
  }

  trigger?.addEventListener('click', openModal);
  closeBtn?.addEventListener('click', closeModal);
  backdrop?.addEventListener('click', closeModal);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });
</script>
