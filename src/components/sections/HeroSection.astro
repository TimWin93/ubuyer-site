---
import ArrowRight from '@lucide/astro/icons/arrow-right';

// AutoSend: текст уходит как первое user-сообщение в чат Анастасии,
// она сразу отвечает по контексту 'hero' (см. ChatWidget.detectCtaContext).
const HERO_MESSAGE = 'Хочу узнать стратегию выкупов под мой товар';
const HERO_CHAT_URL = `https://t.me/Manager_UBuyer?text=${encodeURIComponent(HERO_MESSAGE)}`;
---

<section class="relative pt-14 pb-20 lg:pt-20 lg:pb-28" style="overflow-x: clip;">
  <!-- фоновое свечение -->
  <div class="pointer-events-none absolute inset-0">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[900px] h-[500px]
                rounded-full opacity-20 blur-[120px]
                bg-gradient-to-b from-brand-accent to-transparent"></div>
  </div>

  <!-- сетка точек -->
  <div class="pointer-events-none absolute inset-0 opacity-[0.06]"
       style="background-image: radial-gradient(circle, #3D8EF8 1px, transparent 1px); background-size: 40px 40px;"></div>

  <div class="container relative">
    <div class="xl:grid xl:grid-cols-[1fr_360px] xl:items-center xl:gap-16">

      <!-- левая колонка -->
      <div class="max-w-3xl xl:max-w-none">

        <!-- бейдж -->
        <div class="tag mb-7 reveal !tracking-normal !normal-case">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-accent-2 animate-glow-pulse"></span>
          Wildberries · OZON · Живая инфраструктура
        </div>

        <!-- заголовок -->
        <h1 class="text-brand-text mb-6 reveal text-[1.875rem] sm:text-5xl lg:text-6xl" style="animation-delay:0.1s">
          Поднимаем карточки
          в топ выдачи на WB
          и OZON через
          <span class="text-brand-accent text-glow"> живые самовыкупы</span>
        </h1>

        <!-- инфраструктура -->
        <ul class="flex flex-col gap-2.5 mb-8 reveal" style="animation-delay:0.2s">
          {[
            'WB видит живых покупателей — аккаунты с многолетней историей',
            'Каждый заказ в отдельном ПВЗ — никакой кластеризации, никаких паттернов',
            'Выкупленный товар возвращается на склад WB — остатки не горят, оборот не страдает',
            'Полный цикл внутри — своя команда, склад и автопарк, не субподряд',
          ].map((item) => (
            <li class="flex items-center gap-3 text-sm sm:text-base text-brand-text/75">
              <span class="w-1.5 h-1.5 rounded-full bg-brand-accent shrink-0"></span>
              {item}
            </li>
          ))}
        </ul>

        <!-- доверие -->
        <div class="inline-flex items-center gap-2 rounded-xl border border-brand-border
                    bg-brand-surface px-4 py-2.5 text-sm text-brand-muted mb-10 reveal"
             style="animation-delay:0.25s">
          <span class="text-brand-accent-2">✓</span>
          Работаем официально — договор, акты, закрывающие документы
        </div>

        <!-- CTA -->
        <div class="flex flex-col sm:flex-row gap-3 reveal" style="animation-delay:0.3s">
          <a href={HERO_CHAT_URL} data-magnetic data-cta="hero_primary" class="btn-primary">
            Узнать стратегию под мой товар
            <ArrowRight size={16} />
          </a>
          <a href="#pricing" class="btn-ghost">
            Посмотреть тарифы
          </a>
        </div>

        <!-- Статы на мобиле/планшете (скрыты на xl где работает правая колонка) -->
        <div class="xl:hidden mt-10 pt-8 border-t border-brand-border reveal" style="animation-delay:0.4s">
          <p class="text-xs text-brand-muted uppercase tracking-widest mb-4">Наша инфраструктура</p>
          <div class="grid grid-cols-2 gap-3">
            {[
              { value: '3000+', label: 'покупательских профилей', sub: 'с историей 3+ лет' },
              { value: '3000+', label: 'ПВЗ в зоне охвата',       sub: 'Москва и МО' },
              { value: '100+',  label: 'человек в команде',        sub: 'кликеры, водители, склад' },
              { value: '0',     label: 'блокировок клиентов',      sub: 'за 3 года работы' },
            ].map((s) => (
              <div class="rounded-2xl border border-brand-border bg-brand-surface px-4 py-4">
                <span class="text-2xl font-bold font-mono text-brand-accent block leading-none mb-1.5">{s.value}</span>
                <p class="text-sm font-semibold text-brand-text leading-snug">{s.label}</p>
                <p class="text-xs text-brand-muted mt-0.5">{s.sub}</p>
              </div>
            ))}
          </div>
        </div>

      </div>

      <!-- правая колонка: статы + стоимость (только xl+) -->
      <div class="hidden xl:flex flex-col gap-3 reveal" style="animation-delay:0.35s">
        {[
          { value: '3000+', label: 'покупательских профилей', sub: 'с историей 3+ лет' },
          { value: '3000+', label: 'ПВЗ в зоне охвата',       sub: 'Москва и МО' },
          { value: '100+',  label: 'человек в команде',        sub: 'кликеры, водители, склад' },
          { value: '0',     label: 'блокировок клиентов',      sub: 'за 3 года работы' },
        ].map((s) => (
          <div class="flex items-center gap-4 rounded-2xl border border-brand-border bg-brand-surface px-5 py-4">
            <span class="text-2xl font-bold font-mono text-brand-accent shrink-0 whitespace-nowrap min-w-[4rem] text-right leading-none">{s.value}</span>
            <div class="border-l border-brand-border pl-4">
              <p class="text-sm font-semibold text-brand-text leading-snug">{s.label}</p>
              <p class="text-xs text-brand-muted mt-0.5">{s.sub}</p>
            </div>
          </div>
        ))}

      </div>

    </div>
  </div>
</section>

<script>
  // scroll reveal
  const observer = new IntersectionObserver(
    (entries) => entries.forEach(e => e.isIntersecting && e.target.classList.add('visible')),
    { threshold: 0.1 }
  );
  document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

  // ── Magnetic CTA: кнопка слегка тянется к курсору в радиусе 90px.
  // На touch / reduced-motion — выключаем (магнит без курсора не имеет смысла,
  // и анимации могут раздражать пользователей с motion-sensitivity).
  const isCoarse = window.matchMedia('(pointer: coarse)').matches;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!isCoarse && !reduceMotion) {
    const STRENGTH = 0.22;
    const RADIUS = 90;
    document.querySelectorAll<HTMLElement>('[data-magnetic]').forEach((btn) => {
      btn.style.transition = 'transform 220ms cubic-bezier(0.16, 1, 0.3, 1)';
      btn.style.willChange = 'transform';
      let inside = false;
      // Слушаем глобальный pointermove, чтобы реагировать на курсор
      // ещё ДО того как он коснётся кнопки — это и есть «магнитное поле».
      window.addEventListener('pointermove', (e) => {
        const r = btn.getBoundingClientRect();
        const cx = r.left + r.width / 2;
        const cy = r.top + r.height / 2;
        const dx = e.clientX - cx;
        const dy = e.clientY - cy;
        const dist = Math.hypot(dx, dy);
        if (dist > RADIUS) {
          if (inside) { btn.style.transform = ''; inside = false; }
          return;
        }
        inside = true;
        btn.style.transform = `translate(${dx * STRENGTH}px, ${dy * STRENGTH}px)`;
      });
      btn.addEventListener('pointerleave', () => {
        btn.style.transform = '';
        inside = false;
      });
    });
  }
</script>
