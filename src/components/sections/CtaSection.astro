---
import ArrowRight from '@lucide/astro/icons/arrow-right';
import BadgeCheck from '@lucide/astro/icons/badge-check';

// AutoSend → чат, контекст 'generic' (финальный CTA — общая квалификация)
const FINAL_MESSAGE = 'Хочу разобрать мою карточку с менеджером';
const FINAL_CHAT_URL = `https://t.me/Manager_UBuyer?text=${encodeURIComponent(FINAL_MESSAGE)}`;
---

<section class="section section-alt relative overflow-hidden">
  <!-- свечение снизу -->
  <div class="pointer-events-none absolute inset-0">
    <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px]
                rounded-full opacity-15 blur-[100px]
                bg-gradient-to-t from-brand-accent to-transparent"></div>
  </div>

  <div class="container relative">
    <div class="max-w-2xl mx-auto text-center">
      <div class="tag mb-6">Начать сейчас</div>
      <h2 class="text-brand-text mb-5">
        Готовы разобрать<br />вашу карточку?
      </h2>
      <p class="text-brand-muted text-lg mb-10 leading-normal text-center">
        Расскажите про задачу — посчитаем объём, объясним механику и ответим на вопросы.
        Без давления. Без скриптов.
      </p>

      <div class="flex flex-col sm:flex-row gap-3 justify-center mb-8">
        <a href={FINAL_CHAT_URL} data-cta="final_primary" class="btn-primary">
          Разобрать мою карточку
          <ArrowRight size={16} />
        </a>
        <a href="#pricing" class="btn-ghost">
          Посмотреть тарифы
        </a>
      </div>

      <!-- три гарантии -->
      <div class="flex flex-wrap justify-center gap-5 text-xs text-brand-muted">
        {['Работаем с ИП и ООО', 'Договор и закрывающие документы', 'Ответим за 15 минут'].map((item) => (
          <div class="flex items-center gap-1.5">
            <BadgeCheck size={13} class="text-brand-accent" />
            {item}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
