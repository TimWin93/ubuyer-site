---
const reviews = [
  { src: '/images/reviews/review-1.jpg', alt: 'Отзыв клиента UBuyer 1' },
  { src: '/images/reviews/review-2.jpg', alt: 'Отзыв клиента UBuyer 2' },
  { src: '/images/reviews/review-3.jpg', alt: 'Отзыв клиента UBuyer 3' },
  { src: '/images/reviews/review-4.jpg', alt: 'Отзыв клиента UBuyer 4' },
  { src: '/images/reviews/review-5.jpg', alt: 'Отзыв клиента UBuyer 5' },
  { src: '/images/reviews/review-6.jpg', alt: 'Отзыв клиента UBuyer 6' },
];

const row1 = reviews.slice(0, 3);
const row2 = reviews.slice(3);
---

<section class="section border-t border-brand-border">
  <div class="container">
    <div class="max-w-2xl mx-auto text-center mb-14">
      <div class="tag mb-5">Отзывы клиентов</div>
      <h2 class="text-brand-text">Что говорят продавцы</h2>
      <p class="text-brand-muted mt-4 text-lg leading-relaxed">
        Скриншоты из наших рабочих чатов — без редактуры и постановки
      </p>
    </div>
  </div>

  <!-- marquee — полная ширина -->
  <div class="marquee-wrapper">
    <div class="mask-left"></div>
    <div class="mask-right"></div>

    <!-- ряд 1: влево -->
    <div class="marquee-track track-left mb-4">
      {[...row1, ...row1, ...row1, ...row1].map((r, i) => (
        <button class="review-card" data-index={i % row1.length} aria-label={`Открыть отзыв ${i % row1.length + 1}`}>
          <img src={r.src} alt={r.alt} loading="lazy" />
        </button>
      ))}
    </div>

    <!-- ряд 2: вправо -->
    <div class="marquee-track track-right">
      {[...row2, ...row2, ...row2, ...row2].map((r, i) => (
        <button class="review-card" data-index={i % row2.length + row1.length} aria-label={`Открыть отзыв ${i % row2.length + row1.length + 1}`}>
          <img src={r.src} alt={r.alt} loading="lazy" />
        </button>
      ))}
    </div>
  </div>

  <div class="container">
    <div class="text-center mt-10">
      <a
        href="https://t.me/Ubuyer_feedback"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-ghost"
      >
        Смотреть все отзывы в Telegram
      </a>
    </div>
  </div>
</section>

<!-- Lightbox -->
<div id="reviews-lightbox" class="lb-overlay" role="dialog" aria-modal="true" aria-hidden="true">
  <button class="lb-close" id="lb-close" aria-label="Закрыть">
    <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
      <path d="M14 4L4 14M4 4l10 10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    </svg>
  </button>

  <button class="lb-nav lb-prev" id="lb-prev" aria-label="Предыдущий отзыв">
    <svg width="22" height="22" viewBox="0 0 22 22" fill="none">
      <path d="M14 17l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>

  <div class="lb-content">
    <img id="lb-img" src="" alt="" />
  </div>

  <button class="lb-nav lb-next" id="lb-next" aria-label="Следующий отзыв">
    <svg width="22" height="22" viewBox="0 0 22 22" fill="none">
      <path d="M8 17l6-6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>

  <div class="lb-dots">
    {reviews.map((_, i) => (
      <button class="lb-dot" data-dot={i} aria-label={`Отзыв ${i + 1}`}></button>
    ))}
  </div>
</div>

<style>
  /* ----- marquee ----- */
  .marquee-wrapper {
    position: relative;
    overflow: hidden;
    padding: 4px 0;
  }
  .mask-left, .mask-right {
    position: absolute;
    top: 0; bottom: 0;
    width: 120px;
    z-index: 10;
    pointer-events: none;
  }
  .mask-left  { left: 0;  background: linear-gradient(to right, #04091A, transparent); }
  .mask-right { right: 0; background: linear-gradient(to left,  #04091A, transparent); }

  .marquee-track {
    display: flex;
    gap: 16px;
    width: max-content;
  }
  .marquee-track:hover { animation-play-state: paused; }
  .track-left  { animation: scroll-left  40s linear infinite; }
  .track-right { animation: scroll-right 45s linear infinite; }

  @keyframes scroll-left  { from { transform: translateX(0); }    to { transform: translateX(-50%); } }
  @keyframes scroll-right { from { transform: translateX(-50%); } to { transform: translateX(0); } }

  .review-card {
    width: 220px;
    height: 300px;
    flex-shrink: 0;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid #1A2B4A;
    padding: 0;
    background: none;
    cursor: pointer;
    transition: border-color 0.2s, transform 0.2s;
  }
  .review-card:hover {
    border-color: #3D8EF8;
    transform: scale(1.03);
  }
  .review-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    pointer-events: none;
  }

  /* ----- lightbox ----- */
  .lb-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(4, 9, 26, 0.96);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }
  .lb-overlay.is-open {
    opacity: 1;
    pointer-events: all;
  }

  .lb-content {
    max-width: min(400px, calc(100vw - 130px));
    max-height: calc(100vh - 110px);
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid #1A2B4A;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.6);
    background: #080F24;
  }
  .lb-content img {
    display: block;
    width: 100%;
    max-height: calc(100vh - 110px);
    object-fit: contain;
  }

  .lb-close {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #0D1A35;
    border: 1px solid #1A2B4A;
    color: #E4ECFF;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s, border-color 0.2s;
    z-index: 10;
  }
  .lb-close:hover { background: #1A2B4A; border-color: #3D8EF8; }

  .lb-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: #0D1A35;
    border: 1px solid #1A2B4A;
    color: #E4ECFF;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s, border-color 0.2s;
    z-index: 10;
  }
  .lb-nav:hover { background: #3D8EF8; border-color: #3D8EF8; }
  .lb-prev { left: 16px; }
  .lb-next { right: 16px; }

  @media (max-width: 480px) {
    .lb-prev { left: 8px; }
    .lb-next { right: 8px; }
    .lb-nav { width: 40px; height: 40px; }
  }

  .lb-dots {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 8px;
  }
  .lb-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #1A2B4A;
    border: none;
    padding: 0;
    cursor: pointer;
    transition: background 0.2s, transform 0.2s;
  }
  .lb-dot.active {
    background: #3D8EF8;
    transform: scale(1.4);
  }
</style>

<script>
  const REVIEWS = [
    { src: '/images/reviews/review-1.jpg', alt: 'Отзыв клиента UBuyer 1' },
    { src: '/images/reviews/review-2.jpg', alt: 'Отзыв клиента UBuyer 2' },
    { src: '/images/reviews/review-3.jpg', alt: 'Отзыв клиента UBuyer 3' },
    { src: '/images/reviews/review-4.jpg', alt: 'Отзыв клиента UBuyer 4' },
    { src: '/images/reviews/review-5.jpg', alt: 'Отзыв клиента UBuyer 5' },
    { src: '/images/reviews/review-6.jpg', alt: 'Отзыв клиента UBuyer 6' },
  ];

  let current = 0;

  const overlay  = document.getElementById('reviews-lightbox') as HTMLElement;
  const lbImg    = document.getElementById('lb-img') as HTMLImageElement;
  const dots     = document.querySelectorAll<HTMLElement>('.lb-dot');
  const tracks   = document.querySelectorAll<HTMLElement>('.marquee-track');

  function open(index: number) {
    current = index;
    render();
    overlay.classList.add('is-open');
    overlay.setAttribute('aria-hidden', 'false');
    tracks.forEach(t => { t.style.animationPlayState = 'paused'; });
    document.body.style.overflow = 'hidden';
  }

  function close() {
    overlay.classList.remove('is-open');
    overlay.setAttribute('aria-hidden', 'true');
    tracks.forEach(t => { t.style.animationPlayState = ''; });
    document.body.style.overflow = '';
  }

  function go(dir: number) {
    current = (current + dir + REVIEWS.length) % REVIEWS.length;
    render();
  }

  function render() {
    lbImg.src = REVIEWS[current].src;
    lbImg.alt = REVIEWS[current].alt;
    dots.forEach((d, i) => d.classList.toggle('active', i === current));
  }

  // Открытие по клику на карточку
  document.querySelectorAll<HTMLElement>('.review-card').forEach(card => {
    card.addEventListener('click', () => {
      open(parseInt(card.dataset.index ?? '0'));
    });
  });

  // Закрытие
  document.getElementById('lb-close')!.addEventListener('click', close);
  overlay.addEventListener('click', e => { if (e.target === overlay) close(); });

  // Навигация
  document.getElementById('lb-prev')!.addEventListener('click', () => go(-1));
  document.getElementById('lb-next')!.addEventListener('click', () => go(1));

  // Точки
  dots.forEach(dot => {
    dot.addEventListener('click', () => {
      current = parseInt(dot.dataset.dot ?? '0');
      render();
    });
  });

  // Клавиатура
  document.addEventListener('keydown', e => {
    if (!overlay.classList.contains('is-open')) return;
    if (e.key === 'Escape')      close();
    if (e.key === 'ArrowLeft')   go(-1);
    if (e.key === 'ArrowRight')  go(1);
  });

  // Свайп на мобиле
  let touchX = 0;
  overlay.addEventListener('touchstart', e => { touchX = e.touches[0].clientX; }, { passive: true });
  overlay.addEventListener('touchend', e => {
    const dx = e.changedTouches[0].clientX - touchX;
    if (Math.abs(dx) > 50) go(dx < 0 ? 1 : -1);
  });
</script>
