---
const reviews = [
  {
    tag: 'Безопасность',
    quote: 'Для нас главным была безопасность выкупов — критически важно избежать штрафов. Ваша стратегия сработала отлично. Карточки вышли в топ. Органика пошла. План выполнен.',
    author: 'Татьяна',
    date: 'декабрь 2025',
    color: '#22c55e',
  },
  {
    tag: 'Сомневался — убедился',
    quote: 'Скажу честно: в начале я сомневался. Думал могут обмануть, не выкупать по нужным ПЗ. Но ошибся! Всё чётко. Приятно иметь дело с профессионалами!',
    author: 'Амрах',
    date: 'декабрь 2025',
    color: '#f97316',
  },
  {
    tag: 'Лучше конкурентов',
    quote: 'Работала с многими компаниями за последние несколько лет. Мне есть с чем сравнить. Просто решила один раз сэкономить. А зря.',
    author: 'Виктория',
    date: 'март 2026',
    color: '#a855f7',
  },
  {
    tag: 'Сервис 24/7',
    quote: 'Всегда на связи — 24 на 7, в выходные, в праздники. Никогда не бросят, лишнего не спросят. Команда шикарная!',
    author: 'Роман',
    date: 'декабрь 2025',
    color: '#3D8EF8',
  },
  {
    tag: 'Органика без рекламы',
    quote: 'Спасибо большое, пробили полки — органика пошла без рекламы. Результаты говорят сами за себя.',
    author: 'Павел',
    date: 'декабрь 2025',
    color: '#3D8EF8',
  },
  {
    tag: 'Конверсии ×1.5',
    quote: 'Карточка поднята по нужным запросам, конверсии выросли в ×1.5. Всё чётко и в срок. Сделано аккуратно.',
    author: 'Юлия',
    date: 'ноябрь 2025',
    color: '#22c55e',
  },
  {
    tag: '300+ выкупов',
    quote: 'Из «попробовать» в «проверенные партнёры». Оформили более 300 самовыкупов — каждый выполнен безупречно.',
    author: 'постоянный клиент',
    date: 'август 2025',
    color: '#f97316',
  },
];

const row1 = reviews.slice(0, 4);
const row2 = reviews.slice(4);
---

<section class="section border-t border-brand-border">
  <div class="container">
    <div class="max-w-2xl mx-auto text-center mb-14">
      <div class="tag mb-5">Отзывы клиентов</div>
      <h2 class="text-brand-text">Что говорят продавцы</h2>
      <p class="text-brand-muted mt-4 text-lg leading-relaxed">
        Реальные слова из рабочих чатов — без редактуры и постановки
      </p>
    </div>
  </div>

  <div class="marquee-wrapper">
    <div class="mask-left"></div>
    <div class="mask-right"></div>

    <!-- ряд 1: влево -->
    <div class="marquee-track track-left mb-4">
      {[...row1, ...row1, ...row1, ...row1].map((r) => (
        <div class="review-card" style={`--accent: ${r.color}`}>
          <div class="review-tag" style={`color: ${r.color}`}>
            <span class="review-tag-dot" style={`background: ${r.color}`}></span>
            {r.tag}
          </div>
          <div class="review-quote-mark">"</div>
          <p class="review-text">{r.quote}</p>
          <div class="review-footer">
            <span class="review-name">— {r.author}</span>
          </div>
        </div>
      ))}
    </div>

    <!-- ряд 2: вправо -->
    <div class="marquee-track track-right">
      {[...row2, ...row2, ...row2, ...row2].map((r) => (
        <div class="review-card" style={`--accent: ${r.color}`}>
          <div class="review-tag" style={`color: ${r.color}`}>
            <span class="review-tag-dot" style={`background: ${r.color}`}></span>
            {r.tag}
          </div>
          <div class="review-quote-mark">"</div>
          <p class="review-text">{r.quote}</p>
          <div class="review-footer">
            <span class="review-name">— {r.author}</span>
          </div>
        </div>
      ))}
    </div>
  </div>

  <div class="container">
    <div class="text-center mt-10">
      <a
        href="https://t.me/Ubuyer_feedback"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-ghost"
      >
        Смотреть все отзывы в Telegram
      </a>
    </div>
  </div>
</section>

<style>
  .marquee-wrapper {
    position: relative;
    overflow: hidden;
    padding: 4px 0;
  }

  .mask-left,
  .mask-right {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 140px;
    z-index: 10;
    pointer-events: none;
  }
  .mask-left  { left: 0;  background: linear-gradient(to right, #04091A, transparent); }
  .mask-right { right: 0; background: linear-gradient(to left,  #04091A, transparent); }

  .marquee-track {
    display: flex;
    gap: 16px;
    width: max-content;
  }
  .track-left  { animation: scroll-left  50s linear infinite; }
  .track-right { animation: scroll-right 55s linear infinite; }

  .marquee-track { cursor: grab; user-select: none; }
  .marquee-track.is-dragging { cursor: grabbing; }

  @keyframes scroll-left  { from { transform: translateX(0); }    to { transform: translateX(-50%); } }
  @keyframes scroll-right { from { transform: translateX(-50%); } to { transform: translateX(0); } }

  /* Карточка */
  .review-card {
    width: 320px;
    min-height: 220px;
    flex-shrink: 0;
    border-radius: 20px;
    padding: 22px 24px 20px;
    background: #080F24;
    border: 1px solid #1A2B4A;
    border-top: 3px solid var(--accent);
    display: flex;
    flex-direction: column;
    gap: 10px;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .review-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.45), 0 0 0 1px var(--accent);
  }

  /* Тег */
  .review-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .review-tag-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  /* Кавычка */
  .review-quote-mark {
    font-size: 72px;
    line-height: 0.55;
    color: var(--accent);
    opacity: 0.25;
    font-family: Georgia, 'Times New Roman', serif;
    margin-top: 6px;
    user-select: none;
  }

  /* Текст */
  .review-text {
    font-size: 14.5px;
    line-height: 1.65;
    color: #C4D4EC;
    flex: 1;
  }

  /* Подвал карточки */
  .review-footer {
    padding-top: 14px;
    border-top: 1px solid #1A2B4A;
    margin-top: auto;
  }
  .review-name {
    font-size: 13px;
    font-weight: 600;
    color: #E4ECFF;
  }

  /* Мобильная версия */
  @media (max-width: 640px) {
    .mask-left,
    .mask-right {
      width: 60px;
    }

    .review-card {
      width: 260px;
      min-height: 190px;
      padding: 18px 20px 16px;
      border-radius: 16px;
    }

    .review-quote-mark {
      font-size: 56px;
    }

    .review-text {
      font-size: 13.5px;
      line-height: 1.6;
    }

    .review-tag {
      font-size: 10px;
    }

    .review-name {
      font-size: 12px;
    }

    .track-left  { animation-duration: 35s; }
    .track-right { animation-duration: 40s; }
  }
</style>

<script>
  const tracks = document.querySelectorAll<HTMLElement>('.marquee-track');

  tracks.forEach(track => {
    const isLeft   = track.classList.contains('track-left');
    const DURATION = isLeft ? 50 : 55; // секунды — совпадают с CSS
    const ANIM     = isLeft ? 'scroll-left' : 'scroll-right';

    let isDragging   = false;
    let startX       = 0;
    let capturedX    = 0;
    let dragDelta    = 0;

    /* текущий translateX из computed style */
    function liveX(): number {
      const t = getComputedStyle(track).transform;
      return t === 'none' ? 0 : new DOMMatrix(t).m41;
    }

    /* нормализуем позицию в диапазон [-halfW, 0] */
    function normalize(x: number): number {
      const halfW = track.scrollWidth / 2;
      let n = x % halfW;
      if (n > 0)      n -= halfW;
      if (n < -halfW) n += halfW;
      return n;
    }

    /* возобновляем CSS-анимацию с нужного места */
    function resumeFrom(x: number) {
      const halfW    = track.scrollWidth / 2;
      const norm     = normalize(x);
      const progress = isLeft
        ? norm / -halfW                    // scroll-left:  0 → -halfW
        : (norm + halfW) / halfW;          // scroll-right: -halfW → 0
      const delayMs  = -progress * DURATION * 1000;

      track.style.transform        = '';
      track.style.animation        = `${ANIM} ${DURATION}s linear infinite`;
      track.style.animationDelay   = `${delayMs}ms`;
      track.style.animationPlayState = 'running';
    }

    /* ---- старт drag ---- */
    function onStart(x: number) {
      isDragging = true;
      startX     = x;
      capturedX  = liveX();
      dragDelta  = 0;

      track.classList.add('is-dragging');
      track.style.animationPlayState = 'paused';
      track.style.transform = `translateX(${capturedX}px)`;
      track.style.animation = 'none';
    }

    /* ---- движение ---- */
    function onMove(x: number) {
      if (!isDragging) return;
      dragDelta = x - startX;
      track.style.transform = `translateX(${capturedX + dragDelta}px)`;
    }

    /* ---- конец drag ---- */
    function onEnd() {
      if (!isDragging) return;
      isDragging = false;
      track.classList.remove('is-dragging');
      resumeFrom(capturedX + dragDelta);
    }

    /* ---- hover: пауза пока не тащим ---- */
    track.addEventListener('mouseenter', () => {
      if (!isDragging) track.style.animationPlayState = 'paused';
    });
    track.addEventListener('mouseleave', () => {
      if (!isDragging) track.style.animationPlayState = 'running';
    });

    /* ---- mouse ---- */
    track.addEventListener('mousedown', e => { e.preventDefault(); onStart(e.clientX); });
    window.addEventListener('mousemove', e => onMove(e.clientX));
    window.addEventListener('mouseup',   ()  => onEnd());

    /* ---- touch ---- */
    track.addEventListener('touchstart', e => onStart(e.touches[0].clientX),            { passive: true });
    track.addEventListener('touchmove',  e => onMove(e.touches[0].clientX),             { passive: true });
    track.addEventListener('touchend',   ()  => onEnd());
  });
</script>
