---
const reviews = [
  { src: '/images/reviews/review-1.jpg', alt: 'Отзыв клиента UBuyer' },
  { src: '/images/reviews/review-2.jpg', alt: 'Отзыв клиента UBuyer' },
  { src: '/images/reviews/review-3.jpg', alt: 'Отзыв клиента UBuyer' },
  { src: '/images/reviews/review-4.jpg', alt: 'Отзыв клиента UBuyer' },
  { src: '/images/reviews/review-5.jpg', alt: 'Отзыв клиента UBuyer' },
  { src: '/images/reviews/review-6.jpg', alt: 'Отзыв клиента UBuyer' },
];
---

<section class="section border-t border-brand-border">
  <div class="container">

    <div class="max-w-2xl mx-auto text-center mb-14">
      <div class="tag mb-5">Отзывы клиентов</div>
      <h2 class="text-brand-text">Что говорят продавцы</h2>
      <p class="text-brand-muted mt-4 text-lg leading-relaxed">
        Скриншоты из наших рабочих чатов — без редактуры и постановки
      </p>
    </div>

    <div class="columns-1 sm:columns-2 lg:columns-3 gap-5">
      {reviews.map((r) => (
        <div class="break-inside-avoid mb-5 rounded-2xl overflow-hidden border border-brand-border
                    hover:border-brand-border-2 transition-colors">
          <img
            src={r.src}
            alt={r.alt}
            class="w-full h-auto block"
            loading="lazy"
          />
        </div>
      ))}
    </div>

    <div class="text-center mt-10">
      <a
        href="https://t.me/Ubuyer_feedback"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-ghost"
      >
        Смотреть все отзывы в Telegram
      </a>
    </div>

  </div>
</section>
