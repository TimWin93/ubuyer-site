---
// Главное конкурентное сравнение на главной — софт vs живые.
// Полный разбор (23 параметра, 4 группы, чек-лист) — в pillar-странице /soft-vs-zhivye/
const CTA_HEADLINE = 'Расскажите про карточку — соберём стратегию роста под вашу нишу';
const CHAT_PREFILL = 'Здравствуйте! Хочу обсудить запуск самовыкупов под мою карточку.';
const CTA_URL = `https://t.me/Manager_UBuyer?text=${encodeURIComponent(CHAT_PREFILL)}`;

const them = [
  'Виртуальные SIM, эмуляторы, выкуп через WB-кошелёк — десятки поведенческих аномалий для антифрода WB',
  'Один курьер забирает 4–5 QR-кодов разных артикулов разных селлеров за заход — паттерн, который ML видит сразу',
  'Каскадное удаление отзывов — теряются даже настоящие. У клиентов «не проходят отзывы», сервис закрывается',
];

const us = [
  'Реальный смартфон, физическая SIM, банковская карта, домашний IP — всё совпадает с поведением живого покупателя',
  'Штатные девушки-курьеры, одна корзина одного клиента за заход (с реальным процентом отказа), ротация ПВЗ ≥ 80 дней — ни одного аномального сигнала',
  '3 года работы — ни один отзыв клиента не был удалён каскадным алгоритмом WB. СПП не снимается',
];
---

<section id="comparison" class="section border-t border-brand-border bg-brand-surface/30">
  <div class="container">
    <div class="max-w-2xl mx-auto text-center mb-12">
      <div class="tag mb-5">Сравнение</div>
      <h2 class="text-brand-text mb-4">Чем мы отличаемся<br />от софт-сервисов</h2>
      <p class="text-brand-muted text-lg">
        9 октября 2024 WB отменил денежные штрафы за самовыкупы — но заменил их на тихую пессимизацию.
        Софты ловятся сразу, живая инфраструктура — нет.
      </p>
    </div>

    <!-- Сравнительная пара -->
    <div class="max-w-4xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
        <!-- Софт -->
        <div class="rounded-2xl border border-red-500/20 bg-red-500/5 p-7">
          <div class="flex items-center gap-2 mb-6">
            <span class="w-2 h-2 rounded-full bg-red-400 shrink-0"></span>
            <span class="text-sm font-semibold text-red-400 uppercase tracking-wider">Софт-сервисы</span>
          </div>
          <ul class="space-y-4">
            {them.map((item) => (
              <li class="flex items-start gap-3 text-sm text-brand-muted leading-relaxed">
                <span class="text-red-400/70 shrink-0 mt-0.5 text-base">✗</span>
                {item}
              </li>
            ))}
          </ul>
        </div>

        <!-- UBuyer -->
        <div class="rounded-2xl border border-brand-accent/30 bg-brand-accent-dim p-7">
          <div class="flex items-center gap-2 mb-6">
            <span class="w-2 h-2 rounded-full bg-brand-accent-2 shrink-0"></span>
            <span class="text-sm font-semibold text-brand-accent-2 uppercase tracking-wider">UBuyer · живые</span>
          </div>
          <ul class="space-y-4">
            {us.map((item) => (
              <li class="flex items-start gap-3 text-sm text-brand-text leading-relaxed">
                <span class="text-emerald-400 shrink-0 mt-0.5 text-base">✓</span>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Вердикт -->
      <div class="rounded-2xl border border-brand-border-2 bg-brand-surface px-6 py-5 text-left mb-10">
        <p class="text-brand-text/90 font-medium leading-relaxed">«Софт — дешевле. Но потеря СПП на 30 дней и каскадное удаление отзывов перекроют экономию в первые недели.»</p>
      </div>

      <!-- ───── Большой CTA на полный разбор ───── -->
      <a
        href="/soft-vs-zhivye/"
        class="group block rounded-2xl border-2 border-brand-accent/40 bg-gradient-to-br from-brand-accent-dim to-brand-surface-2
               hover:border-brand-accent transition-all duration-200 px-7 py-6 mb-10"
      >
        <div class="flex items-center gap-5">
          <span class="shrink-0 w-12 h-12 rounded-xl bg-brand-accent/20 border border-brand-accent/40 flex items-center justify-center">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#3D8EF8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
              <polyline points="14 2 14 8 20 8"/>
              <line x1="16" y1="13" x2="8" y2="13"/>
              <line x1="16" y1="17" x2="8" y2="17"/>
              <line x1="10" y1="9" x2="8" y2="9"/>
            </svg>
          </span>
          <div class="flex-1 min-w-0">
            <div class="text-[11px] uppercase tracking-widest text-brand-accent-2 mb-1.5 font-mono">
              Полный разбор · 23 параметра · 9 минут чтения
            </div>
            <div class="text-brand-text font-semibold leading-snug text-base sm:text-lg">
              Живые vs софт-самовыкупы на WB в 2026:<br/>что изменилось после отмены штрафов и&nbsp;как WB ловит софты
            </div>
          </div>
          <span class="shrink-0 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-accent group-hover:translate-x-0.5 transition-transform">
            Читать
            <svg class="w-4 h-4" viewBox="0 0 16 16" fill="none">
              <path d="M3 8h10m0 0L9 4m4 4l-4 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </div>
      </a>

      <!-- ───── CTA на расчёт → Анастасия ───── -->
      <a
        href={CTA_URL}
        target="_blank"
        rel="noopener"
        data-cta="chip"
        class="group block rounded-2xl
               border border-brand-cta/40 bg-gradient-to-br from-brand-cta/10 to-brand-surface
               hover:border-brand-cta hover:from-brand-cta/15
               transition-all duration-200 ease-out
               px-6 py-5 sm:py-6"
      >
        <div class="flex items-center gap-4">
          <span class="relative shrink-0 w-12 h-12 rounded-full overflow-hidden
                       ring-1 ring-brand-cta/50
                       shadow-[0_0_18px_rgba(16,185,129,0.35)]">
            <img src="/images/anastasiya.jpg" alt="Анастасия" loading="lazy" decoding="async"
                 class="w-full h-full object-cover" />
            <span class="absolute bottom-0 right-0 w-3 h-3 rounded-full bg-brand-cta
                         ring-2 ring-brand-surface"></span>
          </span>
          <div class="flex-1 min-w-0">
            <div class="text-[11px] uppercase tracking-widest text-brand-cta mb-1.5 font-mono">
              Расчёт за 15 минут
            </div>
            <div class="text-brand-text font-semibold leading-snug text-[15px] sm:text-base">
              {CTA_HEADLINE}
            </div>
          </div>
          <span class="shrink-0 inline-flex items-center gap-1.5
                       text-sm font-semibold text-brand-cta
                       group-hover:translate-x-0.5 transition-transform">
            Получить расчёт
            <svg class="w-4 h-4" viewBox="0 0 16 16" fill="none">
              <path d="M3 8h10m0 0L9 4m4 4l-4 4" stroke="currentColor" stroke-width="1.7"
                    stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </div>
      </a>
    </div>
  </div>
</section>
