---
import MessageSquare from '@lucide/astro/icons/message-square';
import FileText from '@lucide/astro/icons/file-text';
import Zap from '@lucide/astro/icons/zap';
import BarChart2 from '@lucide/astro/icons/chart-bar';
const bars = [
  { day: '1', h: 40 },
  { day: '2', h: 50 },
  { day: '3', h: 65 },
  { day: '4', h: 100 },
  { day: '5', h: 100 },
  { day: '6', h: 95 },
  { day: '7', h: 50 },
];

const stratPoints = [
  {
    title: 'Нарастание → плато → выход',
    text: 'Объём плавно растёт, держится на пике и снижается — в расчёте на то, что органика начинает подхватывать позицию.',
  },
  {
    title: 'Забор растянут на 3 дня',
    text: 'Заказы одного дня разбиваются на 3 дня забора. Нет аномалии «100 человек заказали — все пришли в один день».',
  },
  {
    title: 'Реклама включена с первого дня',
    text: 'Товар виден на рекламных позициях — органические переходы размывают выкупной трафик и снимают подозрения алгоритма.',
  },
];

const steps = [
  {
    Icon: MessageSquare,
    num: '01',
    title: 'Заявка и расчёт',
    text: 'Оставляете заявку. Менеджер считает оптимальный объём под ваш артикул, нишу и цель. Отвечаем в течение 15 минут.',
  },
  {
    Icon: FileText,
    num: '02',
    title: 'ТЗ и договор',
    text: 'Фиксируем ключи, полки, темп, объём. Подписываем договор — работаем официально, с актами и безналом.',
  },
  {
    Icon: Zap,
    num: '03',
    title: 'Запуск',
    text: 'Через 24 часа после оплаты кликеры уже в работе. Каждый заказ, каждое ПВЗ, каждый день — в вашей таблице.',
  },
  {
    Icon: BarChart2,
    num: '04',
    title: 'Рост позиций',
    text: 'Видите динамику по каждому ключу ежедневно. Корректировки стратегии — в реальном времени через Telegram-чат.',
  },
];
---

<section class="section border-t border-brand-border bg-brand-surface/30">
  <div class="container">
    <div class="max-w-2xl mx-auto text-center mb-14">
      <div class="tag mb-5">Процесс</div>
      <h2 class="text-brand-text text-2xl sm:text-3xl md:text-4xl">
        Четыре шага — от заявки до результата
      </h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {steps.map(({ Icon, num, title, text }, i) => (
        <div class="relative card group">
          <!-- стрелка между шагами -->
          {i < steps.length - 1 && (
            <div class="hidden lg:block absolute top-10 -right-3 z-10 text-brand-border-2">
              →
            </div>
          )}
          <div class="flex items-start gap-3 mb-4">
            <div class="w-9 h-9 rounded-lg bg-brand-accent/10 border border-brand-accent/20
                        flex items-center justify-center shrink-0">
              <Icon size={16} class="text-brand-accent" />
            </div>
            <span class="font-mono text-brand-muted text-xs pt-2.5 font-medium">{num}</span>
          </div>
          <h3 class="text-brand-text mb-2">{title}</h3>
          <p class="text-brand-muted text-sm leading-relaxed">{text}</p>
        </div>
      ))}
    </div>

    <p class="text-center text-xs text-brand-muted mt-8">
      Минимальный заказ: 100 выкупов &nbsp;·&nbsp; Минимум 50 выкупов на 1 артикул
    </p>

    <!-- визуализация стратегии -->
    <div class="mt-12 rounded-2xl border border-brand-border bg-brand-surface p-6 sm:p-10
                grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">

      <!-- бар-чарт -->
      <div>
        <p class="text-xs text-brand-muted uppercase tracking-wider font-semibold mb-6">
          Пример: 1 000 выкупов за 7 дней
        </p>
        <div class="bar-chart-container flex items-end gap-2 h-24 mb-2">
          {bars.map((b, i) => (
            <div
              class="flex-1 rounded-t-md bg-brand-accent/50 hover:bg-brand-accent"
              style={`--bar-i: ${i}; height: 0; transition: height 0.6s ease; transition-delay: calc(var(--bar-i) * 80ms)`}
              data-h={b.h}
            ></div>
          ))}
        </div>
        <div class="flex gap-2">
          {bars.map((b) => (
            <div class="flex-1 text-center text-[10px] text-brand-muted font-mono">{b.day}</div>
          ))}
        </div>
        <div class="flex items-center gap-4 mt-4 text-[10px] text-brand-muted">
          <span class="flex items-center gap-1.5">
            <span class="w-3 h-3 rounded-sm bg-brand-accent/50 inline-block shrink-0"></span>
            заказы / день
          </span>
          <span>нарастание → плато → выход</span>
        </div>
      </div>

      <!-- объяснение -->
      <div class="space-y-6">
        {stratPoints.map((p) => (
          <div class="flex items-start gap-3">
            <span class="w-1.5 h-1.5 rounded-full bg-brand-accent shrink-0 mt-2"></span>
            <div>
              <p class="text-brand-text text-sm font-semibold mb-1">{p.title}</p>
              <p class="text-brand-muted text-sm leading-relaxed">{p.text}</p>
            </div>
          </div>
        ))}
      </div>

    </div>

  </div>
</section>

<script>
  // Анимация бар-чарта при скролле
  const barObs = new IntersectionObserver(([entry]) => {
    if (entry.isIntersecting) {
      entry.target.querySelectorAll('[data-h]').forEach(bar => {
        (bar as HTMLElement).style.height = (bar as HTMLElement).dataset.h + '%';
      });
      barObs.disconnect();
    }
  }, { threshold: 0.5 });
  const chartEl = document.querySelector('.bar-chart-container');
  if (chartEl) barObs.observe(chartEl);

</script>

