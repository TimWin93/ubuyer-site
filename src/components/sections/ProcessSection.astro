---
import MessageSquare from '@lucide/astro/icons/message-square';
import FileText from '@lucide/astro/icons/file-text';
import Zap from '@lucide/astro/icons/zap';
import BarChart2 from '@lucide/astro/icons/chart-bar';
import MousePointer2 from '@lucide/astro/icons/mouse-pointer-2';
import ShoppingCart from '@lucide/astro/icons/shopping-cart';
import MapPin from '@lucide/astro/icons/map-pin';
import Truck from '@lucide/astro/icons/truck';
import Package from '@lucide/astro/icons/package';
import TrendingUp from '@lucide/astro/icons/trending-up';

const bars = [
  { day: '1', h: 40 },
  { day: '2', h: 50 },
  { day: '3', h: 65 },
  { day: '4', h: 100 },
  { day: '5', h: 100 },
  { day: '6', h: 95 },
  { day: '7', h: 50 },
];

const stratPoints = [
  {
    title: 'Нарастание → плато → выход',
    text: 'Объём плавно растёт, держится на пике и снижается — в расчёте на то, что органика начинает подхватывать позицию.',
  },
  {
    title: 'Забор растянут на 3 дня',
    text: 'Заказы одного дня разбиваются на 3 дня забора. Нет аномалии «100 человек заказали — все пришли в один день».',
  },
  {
    title: 'Реклама включена с первого дня',
    text: 'Товар виден на рекламных позициях — органические переходы размывают выкупной трафик и снимают подозрения алгоритма.',
  },
];

const flowNodes = [
  {
    Icon: MousePointer2,
    label: 'Кликер',
    sub: 'Ищет товар вручную\nпо ключевому слову',
    highlight: false,
    num: '01',
    details: 'Живой человек с телефоном листает каталог, смотрит конкурентов, читает отзывы. WB видит органическое поведение — не переходы по прямой ссылке. Если товар не находится в выдаче, кликер сигнализирует менеджеру ещё до оформления заказа. Боты так не делают.',
  },
  {
    Icon: ShoppingCart,
    label: 'Заказ',
    sub: 'Корзина из нескольких\nтоваров разных клиентов',
    highlight: false,
    num: '02',
    details: 'Каждый аккаунт берёт корзину: ваш товар плюс несколько позиций других клиентов. Часть заказов намеренно отклоняется — как у реального покупателя. Нет аномалии «100 аккаунтов, у каждого ровно по 1 товару». WB видит обычного человека с разными интересами.',
  },
  {
    Icon: MapPin,
    label: 'ПВЗ',
    sub: 'Водитель забирает\n1 QR = 1 точка',
    highlight: false,
    num: '03',
    details: '2 600+ ПВЗ по Москве и МО. Каждый заказ — отдельная точка в другом районе. WB штрафовал конкурентов именно за кластеризацию: все заборы в одном квартале — красный флаг для алгоритма. У нас нет кластеризации по определению.',
  },
  {
    Icon: Truck,
    label: 'Доставка',
    sub: 'На склад в тот же день\nдевушка, свой авто',
    highlight: false,
    num: '04',
    details: 'Один QR — одна точка. Один и тот же водитель появляется на одном ПВЗ не чаще раза в 80 дней. Никаких газелей, никаких пачек листов с кодами. Со стороны — обычный человек забрал посылку и уехал.',
  },
  {
    Icon: Package,
    label: 'Склад',
    sub: 'Сортировка, учёт\nотгрузка обратно на WB',
    highlight: false,
    num: '05',
    details: '2 000 м², без выходных. Расконсолидация → сортировка по клиентам → учёт → переупаковка → отгрузка обратно на WB. Вы видите в реальном времени: что на складе, сколько штук, по каким артикулам. Товар возвращается к вам в оборот.',
  },
  {
    Icon: TrendingUp,
    label: 'Результат ✓',
    sub: 'WB фиксирует продажу\nпозиция идёт вверх',
    highlight: true,
    num: '06',
    details: 'WB записывает продажу в алгоритм в момент забора с ПВЗ. Позиция начинает расти с первых дней стратегии. Цель — раскачать карточку до уровня, где органика перебивает выкупной трафик. Мы незаметно уходим. Вы остаётесь наверху.',
  },
];

const steps = [
  {
    Icon: MessageSquare,
    num: '01',
    title: 'Заявка и расчёт',
    text: 'Вы оставляете заявку. Мы считаем оптимальный объём под ваш артикул и задачу.',
  },
  {
    Icon: FileText,
    num: '02',
    title: 'ТЗ и договор',
    text: 'Фиксируем в техническом задании. Подписываем договор. Всё официально.',
  },
  {
    Icon: Zap,
    num: '03',
    title: 'Запуск',
    text: 'Наши люди делают заказы. Следим за каждым этапом — заказ, выкуп, возврат.',
  },
  {
    Icon: BarChart2,
    num: '04',
    title: 'Отчёт и рост',
    text: 'Получаете отчёт по каждому артикулу. Видите рост позиций в динамике.',
  },
];
---

<section class="section border-t border-brand-border bg-brand-surface/30">
  <div class="container">
    <div class="max-w-2xl mx-auto text-center mb-14">
      <div class="tag mb-5">Процесс</div>
      <h2 class="text-brand-text text-2xl sm:text-3xl md:text-4xl">
        Четыре шага — от заявки до результата
      </h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {steps.map(({ Icon, num, title, text }, i) => (
        <div class="relative card group">
          <!-- стрелка между шагами -->
          {i < steps.length - 1 && (
            <div class="hidden lg:block absolute top-10 -right-3 z-10 text-brand-border-2">
              →
            </div>
          )}
          <div class="flex items-start gap-3 mb-4">
            <div class="w-9 h-9 rounded-lg bg-brand-accent/10 border border-brand-accent/20
                        flex items-center justify-center shrink-0">
              <Icon size={16} class="text-brand-accent" />
            </div>
            <span class="font-mono text-brand-muted text-xs pt-2.5 font-medium">{num}</span>
          </div>
          <h3 class="text-brand-text mb-2">{title}</h3>
          <p class="text-brand-muted text-sm leading-relaxed">{text}</p>
        </div>
      ))}
    </div>

    <p class="text-center text-xs text-brand-muted mt-8">
      Минимальный заказ: 100 выкупов &nbsp;·&nbsp; Минимум 50 выкупов на 1 артикул
    </p>

    <!-- визуализация стратегии -->
    <div class="mt-12 rounded-2xl border border-brand-border bg-brand-surface p-6 sm:p-10
                grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">

      <!-- бар-чарт -->
      <div>
        <p class="text-xs text-brand-muted uppercase tracking-wider font-semibold mb-6">
          Пример: 1 000 выкупов за 7 дней
        </p>
        <div class="flex items-end gap-2 h-24 mb-2">
          {bars.map((b) => (
            <div
              class="flex-1 rounded-t-md bg-brand-accent/50 hover:bg-brand-accent transition-colors duration-150"
              style={`height: ${b.h}%`}
            ></div>
          ))}
        </div>
        <div class="flex gap-2">
          {bars.map((b) => (
            <div class="flex-1 text-center text-[10px] text-brand-muted font-mono">{b.day}</div>
          ))}
        </div>
        <div class="flex items-center gap-4 mt-4 text-[10px] text-brand-muted">
          <span class="flex items-center gap-1.5">
            <span class="w-3 h-3 rounded-sm bg-brand-accent/50 inline-block shrink-0"></span>
            заказы / день
          </span>
          <span>нарастание → плато → выход</span>
        </div>
      </div>

      <!-- объяснение -->
      <div class="space-y-6">
        {stratPoints.map((p) => (
          <div class="flex items-start gap-3">
            <span class="w-1.5 h-1.5 rounded-full bg-brand-accent shrink-0 mt-2"></span>
            <div>
              <p class="text-brand-text text-sm font-semibold mb-1">{p.title}</p>
              <p class="text-brand-muted text-sm leading-relaxed">{p.text}</p>
            </div>
          </div>
        ))}
      </div>

    </div>

    <!-- Flow-диаграмма полного цикла -->
    <div class="mt-14">
      <div class="max-w-2xl mx-auto text-center mb-10">
        <p class="text-xs text-brand-muted uppercase tracking-wider font-semibold mb-2">Полный цикл</p>
        <h3 class="text-brand-text text-xl sm:text-2xl font-semibold">Как работает каждый выкуп</h3>
        <p class="text-brand-muted text-sm mt-3">От нажатия кнопки «Купить» до роста позиции в выдаче</p>
      </div>

      <div class="rounded-2xl border border-brand-border bg-brand-surface p-6 sm:p-10">

        <!-- Узлы -->
        <div class="overflow-x-auto">
          <div class="flex items-start gap-0 min-w-[680px] lg:min-w-0" id="flow-diagram">
            {flowNodes.map(({ Icon, label, sub, highlight, num }, i) => (
              <>
                <button
                  class="flow-node flex flex-col items-center text-center flex-1 px-1 group cursor-pointer"
                  style={`--i: ${i}`}
                  data-flow-index={i}
                  aria-pressed="false"
                  type="button"
                >
                  <div class={`flow-icon w-12 h-12 rounded-xl flex items-center justify-center mb-3 transition-all duration-200
                    ${highlight
                      ? 'bg-brand-accent/20 border border-brand-accent/50 shadow-[0_0_16px_rgba(61,142,248,0.25)]'
                      : 'bg-brand-accent/10 border border-brand-accent/20 group-hover:bg-brand-accent/20 group-hover:border-brand-accent/40'}`}>
                    <Icon size={20} class={`transition-colors duration-200 ${highlight ? 'text-brand-accent-2' : 'text-brand-accent'}`} />
                  </div>
                  <p class={`flow-label text-sm font-semibold mb-1 transition-colors duration-200 ${highlight ? 'text-brand-accent-2' : 'text-brand-text'}`}>
                    {label}
                  </p>
                  <p class="text-brand-muted text-[11px] leading-snug whitespace-pre-line">{sub}</p>
                </button>

                {i < flowNodes.length - 1 && (
                  <div
                    class="flow-arr flex items-center justify-center shrink-0 mt-4 px-0.5"
                    style={`--i: ${i + 0.5}`}
                  >
                    <svg width="28" height="14" viewBox="0 0 28 14" fill="none" aria-hidden="true">
                      <line x1="2" y1="7" x2="21" y2="7"
                        stroke="#3D8EF8" stroke-width="1.5"
                        stroke-dasharray="4 3" stroke-opacity="0.55" />
                      <path d="M18 4L23 7L18 10"
                        stroke="#3D8EF8" stroke-width="1.5"
                        stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </div>
                )}
              </>
            ))}
          </div>
        </div>

        <!-- Раскрывающаяся панель -->
        <div id="flow-panel" class="mt-8 overflow-hidden" style="max-height: 0; opacity: 0; transition: max-height 0.35s ease, opacity 0.3s ease;">
          <div class="border-t border-brand-border pt-6">
            <div class="flex items-center gap-3 mb-3">
              <span id="flow-panel-num" class="font-mono text-[11px] text-brand-muted font-semibold"></span>
              <span class="w-px h-4 bg-brand-border shrink-0"></span>
              <h4 id="flow-panel-title" class="text-brand-accent text-sm font-semibold"></h4>
            </div>
            <p id="flow-panel-text" class="text-brand-muted text-sm leading-relaxed max-w-2xl"></p>
          </div>
        </div>

      </div>

      <p class="text-center text-xs text-brand-muted mt-4 opacity-60">Нажмите на любой шаг, чтобы узнать подробнее</p>
    </div>

  </div>
</section>

<script>
  // Данные для панели — синхронизированы с flowNodes
  const nodeData = [
    {
      num: '01',
      title: 'Кликер',
      text: 'Живой человек с телефоном листает каталог, смотрит конкурентов, читает отзывы. WB видит органическое поведение — не переходы по прямой ссылке. Если товар не находится в выдаче, кликер сигнализирует менеджеру ещё до оформления заказа. Боты так не делают.',
    },
    {
      num: '02',
      title: 'Заказ',
      text: 'Каждый аккаунт берёт корзину: ваш товар плюс несколько позиций других клиентов. Часть заказов намеренно отклоняется — как у реального покупателя. Нет аномалии «100 аккаунтов, у каждого ровно по 1 товару». WB видит обычного человека с разными интересами.',
    },
    {
      num: '03',
      title: 'ПВЗ',
      text: '2 600+ ПВЗ по Москве и МО. Каждый заказ — отдельная точка в другом районе. WB штрафовал конкурентов именно за кластеризацию: все заборы в одном квартале — красный флаг для алгоритма. У нас нет кластеризации по определению.',
    },
    {
      num: '04',
      title: 'Доставка',
      text: 'Один QR — одна точка. Один и тот же водитель появляется на одном ПВЗ не чаще раза в 80 дней. Никаких газелей, никаких пачек листов с кодами. Со стороны — обычный человек забрал посылку и уехал.',
    },
    {
      num: '05',
      title: 'Склад',
      text: '2 000 м², без выходных. Расконсолидация → сортировка по клиентам → учёт → переупаковка → отгрузка обратно на WB. Вы видите в реальном времени: что на складе, сколько штук, по каким артикулам. Товар возвращается к вам в оборот.',
    },
    {
      num: '06',
      title: 'Результат ✓',
      text: 'WB записывает продажу в алгоритм в момент забора с ПВЗ. Позиция начинает расти с первых дней стратегии. Цель — раскачать карточку до уровня, где органика перебивает выкупной трафик. Мы незаметно уходим. Вы остаётесь наверху.',
    },
  ];

  // Intersection Observer — stagger-анимация появления
  const diagram = document.getElementById('flow-diagram');
  if (diagram) {
    const obs = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('flow-active');
          obs.disconnect();
          // Открываем первую панель автоматически после анимации
          setTimeout(() => activateNode(0), 700);
        }
      },
      { threshold: 0.25 }
    );
    obs.observe(diagram);
  }

  // Логика раскрывающейся панели
  const panel     = document.getElementById('flow-panel');
  const panelNum  = document.getElementById('flow-panel-num');
  const panelTitle= document.getElementById('flow-panel-title');
  const panelText = document.getElementById('flow-panel-text');
  const buttons   = document.querySelectorAll('[data-flow-index]');

  let activeIndex = -1;

  function activateNode(idx) {
    if (!panel || !panelNum || !panelTitle || !panelText) return;

    // Снимаем все active
    buttons.forEach((btn) => {
      btn.setAttribute('aria-pressed', 'false');
      btn.classList.remove('flow-node-active');
    });

    if (activeIndex === idx) {
      // Повторный клик — закрываем
      panel.style.maxHeight = '0';
      panel.style.opacity   = '0';
      activeIndex = -1;
      return;
    }

    // Активируем нажатый
    const btn = document.querySelector(`[data-flow-index="${idx}"]`);
    btn?.setAttribute('aria-pressed', 'true');
    btn?.classList.add('flow-node-active');

    // Обновляем текст (fade-trick: скрыть → поменять → показать)
    panel.style.opacity = '0';
    setTimeout(() => {
      const data = nodeData[idx];
      panelNum.textContent   = data.num;
      panelTitle.textContent = data.title;
      panelText.textContent  = data.text;
      panel.style.maxHeight  = '200px';
      panel.style.opacity    = '1';
    }, activeIndex === -1 ? 0 : 120);

    activeIndex = idx;
  }

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const idx = parseInt(btn.getAttribute('data-flow-index') ?? '0', 10);
      activateNode(idx);
    });
  });
</script>

<style>
  /* Stagger-анимация появления */
  .flow-node,
  .flow-arr {
    opacity: 0;
    transform: translateX(-10px);
    transition: opacity 0.45s ease, transform 0.45s ease;
    transition-delay: calc(var(--i) * 110ms);
  }
  .flow-active .flow-node,
  .flow-active .flow-arr {
    opacity: 1;
    transform: translateX(0);
  }

  /* Активный узел */
  .flow-node-active .flow-icon {
    background-color: rgba(61, 142, 248, 0.25) !important;
    border-color: rgba(61, 142, 248, 0.6) !important;
    box-shadow: 0 0 20px rgba(61, 142, 248, 0.3);
    transform: scale(1.08);
  }
  .flow-node-active .flow-label {
    color: #4DD9FF !important;
  }

  /* Панель — плавное появление */
  #flow-panel {
    transition: max-height 0.35s ease, opacity 0.3s ease;
  }

  /* Кнопки — убираем дефолтный outline, заменяем своим */
  [data-flow-index] {
    background: none;
    border: none;
    padding: 0;
    outline: none;
  }
  [data-flow-index]:focus-visible .flow-icon {
    box-shadow: 0 0 0 2px #3D8EF8;
  }
</style>
