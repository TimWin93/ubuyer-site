---
---

<section class="section border-t border-brand-border" id="strategy-quiz">
  <div class="container">

    <div class="max-w-2xl mx-auto text-center mb-10">
      <div class="tag mb-5">Подбор стратегии</div>
      <h2 class="text-brand-text mb-4">Под какую задачу подбираем выкупы?</h2>
      <p class="text-brand-muted leading-relaxed">
        Выберите цель — получите персональный расчёт прямо здесь.<br class="hidden sm:block">
        <span class="text-brand-text font-semibold">Без форм и звонков — за 2 минуты.</span>
      </p>
    </div>

    <!-- Progress indicator -->
    <div class="flex items-center justify-center mb-8">
      <div id="qdot-1" class="w-8 h-8 rounded-full text-xs font-bold flex items-center justify-center bg-brand-accent text-white transition-all duration-300 shrink-0">1</div>
      <div id="qline-1" class="w-12 sm:w-20 h-px bg-brand-border transition-colors duration-500 shrink-0"></div>
      <div id="qdot-2" class="w-8 h-8 rounded-full text-xs font-bold flex items-center justify-center bg-brand-surface border border-brand-border text-brand-muted transition-all duration-300 shrink-0">2</div>
      <div id="qline-2" class="w-12 sm:w-20 h-px bg-brand-border transition-colors duration-500 shrink-0"></div>
      <div id="qdot-3" class="w-8 h-8 rounded-full text-xs font-bold flex items-center justify-center bg-brand-surface border border-brand-border text-brand-muted transition-all duration-300 shrink-0">3</div>
    </div>

    <!-- Quiz card -->
    <div class="max-w-4xl mx-auto rounded-2xl border border-brand-border bg-brand-surface overflow-hidden">

      <!-- ===== STEP 1: Goals ===== -->
      <div id="qstep-1" class="p-6 sm:p-10">
        <div class="flex items-center justify-between mb-6">
          <p class="text-brand-muted text-sm">Можно выбрать до 2 целей</p>
          <p class="text-brand-muted text-sm">
            Выбрано: <span id="goal-count" class="text-brand-text font-bold">0</span> / 2
          </p>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">

          <button class="qgoal-card" data-goal="launch">
            <span class="qg-icon">🚀</span>
            <span class="qg-title">Запуск новой карточки</span>
            <span class="qg-sub">Войти в выдачу с нуля и набрать стартовые отзывы</span>
            <span class="qg-badge">Популярно</span>
          </button>

          <button class="qgoal-card" data-goal="keys">
            <span class="qg-icon">🔑</span>
            <span class="qg-title">Прокачка ключей</span>
            <span class="qg-sub">Поднять позиции по нужным запросам</span>
          </button>

          <button class="qgoal-card" data-goal="reviews">
            <span class="qg-icon">⭐</span>
            <span class="qg-title">Банк отзывов</span>
            <span class="qg-sub">Перекрыть негатив и вернуть доверие</span>
          </button>

          <button class="qgoal-card" data-goal="conversion">
            <span class="qg-icon">📈</span>
            <span class="qg-title">Улучшение конверсии</span>
            <span class="qg-sub">CTR и конверсия через поведенческие сигналы</span>
          </button>

          <button class="qgoal-card" data-goal="funnel">
            <span class="qg-icon">🛒</span>
            <span class="qg-title">Подтягивание воронки</span>
            <span class="qg-sub">Закрыть провал корзина → заказ</span>
          </button>

          <button class="qgoal-card" data-goal="iu">
            <span class="qg-icon">🎯</span>
            <span class="qg-title">Выполнение ИУ WB</span>
            <span class="qg-sub">Добрать оборот и сохранить льготные условия</span>
          </button>

          <button class="qgoal-card" data-goal="shelves">
            <span class="qg-icon">🏆</span>
            <span class="qg-title">Рекомендательные полки</span>
            <span class="qg-sub">Встать в рекомендации к лидерам ниши</span>
          </button>

          <button class="qgoal-card" data-goal="promo">
            <span class="qg-icon">🏷️</span>
            <span class="qg-title">Вход в акцию WB</span>
            <span class="qg-sub">Войти без снижения цены и потери маржи</span>
          </button>

          <button class="qgoal-card" data-goal="other">
            <span class="qg-icon">💬</span>
            <span class="qg-title">Другая задача</span>
            <span class="qg-sub">Разберём вашу ситуацию на сессии</span>
          </button>

        </div>

        <div class="flex justify-end mt-8">
          <button id="q1-next" class="btn-primary qbtn-disabled" disabled>
            Далее →
          </button>
        </div>
      </div>

      <!-- ===== STEP 2: Form ===== -->
      <div id="qstep-2" class="p-6 sm:p-10 hidden">

        <div class="mb-8">
          <p class="text-brand-muted text-xs uppercase tracking-widest font-semibold mb-2">Шаг 2 из 3</p>
          <h3 class="text-brand-text font-bold text-xl mb-2">Товар и ситуация</h3>
          <p class="text-brand-muted text-sm">Менеджер изучит ваш товар заранее и ответит по делу</p>
        </div>

        <div class="space-y-5">

          <!-- Name -->
          <div>
            <label for="q-name" class="block text-brand-text text-sm font-semibold mb-2">
              Как к вам обращаться? <span class="text-red-400 ml-0.5">*</span>
            </label>
            <input id="q-name" type="text" placeholder="Имя" autocomplete="given-name" class="qinput" />
          </div>

          <!-- Product -->
          <div>
            <label for="q-product" class="block text-brand-text text-sm font-semibold mb-2">Товар</label>
            <input id="q-product" type="text" placeholder="Например: женский костюм, лампа для маникюра" class="qinput" />
          </div>

          <!-- Price + Stock -->
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label for="q-price" class="block text-brand-text text-sm font-semibold mb-2">Цена до СПП, ₽</label>
              <input id="q-price" type="number" placeholder="1500" min="0" class="qinput" />
            </div>
            <div>
              <label for="q-stock" class="block text-brand-text text-sm font-semibold mb-2">Остатки на WB, шт</label>
              <input id="q-stock" type="number" placeholder="500" min="0" class="qinput" />
            </div>
          </div>

          <!-- Card type -->
          <div>
            <label class="block text-brand-text text-sm font-semibold mb-3">
              Карточка <span class="text-red-400 ml-0.5">*</span>
            </label>
            <div class="grid grid-cols-2 gap-3">
              <button class="qcard-radio" data-card="new">
                <span class="qcr-dot"></span>
                <div>
                  <span class="qcr-title">Новая</span>
                  <span class="qcr-sub">Продаж ещё нет</span>
                </div>
              </button>
              <button class="qcard-radio" data-card="existing">
                <span class="qcr-dot"></span>
                <div>
                  <span class="qcr-title">Уже продаётся</span>
                  <span class="qcr-sub">Есть статистика</span>
                </div>
              </button>
            </div>
          </div>

        </div>

        <div class="flex items-center justify-between mt-10">
          <button id="q2-back" class="btn-ghost text-sm">← Назад</button>
          <button id="q2-next" class="btn-primary qbtn-disabled" disabled>
            Получить расчёт →
          </button>
        </div>
      </div>

      <!-- ===== STEP 3: Result ===== -->
      <div id="qstep-3" class="p-6 sm:p-10 hidden">

        <div class="flex items-center gap-3 mb-8">
          <div class="w-10 h-10 rounded-full flex items-center justify-center shrink-0"
               style="background:rgba(74,222,128,0.12);border:1px solid rgba(74,222,128,0.3)">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                 stroke="#4ade80" stroke-width="2.5"
                 stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 6L9 17l-5-5"/>
            </svg>
          </div>
          <div>
            <p class="text-brand-text font-semibold">Персональная стратегия готова</p>
            <p class="text-brand-muted text-xs">На основе ваших ответов</p>
          </div>
        </div>

        <!-- Result card -->
        <div class="rounded-xl border relative overflow-hidden mb-6 p-5 sm:p-7"
             style="border-color:rgba(61,142,248,0.25);background:rgba(61,142,248,0.05)">
          <div class="absolute top-0 left-0 right-0 h-px"
               style="background:linear-gradient(90deg,transparent,rgba(61,142,248,0.5),transparent)"></div>

          <div class="mb-5">
            <p class="text-brand-muted text-[10px] uppercase tracking-wider font-semibold mb-2">Ваши цели</p>
            <div id="result-goals" class="flex flex-wrap gap-2"></div>
          </div>

          <div class="grid grid-cols-2 gap-3 mb-5">
            <div class="rounded-lg p-3" style="background:rgba(8,15,36,0.8);border:1px solid rgba(26,43,74,1)">
              <p class="text-brand-muted text-[10px] uppercase tracking-wider mb-1">Объём</p>
              <p id="result-volume" class="text-brand-text font-bold text-lg leading-tight"></p>
            </div>
            <div class="rounded-lg p-3" style="background:rgba(8,15,36,0.8);border:1px solid rgba(26,43,74,1)">
              <p class="text-brand-muted text-[10px] uppercase tracking-wider mb-1">Период</p>
              <p id="result-period" class="text-brand-text font-bold text-lg leading-tight"></p>
            </div>
          </div>

          <ul id="result-bullets" class="space-y-2.5 mb-5"></ul>

          <p class="text-brand-muted text-xs border-t pt-3" style="border-color:rgba(26,43,74,0.6)">
            Точные цифры зависят от ниши и текущей позиции — уточним за 15 минут
          </p>
        </div>

        <!-- Final CTA → Telegram -->
        <a id="quiz-tg-btn"
           href="https://t.me/Manager_UBuyer"
           target="_blank" rel="noopener noreferrer"
           class="quiz-final-cta">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="white" class="shrink-0">
            <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.894 8.221-1.97 9.28c-.145.658-.537.818-1.084.508l-3-2.21-1.447 1.394c-.16.16-.295.295-.605.295l.213-3.053 5.56-5.023c.242-.213-.054-.333-.373-.12L7.41 13.982l-2.96-.924c-.643-.204-.657-.643.136-.953l11.57-4.461c.537-.194 1.006.131.738.577z"/>
          </svg>
          <div>
            <div class="font-bold text-base leading-tight">Обсудить стратегию с менеджером</div>
            <div class="cta-sub">БЕСПЛАТНО · ОТВЕТИМ ЗА 15 МИНУТ</div>
          </div>
        </a>

        <button id="quiz-restart"
          class="block w-full text-center text-brand-muted text-xs mt-5
                 hover:text-brand-text transition-colors underline underline-offset-2">
          ← Начать заново
        </button>
      </div>

    </div><!-- /quiz card -->

  </div>
</section>

<script>
  type GoalId = 'launch'|'keys'|'reviews'|'conversion'|'funnel'|'iu'|'shelves'|'promo'|'other';

  const goalData: Record<GoalId, { title: string; volume: string; period: string; bullets: string[] }> = {
    launch: {
      title: 'Запуск новой карточки',
      volume: '150–300 выкупов',
      period: '7–10 дней',
      bullets: [
        'Стратегия нарастание → плато → выход под алгоритм WB',
        'Реклама с первого дня — органика разбавляет выкупной трафик',
        '10–20 отзывов с живых аккаунтов для конверсии с первых дней',
      ],
    },
    keys: {
      title: 'Прокачка ключей',
      volume: '300–600 выкупов',
      period: '12–18 дней',
      bullets: [
        'Поисковые сессии с точными запросами из вашей семантики',
        'Распределение по 3–5 приоритетным ключевым словам',
        'Органическое поведение: листают конкурентов, читают отзывы',
      ],
    },
    reviews: {
      title: 'Банк отзывов',
      volume: '30–60 отзывов',
      period: '10–14 дней',
      bullets: [
        'Реальные аккаунты с 3+ летней историей покупок',
        'Тексты и фото по вашему ТЗ — или составим сами',
        'Параллельно с выкупами или отдельным пакетом',
      ],
    },
    conversion: {
      title: 'Улучшение конверсии',
      volume: '200–400 выкупов',
      period: '10–14 дней',
      bullets: [
        'Долгие сессии: читают описание, листают фото, изучают инфографику',
        'Поведенческий сигнал корзина → заказ без аномалий',
        'Снижает ДРР за счёт роста органического трафика',
      ],
    },
    funnel: {
      title: 'Подтягивание воронки',
      volume: '200–500 выкупов',
      period: '14–21 день',
      bullets: [
        'Добавление в корзину с задержкой — имитация нерешительного покупателя',
        'Нормализуем соотношение корзина → заказ',
        'Снижаем процент брошенных корзин и отмен',
      ],
    },
    iu: {
      title: 'Выполнение ИУ WB',
      volume: 'По расчёту',
      period: 'До конца ИУ',
      bullets: [
        'Рассчитываем точный объём под недостающий оборот за сутки',
        'Запуск в течение 24 часов после оплаты',
        'Приоритетная очередь — укладываемся в дедлайн ИУ',
      ],
    },
    shelves: {
      title: 'Рекомендательные полки',
      volume: '400–800 выкупов',
      period: '15–25 дней',
      bullets: [
        'Совместные заказы с конкурентами по ТЗ',
        'Устойчивое попадание в блок «С этим покупают»',
        'Перехват тёплого трафика без затрат на рекламу',
      ],
    },
    promo: {
      title: 'Вход в акцию WB',
      volume: '200–500 выкупов',
      period: '7–14 дней',
      bullets: [
        'Набираем оборот до старта акции по расписанию WB',
        'Входим в акцию без снижения РРЦ',
        'Сохраняем маржу и получаем продвижение от WB',
      ],
    },
    other: {
      title: 'Индивидуальная задача',
      volume: 'По расчёту',
      period: 'Обсудим',
      bullets: [
        'Разбираем задачу на бесплатной 15-минутной сессии',
        'Составляем стратегию под ваш артикул и нишу',
        'Первый ответ за 15 минут в Telegram',
      ],
    },
  };

  const selectedGoals = new Set<GoalId>();
  let selectedCard: string | null = null;

  /* ---- helpers ---- */
  function setStep(n: number) {
    [1, 2, 3].forEach(i => {
      const el = document.getElementById(`qstep-${i}`);
      if (!el) return;
      if (i === n) {
        el.classList.remove('hidden');
        el.classList.add('qstep-enter');
        setTimeout(() => el.classList.remove('qstep-enter'), 400);
      } else {
        el.classList.add('hidden');
      }
    });

    [1, 2, 3].forEach(i => {
      const dot = document.getElementById(`qdot-${i}`);
      if (!dot) return;
      if (i < n) {
        dot.style.cssText = 'background:rgba(61,142,248,0.25);border:1px solid rgba(61,142,248,0.5);color:#3D8EF8;font-size:0.7rem';
        dot.textContent = '✓';
      } else if (i === n) {
        dot.style.cssText = 'background:#3D8EF8;color:#fff';
        dot.textContent = String(i);
      } else {
        dot.style.cssText = '';
        dot.textContent = String(i);
      }
    });
    [1, 2].forEach(i => {
      const line = document.getElementById(`qline-${i}`);
      if (line) line.style.backgroundColor = n > i ? 'rgba(61,142,248,0.35)' : '';
    });
  }

  function syncNextBtn1() {
    const btn = document.getElementById('q1-next') as HTMLButtonElement | null;
    if (!btn) return;
    const ok = selectedGoals.size > 0;
    btn.disabled = !ok;
    btn.classList.toggle('qbtn-disabled', !ok);
  }

  function syncNextBtn2() {
    const btn = document.getElementById('q2-next') as HTMLButtonElement | null;
    if (!btn) return;
    const name = (document.getElementById('q-name') as HTMLInputElement | null)?.value.trim();
    const ok = !!(name && selectedCard);
    btn.disabled = !ok;
    btn.classList.toggle('qbtn-disabled', !ok);
  }

  function buildTgUrl(): string {
    const goals = Array.from(selectedGoals).map(g => goalData[g].title).join(', ');
    const name    = (document.getElementById('q-name')    as HTMLInputElement | null)?.value.trim() ?? '';
    const product = (document.getElementById('q-product') as HTMLInputElement | null)?.value.trim() ?? '';
    const price   = (document.getElementById('q-price')   as HTMLInputElement | null)?.value.trim() ?? '';
    const stock   = (document.getElementById('q-stock')   as HTMLInputElement | null)?.value.trim() ?? '';
    const card    = selectedCard === 'new' ? 'Новая (продаж ещё нет)' : 'Уже продаётся';

    const lines: string[] = ['Здравствуйте! Хочу обсудить стратегию самовыкупов.', ''];
    lines.push(`Цели: ${goals}`);
    if (name)    lines.push(`Имя: ${name}`);
    if (product) lines.push(`Товар: ${product}`);
    if (price)   lines.push(`Цена до СПП: ${price} ₽`);
    if (stock)   lines.push(`Остатки на WB: ${stock} шт`);
    lines.push(`Карточка: ${card}`);

    return `https://t.me/Manager_UBuyer?text=${encodeURIComponent(lines.join('\n'))}`;
  }

  /* ---- goal cards ---- */
  document.querySelectorAll<HTMLButtonElement>('.qgoal-card').forEach(card => {
    card.addEventListener('click', () => {
      const goal = card.dataset.goal as GoalId;
      if (selectedGoals.has(goal)) {
        selectedGoals.delete(goal);
        card.classList.remove('qgoal-selected');
      } else if (selectedGoals.size < 2) {
        selectedGoals.add(goal);
        card.classList.add('qgoal-selected');
      }
      const cnt = document.getElementById('goal-count');
      if (cnt) cnt.textContent = String(selectedGoals.size);
      syncNextBtn1();
    });
  });

  /* ---- card radio ---- */
  document.querySelectorAll<HTMLButtonElement>('.qcard-radio').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.qcard-radio').forEach(b => b.classList.remove('qcard-selected'));
      btn.classList.add('qcard-selected');
      selectedCard = btn.dataset.card ?? null;
      syncNextBtn2();
    });
  });

  /* ---- name input ---- */
  document.getElementById('q-name')?.addEventListener('input', syncNextBtn2);

  /* ---- navigation ---- */
  document.getElementById('q1-next')?.addEventListener('click', () => setStep(2));
  document.getElementById('q2-back')?.addEventListener('click', () => setStep(1));
  document.getElementById('q2-next')?.addEventListener('click', () => {
    buildResult();
    setStep(3);
  });
  document.getElementById('quiz-restart')?.addEventListener('click', () => {
    selectedGoals.clear();
    selectedCard = null;
    document.querySelectorAll('.qgoal-card').forEach(c => c.classList.remove('qgoal-selected'));
    document.querySelectorAll('.qcard-radio').forEach(b => b.classList.remove('qcard-selected'));
    (['q-name', 'q-product', 'q-price', 'q-stock'] as const).forEach(id => {
      const el = document.getElementById(id) as HTMLInputElement | null;
      if (el) el.value = '';
    });
    const cnt = document.getElementById('goal-count');
    if (cnt) cnt.textContent = '0';
    const b1 = document.getElementById('q1-next') as HTMLButtonElement | null;
    if (b1) { b1.disabled = true; b1.classList.add('qbtn-disabled'); }
    const b2 = document.getElementById('q2-next') as HTMLButtonElement | null;
    if (b2) { b2.disabled = true; b2.classList.add('qbtn-disabled'); }
    setStep(1);
  });

  /* ---- result builder ---- */
  function buildResult() {
    const goals = Array.from(selectedGoals);
    const primary = goalData[goals[0]];
    const secondary = goals[1] ? goalData[goals[1]] : null;

    const goalsEl = document.getElementById('result-goals');
    if (goalsEl) {
      goalsEl.innerHTML = goals.map(g =>
        `<span style="display:inline-flex;padding:0.25rem 0.75rem;border-radius:9999px;font-size:0.75rem;font-weight:600;background:rgba(61,142,248,0.15);color:#3D8EF8;border:1px solid rgba(61,142,248,0.3)">${goalData[g].title}</span>`
      ).join('');
    }

    const volEl = document.getElementById('result-volume');
    const perEl = document.getElementById('result-period');
    if (volEl) volEl.textContent = primary.volume;
    if (perEl) perEl.textContent = primary.period;

    const bullets = secondary
      ? [...primary.bullets.slice(0, 2), secondary.bullets[0]]
      : primary.bullets;

    const bulletsEl = document.getElementById('result-bullets');
    if (bulletsEl) {
      bulletsEl.innerHTML = bullets.map(b =>
        `<li style="display:flex;align-items:flex-start;gap:0.625rem;font-size:0.875rem;color:#6680A8">
          <span style="width:6px;height:6px;border-radius:50%;background:#3D8EF8;flex-shrink:0;margin-top:0.4rem"></span>
          <span style="color:#E4ECFF">${b}</span>
        </li>`
      ).join('');
    }

    // Проставляем ссылку с предзаполненным сообщением
    const tgBtn = document.getElementById('quiz-tg-btn') as HTMLAnchorElement | null;
    if (tgBtn) tgBtn.href = buildTgUrl();
  }
</script>

<style>
  .qgoal-card {
    display: flex;
    flex-direction: column;
    text-align: left;
    padding: 1rem;
    border-radius: 0.75rem;
    border: 1px solid #1A2B4A;
    background: rgba(4, 9, 26, 0.6);
    transition: border-color 0.2s, background 0.2s, box-shadow 0.2s;
    cursor: pointer;
  }
