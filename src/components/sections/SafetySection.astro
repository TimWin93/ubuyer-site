---
import ShieldCheck from '@lucide/astro/icons/shield-check';
import CheckCircle2 from '@lucide/astro/icons/circle-check';

const points = [
  'Каждый аккаунт делает заказ не чаще одного раза в 16 дней',
  'Аккаунтам по 3+ лет — ежедневно добавляется по 3–4 новых профиля',
  'Корзина из нескольких товаров — не один артикул, как у ботов',
  'Реальный процент отказов — не 100% забор, что сразу видно WB',
  'Реальная доставка через ПВЗ — живые статусы, живые люди',
  'Разные устройства, IP и геолокации — ни один профиль не повторяется',
];

const metrics = [
  { value: '16',    unit: ' дней', target: 16,   suffix: '',  thousands: false, desc: 'минимальный интервал заказа с одного аккаунта' },
  { value: '80',    unit: ' дней', target: 80,   suffix: '',  thousands: false, desc: 'один курьер на одном ПВЗ — не чаще' },
  { value: '3 000+', unit: '',     target: 3000, suffix: '+', thousands: true,  desc: 'профилей: своя SIM, банковская карта, адрес — аккаунтам 3+ лет' },
  { value: '0',     unit: '',     target: 0,    suffix: '',  thousands: false, desc: 'блокировок клиентов по нашей вине за 3 года работы' },
];
---

<section class="section section-alt">
  <div class="container">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-14 items-center">

      <!-- левая колонка -->
      <div>
        <div class="tag mb-6">Безопасность</div>
        <h2 class="text-brand-text mb-5">
          Почему риски минимальны
        </h2>
        <p class="text-brand-muted text-lg leading-relaxed mb-8">
          WB борется с накруткой — мы это знаем. Именно поэтому мы построили
          инфраструктуру, которая неотличима от живых покупок.
        </p>

        <!-- ключевой факт -->
        <div class="rounded-2xl border border-brand-accent/25 bg-brand-accent-dim p-5 mb-6">
          <div class="flex items-start gap-3">
            <ShieldCheck size={20} class="text-brand-accent shrink-0 mt-0.5" />
            <p class="text-brand-text font-medium leading-relaxed text-sm">
              3 года работы — ни один клиент не получил блокировку по нашей вине.
            </p>
          </div>
        </div>

        <p class="text-brand-muted text-xs leading-relaxed mb-6">
          Мы честно говорим о рисках и не берём заявки, если видим
          противопоказания для конкретной карточки.
        </p>

        <a href="/soft-vs-zhivye/"
           class="group inline-flex items-center gap-2 text-sm font-semibold text-brand-accent hover:text-brand-accent-2 transition-colors">
          <span>Почему софт-сервисы не могут это повторить — разбор 23&nbsp;параметров</span>
          <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" viewBox="0 0 16 16" fill="none">
            <path d="M3 8h10m0 0L9 4m4 4l-4 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>

      <!-- правая колонка - чеклист -->
      <div class="space-y-3">
        {points.map((point) => (
          <div class="flex items-start gap-3 rounded-xl border border-brand-border
                      bg-brand-surface px-4 py-3 hover:border-brand-border-2 transition-colors">
            <CheckCircle2 size={16} class="text-brand-accent shrink-0 mt-0.5" />
            <span class="text-brand-muted text-sm leading-relaxed">{point}</span>
          </div>
        ))}
      </div>

    </div>

    <!-- цифры безопасности -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mt-10 pt-10 border-t border-brand-border">
      {metrics.map((m) => (
        <div class="rounded-2xl border border-brand-border bg-brand-surface px-5 py-5 text-center
                    hover:border-brand-border-2 transition-colors">
          <div class="font-mono font-bold text-2xl md:text-3xl text-brand-text mb-1">
            <span
              class="safety-counter"
              data-target={m.target}
              data-suffix={m.suffix}
              data-thousands={m.thousands ? '1' : ''}
            >{m.value}</span><span class="text-brand-accent">{m.unit}</span>
          </div>
          <p class="text-xs text-brand-muted leading-snug">{m.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  function animateSafetyCounter(el: HTMLElement) {
    const target = parseInt(el.dataset.target || '0');
    const suffix = el.dataset.suffix || '';
    const thousands = el.dataset.thousands === '1';
    if (target === 0) { el.textContent = '0' + suffix; return; }
    const duration = 1600;
    const start = performance.now();
    function fmt(n: number) {
      if (thousands) return n.toLocaleString('ru').replace(',', ' ');
      return String(n);
    }
    function step(now: number) {
      const elapsed = now - start;
      const progress = Math.min(elapsed / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3);
      el.textContent = fmt(Math.floor(eased * target)) + suffix;
      if (progress < 1) requestAnimationFrame(step);
    }
    requestAnimationFrame(step);
  }

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        animateSafetyCounter(e.target as HTMLElement);
        observer.unobserve(e.target);
      }
    });
  }, { threshold: 0.5 });

  document.querySelectorAll('.safety-counter').forEach(el => observer.observe(el));
</script>
