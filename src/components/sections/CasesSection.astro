---
import { CONTACTS } from '@/consts';
import TrendingUp from '@lucide/astro/icons/trending-up';
import ArrowRight from '@lucide/astro/icons/arrow-right';

const cases = [
  {
    niche: 'Товары для дома',
    task: 'Запуск новой карточки',
    volume: '300 заказов · 3 недели',
    results: ['+47 позиций по ключу «органайзер для кухни»', 'ДРР снизился с 38% до 19%'],
  },
  {
    niche: 'Одежда / женская',
    task: 'Подготовка к сезону',
    volume: '500 заказов · 5 недель',
    results: ['Топ-10 по 3 ключевым запросам', 'Выручка в первую неделю сезона ×2.4'],
  },
  {
    niche: 'Косметика',
    task: 'Восстановление после просадки',
    volume: '200 заказов · 2 недели',
    results: ['Позиции вернулись на прежний уровень', 'Органический трафик +34%'],
  },
];
---

<section class="section border-t border-brand-border">
  <div class="container">
    <div class="max-w-2xl mx-auto text-center mb-14">
      <div class="tag mb-5">Результаты</div>
      <h2 class="text-brand-text">Кейсы клиентов</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      {cases.map((c) => (
        <div class="card flex flex-col">
          <div class="flex items-center justify-between mb-5">
            <span class="text-xs font-semibold text-brand-muted uppercase tracking-wider">
              {c.niche}
            </span>
          </div>

          <p class="text-xs text-brand-muted mb-1">Задача</p>
          <p class="font-semibold text-brand-text mb-1 text-sm">{c.task}</p>
          <p class="text-xs text-brand-muted mb-5 font-mono">{c.volume}</p>

          <div class="space-y-2.5 mt-auto">
            {c.results.map((r) => (
              <div class="flex items-start gap-2">
                <TrendingUp size={14} class="text-brand-accent shrink-0 mt-0.5" />
                <span class="text-sm text-brand-text font-medium">{r}</span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <p class="text-center text-xs text-brand-muted mt-6 opacity-50">
      Скриншоты аналитики WB — публикуем с согласия клиентов по мере накопления
    </p>

    <div class="text-center mt-10">
      <a href={CONTACTS.telegram} target="_blank" rel="noopener" class="btn-primary"
         onclick="if(window.ymGoal)window.ymGoal('cases_cta_click')">
        Хочу такой же результат
        <ArrowRight size={16} />
      </a>
    </div>
  </div>
</section>
