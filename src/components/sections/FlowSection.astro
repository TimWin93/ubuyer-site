---
import MousePointer2 from '@lucide/astro/icons/mouse-pointer-2';
import ShoppingCart from '@lucide/astro/icons/shopping-cart';
import MapPin from '@lucide/astro/icons/map-pin';
import Truck from '@lucide/astro/icons/truck';
import Package from '@lucide/astro/icons/package';
import TrendingUp from '@lucide/astro/icons/trending-up';

const flowNodes = [
  {
    Icon: MousePointer2,
    label: 'Кликер',
    sub: 'Ищет товар вручную\nпо ключевому слову',
    highlight: false,
    num: '01',
    details: 'Живой человек с телефоном листает каталог, смотрит конкурентов, читает отзывы. WB видит органическое поведение — не переходы по прямой ссылке. Если товар не находится в выдаче, кликер сигнализирует менеджеру ещё до оформления заказа. Боты так не делают.',
  },
  {
    Icon: ShoppingCart,
    label: 'Заказ',
    sub: 'Корзина из нескольких\nтоваров разных клиентов',
    highlight: false,
    num: '02',
    details: 'Каждый аккаунт берёт корзину: ваш товар плюс несколько позиций других клиентов. Часть заказов намеренно отклоняется — как у реального покупателя. Нет аномалии «100 аккаунтов, у каждого ровно по 1 товару». WB видит обычного человека с разными интересами.',
  },
  {
    Icon: MapPin,
    label: 'ПВЗ',
    sub: 'Водитель забирает\n1 QR = 1 точка',
    highlight: false,
    num: '03',
    details: '2 600+ ПВЗ по Москве и МО. Каждый заказ — отдельная точка в другом районе. WB штрафовал конкурентов именно за кластеризацию: все заборы в одном квартале — красный флаг для алгоритма. У нас нет кластеризации по определению.',
  },
  {
    Icon: Truck,
    label: 'Доставка',
    sub: 'На склад в тот же день\nдевушка, свой авто',
    highlight: false,
    num: '04',
    details: 'Один QR — одна точка. Один и тот же водитель появляется на одном ПВЗ не чаще раза в 80 дней. Никаких газелей, никаких пачек листов с кодами. Со стороны — обычный человек забрал посылку и уехал.',
  },
  {
    Icon: Package,
    label: 'Склад',
    sub: 'Сортировка, учёт\nотгрузка обратно на WB',
    highlight: false,
    num: '05',
    details: '2 000 м², без выходных. Расконсолидация → сортировка по клиентам → учёт → переупаковка → отгрузка обратно на WB. Вы видите в реальном времени: что на складе, сколько штук, по каким артикулам. Товар возвращается к вам в оборот.',
  },
  {
    Icon: TrendingUp,
    label: 'Результат ✓',
    sub: 'WB фиксирует продажу\nпозиция идёт вверх',
    highlight: true,
    num: '06',
    details: 'WB записывает продажу в алгоритм в момент забора с ПВЗ. Позиция начинает расти с первых дней стратегии. Цель — раскачать карточку до уровня, где органика перебивает выкупной трафик. Мы незаметно уходим. Вы остаётесь наверху.',
  },
];
---

<section id="kak-rabotaem" class="section section-alt">
  <div class="container">

    <div class="max-w-2xl mx-auto text-center mb-12">
      <div class="tag mb-5">Как это работает</div>
      <h2 class="text-brand-text mb-4">
        Каждый выкуп — 6 живых процессов
      </h2>
      <p class="text-brand-muted text-lg leading-relaxed">
        Кликер, водитель, склад, логист — не алгоритм. Каждый шаг делает живой человек.
        WB не видит паттерна, потому что его нет — это настоящая покупка.
      </p>
    </div>

    <div class="rounded-2xl border border-brand-border bg-brand-surface p-6 sm:p-10">

      <!-- Узлы + fade-маска -->
      <div class="relative">
        <div class="scroll-fade pointer-events-none absolute right-0 top-0 h-full w-20
                    bg-gradient-to-l from-brand-surface to-transparent z-10 transition-opacity duration-300"></div>

        <div class="overflow-x-auto scroll-smooth pt-3" id="flow-scroll">
          <div class="flex items-start gap-0 min-w-[700px] lg:min-w-0" id="flow-diagram">
            {flowNodes.map(({ Icon, label, sub, highlight }, i) => (
              <>
                <button
                  class="flow-node flex flex-col items-center text-center flex-1 px-1 cursor-pointer"
                  style={`--i: ${i}`}
                  data-flow-index={i}
                  aria-pressed="false"
                  type="button"
                >
                  <!-- Иконка с номером-бейджем -->
                  <div class="relative mb-3">
                    <div class={`flow-icon w-14 h-14 rounded-xl flex items-center justify-center transition-all duration-300
                      ${highlight
                        ? 'bg-brand-accent/20 border border-brand-accent/50 shadow-[0_0_16px_rgba(61,142,248,0.25)]'
                        : 'bg-brand-accent/10 border border-brand-accent/20'}`}>
                      <Icon size={22} class={`flow-icon-svg transition-colors duration-300 ${highlight ? 'text-brand-accent-2' : 'text-brand-accent'}`} />
                    </div>
                    <span class="flow-num-badge absolute -top-1.5 -right-1.5 w-5 h-5 rounded-full
                                 bg-brand-bg border border-brand-border
                                 text-[9px] font-bold text-brand-muted font-mono
                                 flex items-center justify-center leading-none transition-all duration-300">
                      {i + 1}
                    </span>
                  </div>

                  <p class={`flow-label text-sm font-semibold mb-1 transition-colors duration-300 ${highlight ? 'text-brand-accent-2' : 'text-brand-text'}`}>
                    {label}
                  </p>
                  <p class="text-brand-muted text-xs leading-snug whitespace-pre-line">{sub}</p>
                </button>

                {i < flowNodes.length - 1 && (
                  <div
                    class="flow-arr flex items-center justify-center shrink-0 mt-5 px-0.5"
                    style={`--i: ${i + 0.5}`}
                  >
                    <svg width="28" height="14" viewBox="0 0 28 14" fill="none" aria-hidden="true">
                      <line x1="2" y1="7" x2="21" y2="7"
                        class="flow-arr-line"
                        stroke="#3D8EF8" stroke-width="1.5"
                        stroke-dasharray="4 3" />
                      <path d="M18 4L23 7L18 10"
                        stroke="#3D8EF8" stroke-width="1.5"
                        stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </div>
                )}
              </>
            ))}
          </div>
        </div>
      </div>

      <!-- Прогресс-индикатор (мобильный) -->
      <div class="lg:hidden mt-6">
        <div class="flex items-center justify-between mb-2">
          <span id="flow-step-label" class="text-xs text-brand-muted font-mono">Шаг 1 из 6</span>
          <span id="flow-step-name" class="text-xs font-semibold text-brand-accent"></span>
        </div>
        <div class="relative h-1.5 bg-brand-border rounded-full overflow-hidden">
          <div id="flow-progress-bar"
               class="h-full rounded-full transition-all duration-300"
               style="width: 16.67%; background: linear-gradient(90deg, #3D8EF8, #4DD9FF)">
          </div>
        </div>
        <!-- Невидимые tap-зоны поверх прогресс-бара -->
        <div class="flex mt-1" id="flow-dots">
          {flowNodes.map((node, i) => (
            <button
              type="button"
              class="flow-dot-btn flex-1 py-3"
              data-dot-index={i}
              data-dot-label={node.label}
              aria-label={`Шаг ${i + 1}: ${node.label}`}
            ></button>
          ))}
        </div>
      </div>

      <!-- Раскрывающаяся панель -->
      <div id="flow-panel" class="mt-2 overflow-hidden" style="max-height: 0; opacity: 0; transition: max-height 0.35s ease, opacity 0.3s ease;">
        <div class="border-t border-brand-border pt-5">
          <div class="flex items-center gap-3 mb-4">
            <div id="flow-panel-icon"
                 class="w-10 h-10 rounded-xl bg-brand-accent flex items-center justify-center shrink-0
                        shadow-[0_0_20px_rgba(61,142,248,0.45)]">
            </div>
            <div>
              <span id="flow-panel-num" class="font-mono text-[10px] text-brand-muted font-semibold uppercase tracking-wider block leading-none mb-0.5"></span>
              <h4 id="flow-panel-title" class="text-brand-text text-base font-bold leading-tight"></h4>
            </div>
          </div>
          <p id="flow-panel-text" class="text-brand-muted text-sm leading-relaxed max-w-2xl"></p>
        </div>
      </div>

    </div>

    <!-- Подсказка -->
    <div class="flex items-center justify-center gap-2 mt-4 text-xs text-brand-muted opacity-60">
      <span class="lg:hidden">Листайте и нажимайте на шаг — узнайте что за ним стоит</span>
      <span class="hidden lg:inline">Нажмите на любой шаг, чтобы узнать подробнее</span>
    </div>

  </div>
</section>

<!-- Шаблоны иконок для панели (скрыты, используются JS) -->
<div class="hidden" id="flow-panel-icons">
  {flowNodes.map(({ Icon }, i) => (
    <div id={`flow-icon-tpl-${i}`}>
      <Icon size={18} class="text-white" />
    </div>
  ))}
</div>

<script>
  const nodeData = [
    { num: '01', title: 'Кликер',      text: 'Живой человек с телефоном листает каталог, смотрит конкурентов, читает отзывы. WB видит органическое поведение — не переходы по прямой ссылке. Если товар не находится в выдаче, кликер сигнализирует менеджеру ещё до оформления заказа. Боты так не делают.' },
    { num: '02', title: 'Заказ',       text: 'Каждый аккаунт берёт корзину: ваш товар плюс несколько позиций других клиентов. Часть заказов намеренно отклоняется — как у реального покупателя. Нет аномалии «100 аккаунтов, у каждого ровно по 1 товару». WB видит обычного человека с разными интересами.' },
    { num: '03', title: 'ПВЗ',         text: '2 600+ ПВЗ по Москве и МО. Каждый заказ — отдельная точка в другом районе. WB штрафовал конкурентов именно за кластеризацию: все заборы в одном квартале — красный флаг для алгоритма. У нас нет кластеризации по определению.' },
    { num: '04', title: 'Доставка',    text: 'Один QR — одна точка. Один и тот же водитель появляется на одном ПВЗ не чаще раза в 80 дней. Никаких газелей, никаких пачек листов с кодами. Со стороны — обычный человек забрал посылку и уехал.' },
    { num: '05', title: 'Склад',       text: '2 000 м², без выходных. Расконсолидация → сортировка по клиентам → учёт → переупаковка → отгрузка обратно на WB. Вы видите в реальном времени: что на складе, сколько штук, по каким артикулам. Товар возвращается к вам в оборот.' },
    { num: '06', title: 'Результат ✓', text: 'WB записывает продажу в алгоритм в момент забора с ПВЗ. Позиция начинает расти с первых дней стратегии. Цель — раскачать карточку до уровня, где органика перебивает выкупной трафик. Мы незаметно уходим. Вы остаётесь наверху.' },
  ];

  const TOTAL = nodeData.length;

  const diagram    = document.getElementById('flow-diagram');
  const scrollWrap = document.getElementById('flow-scroll');
  const fadeMask   = document.querySelector('.scroll-fade') as HTMLElement | null;
  const progressBar  = document.getElementById('flow-progress-bar') as HTMLElement | null;
  const stepLabel    = document.getElementById('flow-step-label');
  const stepName     = document.getElementById('flow-step-name');
  const panel        = document.getElementById('flow-panel');
  const panelIcon    = document.getElementById('flow-panel-icon');
  const panelNum     = document.getElementById('flow-panel-num');
  const panelTitle   = document.getElementById('flow-panel-title');
  const panelText    = document.getElementById('flow-panel-text');
  const buttons      = document.querySelectorAll('[data-flow-index]');
  const dots         = document.querySelectorAll('[data-dot-index]');
  let activeIndex    = -1;

  /* ---------- прогресс-бар ---------- */
  function updateProgress(idx: number) {
    if (progressBar) progressBar.style.width = `${(idx + 1) / TOTAL * 100}%`;
    if (stepLabel)   stepLabel.textContent = `Шаг ${idx + 1} из ${TOTAL}`;
    if (stepName)    stepName.textContent  = nodeData[idx].title;
  }

  /* ---------- иконка в панели ---------- */
  function setIcon(idx: number) {
    const tpl = document.getElementById(`flow-icon-tpl-${idx}`);
    if (tpl && panelIcon) panelIcon.innerHTML = tpl.innerHTML;
  }

  /* ---------- активация узла ---------- */
  function activateNode(idx: number) {
    if (!panel || !panelNum || !panelTitle || !panelText) return;

    buttons.forEach(btn => {
      btn.setAttribute('aria-pressed', 'false');
      btn.classList.remove('flow-node-active');
    });

    if (activeIndex === idx) {
      panel.style.maxHeight = '0';
      panel.style.opacity   = '0';
      activeIndex = -1;
      return;
    }

    const btn = document.querySelector(`[data-flow-index="${idx}"]`);
    btn?.setAttribute('aria-pressed', 'true');
    btn?.classList.add('flow-node-active');

    updateProgress(idx);

    panel.style.opacity = '0';
    setTimeout(() => {
      const data = nodeData[idx];
      panelNum.textContent   = data.num;
      panelTitle.textContent = data.title;
      panelText.textContent  = data.text;
      setIcon(idx);
      panel.style.maxHeight = '260px';
      panel.style.opacity   = '1';
    }, activeIndex === -1 ? 0 : 120);

    activeIndex = idx;
  }

  /* ---------- Intersection Observer — автоактивация ---------- */
  if (diagram) {
    const obs = new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('flow-active');
        obs.disconnect();
        const firstIcon = document.querySelector('[data-flow-index="0"] .flow-icon');
        firstIcon?.classList.add('flow-pulse');
        setTimeout(() => firstIcon?.classList.remove('flow-pulse'), 2700);
        setTimeout(() => activateNode(0), 700);
      }
    }, { threshold: 0.25 });
    obs.observe(diagram);
  }

  /* ---------- fade-маска при скролле ---------- */
  if (scrollWrap && fadeMask) {
    function checkFade() {
      const hasOverflow = scrollWrap!.scrollWidth > scrollWrap!.clientWidth + 8;
      const atEnd = scrollWrap!.scrollLeft + scrollWrap!.clientWidth >= scrollWrap!.scrollWidth - 8;
      fadeMask!.style.opacity = (hasOverflow && !atEnd) ? '1' : '0';
    }
    scrollWrap.addEventListener('scroll', checkFade, { passive: true });
    window.addEventListener('resize', checkFade, { passive: true });
    setTimeout(checkFade, 300);
  }

  /* ---------- клики по узлам ---------- */
  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      activateNode(parseInt(btn.getAttribute('data-flow-index') ?? '0', 10));
    });
  });

  /* ---------- клики по tap-зонам прогресс-бара ---------- */
  dots.forEach(dot => {
    dot.addEventListener('click', () => {
      const idx = parseInt(dot.getAttribute('data-dot-index') ?? '0', 10);
      activateNode(idx);
      document.querySelector(`[data-flow-index="${idx}"]`)
        ?.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
    });
  });
</script>

<style>
  /* ---------- появление ---------- */
  .flow-node, .flow-arr {
    opacity: 0;
    transform: translateX(-10px);
    transition: opacity 0.45s ease, transform 0.45s ease;
    transition-delay: calc(var(--i) * 110ms);
  }
  .flow-active .flow-node,
  .flow-active .flow-arr { opacity: 1; transform: translateX(0); }

  /* ---------- hover ---------- */
  .flow-node:hover .flow-icon {
    background-color: rgba(61,142,248,0.2) !important;
    border-color: rgba(61,142,248,0.45) !important;
  }

  /* ---------- активный узел ---------- */
  .flow-node-active .flow-icon {
    background-color: #3D8EF8 !important;
    border-color: #3D8EF8 !important;
    box-shadow: 0 0 24px rgba(61,142,248,0.55), 0 0 8px rgba(61,142,248,0.3);
    transform: scale(1.1);
  }
  .flow-node-active .flow-icon .flow-icon-svg {
    color: #ffffff !important;
  }
  .flow-node-active .flow-label {
    color: #ffffff !important;
    font-weight: 700;
  }
  .flow-node-active .flow-num-badge {
    background: #3D8EF8;
    border-color: #3D8EF8;
    color: #ffffff;
  }

  /* ---------- кнопки без браузерных стилей ---------- */
  [data-flow-index] { background: none; border: none; padding: 0; outline: none; }
  [data-flow-index]:focus-visible .flow-icon { box-shadow: 0 0 0 2px #3D8EF8; }

  /* ---------- панель ---------- */
  #flow-panel { transition: max-height 0.35s ease, opacity 0.3s ease; }

  /* ---------- анимированные стрелки ---------- */
  @keyframes flow-dash {
    to { stroke-dashoffset: -14; }
  }
  .flow-arr-line {
    animation: flow-dash 0.7s linear infinite;
  }

  /* ---------- пульс при появлении ---------- */
  @keyframes flow-pulse-ring {
    0%   { box-shadow: 0 0 0 0   rgba(61,142,248,0.65); }
    70%  { box-shadow: 0 0 0 14px rgba(61,142,248,0);   }
    100% { box-shadow: 0 0 0 0   rgba(61,142,248,0);    }
  }
  .flow-pulse { animation: flow-pulse-ring 0.9s ease-out 3; }
</style>
