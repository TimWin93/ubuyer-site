---
const points = [
  'Кликеры, водители, упаковщики, логисты — всё внутри',
  'Свой склад фулфилмента и автопарк в Москве',
  'Работаем 3+ года — выстроили систему, а не хаос',
  'Все сотрудники обучаются за счёт компании',
];
---

<section class="section border-t border-brand-border">
  <div class="container">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">

      <!-- фото -->
      <div class="space-y-4">
        <div class="relative">
          <div class="rounded-2xl overflow-hidden border border-brand-border">
            <img
              src="/images/team-photo.jpg"
              alt="Команда UBuyer — 100+ человек, Москва"
              width="1600"
              height="1067"
              class="w-full object-cover"
              loading="lazy"
            />
          </div>
          <!-- бейдж поверх фото -->
          <div class="absolute -bottom-4 -right-4 bg-brand-surface border border-brand-border
                      rounded-2xl px-5 py-3 shadow-card">
            <p class="text-2xl font-bold font-mono text-brand-text">100+</p>
            <p class="text-xs text-brand-muted">человек в команде</p>
          </div>
        </div>

        <!-- карта ПВЗ -->
        <div class="pt-6">
          <p class="text-xs text-brand-muted mb-3 font-semibold uppercase tracking-wider">
            3 000+ ПВЗ по Москве и МО
          </p>
          <div class="rounded-2xl overflow-hidden border border-brand-border">
            <img
              src="/images/pvz-map.jpg"
              alt="Карта ПВЗ UBuyer — 3000+ точек выдачи в Москве и МО"
              class="w-full h-auto block"
              loading="lazy"
            />
          </div>
          <p class="text-xs text-brand-muted mt-2 text-center opacity-60">
            Каждая точка — реальный ПВЗ, через который проходят выкупы
          </p>
        </div>
      </div>

      <!-- текст -->
      <div>
        <div class="tag mb-6">Наша команда</div>
        <h2 class="text-brand-text mb-4">
          За каждой покупкой<br />стоят 100+ человек
        </h2>
        <p class="text-brand-muted text-lg leading-relaxed mb-8">
          Это не сервис из двух человек с базой аккаунтов.
          Это слаженная операционная система: свои люди, свои маршруты,
          свой склад, своя логистика — всё под одной крышей.
        </p>

        <ul class="space-y-3 mb-8">
          {points.map((p) => (
            <li class="flex items-start gap-3 text-sm text-brand-muted">
              <span class="w-1 h-1 rounded-full bg-brand-accent shrink-0 mt-2"></span>
              {p}
            </li>
          ))}
        </ul>

        <!-- цитата-принцип -->
        <div class="rounded-2xl border border-brand-border bg-brand-surface p-5 mb-6">
          <p class="text-brand-muted text-sm leading-relaxed italic">
            "Мы прошли через все плохие модели рынка — ПО, партнёрский
            фулфилмент, хаос, провалы на складе. Именно поэтому наша
            модель работает."
          </p>
        </div>

        <!-- Telegram канал -->
        <a
          href="https://t.me/YourBuyer_WB"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-3 rounded-2xl border border-brand-accent/30
                 bg-brand-accent/5 px-5 py-4 hover:bg-brand-accent/10
                 hover:border-brand-accent/50 transition-all group"
        >
          <span class="flex items-center justify-center w-9 h-9 rounded-xl
                       bg-brand-accent/15 shrink-0">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" class="text-brand-accent">
              <path d="M21.8 2.15a1.5 1.5 0 0 0-1.67-.32L2.8 9.13a1.5 1.5 0 0 0 .08 2.79l4.12 1.37 1.65 5.1a1 1 0 0 0 1.74.3l2.44-2.9 4.74 3.5a1.5 1.5 0 0 0 2.35-1.02l2-14a1.5 1.5 0 0 0-.12-.12Z" fill="currentColor"/>
            </svg>
          </span>
          <div class="flex-1">
            <p class="text-brand-text text-sm font-semibold">Telegram-канал UBuyer</p>
            <p class="text-brand-muted text-xs mt-0.5">Кейсы, аналитика, обновления</p>
          </div>
          <span class="text-brand-accent text-xs opacity-60 group-hover:opacity-100
                       group-hover:translate-x-1 transition-all">→</span>
        </a>
      </div>

    </div>
  </div>
</section>
