---
import { CONTACTS } from '@/consts';
---

<div
  id="sticky-cta"
  class="fixed bottom-6 right-6 z-50 opacity-0 translate-y-4 pointer-events-none
         transition-all duration-300"
>
  <a
    href={CONTACTS.telegram}
    target="_blank"
    rel="noopener"
    class="flex items-center gap-3 bg-brand-accent text-white font-semibold text-sm
           px-5 py-3.5 rounded-2xl shadow-btn hover:bg-brand-accent-hover
           hover:shadow-btn-hover active:scale-[0.97] transition-all"
  >
    <!-- Telegram icon -->
    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
      <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.894 8.221-1.97 9.28c-.145.658-.537.818-1.084.508l-3-2.21-1.447 1.394c-.16.16-.295.295-.605.295l.213-3.053 5.56-5.023c.242-.213-.054-.333-.373-.12l-6.871 4.326-2.962-.924c-.643-.204-.657-.643.136-.953l11.57-4.461c.537-.194 1.006.131.833.941z"/>
    </svg>
    Написать в Telegram
  </a>
</div>

<script>
  const cta = document.getElementById('sticky-cta');
  const hero = document.querySelector('section');

  function update() {
    if (!hero || !cta) return;
    const heroBottom = hero.getBoundingClientRect().bottom;
    if (heroBottom < 0) {
      cta.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none');
      cta.classList.add('opacity-100', 'translate-y-0');
    } else {
      cta.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none');
      cta.classList.remove('opacity-100', 'translate-y-0');
    }
  }

  window.addEventListener('scroll', update, { passive: true });
  update();
</script>
