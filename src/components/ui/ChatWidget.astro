---
// Endpoint через Yandex Cloud Function. yandexcloud.net не блокируется в РФ —
// мобильные сети, операторы и DPI стабильно пропускают. Cloudflare Worker
// (ai.u-buyer.ru) и Cloud Run напрямую — режется частью провайдеров,
// особенно на мобильных устройствах с iOS WebKit (fetch failed: Load failed).
const CHAT_ENDPOINT = import.meta.env.PUBLIC_CHAT_ENDPOINT
  ?? 'https://functions.yandexcloud.net/d4ee9o608pangl2m3fii';

const STARTERS = [
  {
    label: 'Сколько стоит и что входит',
    text: 'Сколько стоит ваша услуга и что входит в цену?',
    iconPath: 'M12 8c-2.5 0-4 1-4 2.5s1.5 2.5 4 2.5 4 1 4 2.5-1.5 2.5-4 2.5m0-10v10m0 0v2m0-12V4',
  },
  {
    label: 'Расскажите про стратегию',
    text: 'Расскажите подробнее про вашу стратегию роста карточки.',
    iconPath: 'M3 17l6-6 4 4 8-8M14 7h7v7',
  },
  {
    label: 'Расскажите о себе, как работаете',
    text: 'Расскажите о себе — кто вы и как работаете?',
    iconPath: 'M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zm13 10v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75',
  },
];

const PILL_PHRASES = [
  'Расчёт под вашу нишу',
  'Подскажу стратегию',
  'Помогу с задачей',
];
---

<div id="chat-widget" data-endpoint={CHAT_ENDPOINT} data-state="closed" data-status="ready">

  <!-- ──────────────── PILL ──────────────── -->
  <button
    id="chat-toggle"
    type="button"
    aria-label="Открыть консультацию"
    data-phrases={JSON.stringify(PILL_PHRASES)}
    class="chat-pill fixed bottom-6 right-6 z-[60] group
           flex items-center gap-3 pl-1.5 pr-5 py-1.5
           bg-brand-surface/95 backdrop-blur-md
           border border-brand-border-2 rounded-full
           shadow-[0_8px_32px_rgba(0,0,0,0.45),0_0_0_1px_rgba(61,142,248,0.15),inset_0_1px_0_rgba(255,255,255,0.04)]
           hover:shadow-[0_12px_40px_rgba(0,0,0,0.55),0_0_0_1px_rgba(61,142,248,0.4),inset_0_1px_0_rgba(255,255,255,0.08)]
           hover:border-brand-accent/50
           active:scale-[0.98]
           transition-all duration-300 ease-out
           will-change-transform"
  >
    <!-- Аватар (фото) -->
    <span class="relative w-11 h-11 rounded-full flex-shrink-0 overflow-hidden
                 ring-1 ring-brand-accent/40
                 shadow-[0_0_20px_rgba(61,142,248,0.45)]">
      <img src="/images/anastasiya.jpg" alt="Анастасия, менеджер UBuyer"
           class="w-full h-full object-cover" loading="lazy" decoding="async" />
      <span class="absolute -bottom-0.5 -right-0.5 w-3 h-3 rounded-full bg-brand-cta
                   ring-2 ring-brand-surface
                   shadow-[0_0_8px_rgba(16,185,129,0.6)]"></span>
    </span>

    <!-- Badge непрочитанных (показывается когда чат свёрнут и Анастасия ответила) -->
    <span
      id="chat-unread-badge"
      class="chat-unread-badge"
      aria-hidden="true"
    >0</span>

    <!-- Текст с ротацией -->
    <span class="chat-pill-text flex flex-col items-start leading-tight">
      <span class="text-brand-text font-semibold text-sm tracking-tight">Анастасия</span>
      <span class="chat-pill-rotation text-brand-muted text-[11px] flex items-center gap-1 min-h-[14px]">
        <span class="chat-pill-phrase">Расчёт под вашу нишу</span>
        <svg class="w-2.5 h-2.5 -mr-0.5 group-hover:translate-x-0.5 transition-transform" viewBox="0 0 12 12" fill="none">
          <path d="M3 6h6m0 0L7 4m2 2L7 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
    </span>
  </button>

  <!-- ──────────────── WINDOW ──────────────── -->
  <div
    id="chat-window"
    class="chat-window fixed bottom-6 right-6 z-[60]
           w-[calc(100vw-3rem)] max-w-[400px] h-[640px] max-h-[calc(100vh-3rem)]
           flex flex-col overflow-hidden
           bg-brand-surface
           border border-brand-border-2 rounded-3xl
           shadow-[0_32px_64px_-12px_rgba(0,0,0,0.7),0_0_0_1px_rgba(61,142,248,0.15),inset_0_1px_0_rgba(255,255,255,0.05)]"
    role="dialog"
    aria-label="Консультация с Анастасией"
  >
    <!-- Фоновое свечение -->
    <div class="absolute inset-x-0 top-0 h-32 bg-hero-radial pointer-events-none opacity-60"></div>

    <!-- ─── Header ─── -->
    <header class="relative flex items-center gap-3 px-5 pt-5 pb-4 border-b border-brand-border">
      <div class="relative w-12 h-12 rounded-full flex-shrink-0 overflow-hidden
                  ring-1 ring-brand-accent/50
                  shadow-[0_0_24px_rgba(61,142,248,0.5)]">
        <img src="/images/anastasiya.jpg" alt="Анастасия, менеджер UBuyer"
             class="w-full h-full object-cover" loading="lazy" decoding="async" />
        <span id="chat-status-orb"
              class="absolute -bottom-0.5 -right-0.5 w-3.5 h-3.5 rounded-full bg-brand-cta
                     ring-[3px] ring-brand-surface
                     shadow-[0_0_10px_rgba(16,185,129,0.7)]"></span>
      </div>

      <div class="flex-1 min-w-0">
        <div class="text-brand-text font-semibold text-[15px] tracking-tight leading-tight">Анастасия</div>
        <div id="chat-status-line"
             class="text-brand-muted text-xs mt-0.5 leading-tight flex items-center gap-1.5">
          <span class="chat-status-text">Менеджер UBuyer</span>
        </div>
      </div>

      <button
        id="chat-reset"
        type="button"
        aria-label="Начать заново"
        title="Начать заново"
        class="chat-reset-btn text-brand-muted hover:text-brand-text active:scale-90
               w-8 h-8 rounded-full flex items-center justify-center
               hover:bg-brand-surface-2 transition-all"
      >
        <svg class="w-4 h-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7">
          <path stroke-linecap="round" stroke-linejoin="round"
                d="M2 8a6 6 0 0 1 10.5-4M14 3v3.5h-3.5M14 8a6 6 0 0 1-10.5 4M2 13v-3.5h3.5"/>
        </svg>
      </button>

      <button
        id="chat-minimize"
        type="button"
        aria-label="Свернуть"
        title="Свернуть"
        class="chat-minimize-btn text-brand-muted hover:text-brand-text active:scale-90
               w-8 h-8 rounded-full flex items-center justify-center
               hover:bg-brand-surface-2 transition-all"
      >
        <svg class="w-4 h-4" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 11h8"/>
        </svg>
      </button>

      <button
        id="chat-close"
        type="button"
        aria-label="Закрыть"
        title="Закрыть"
        class="chat-close-btn text-brand-text hover:text-white active:scale-90
               w-9 h-9 rounded-full flex items-center justify-center flex-shrink-0
               bg-brand-surface-2 hover:bg-brand-border
               border border-brand-border hover:border-brand-accent/60
               transition-all"
      >
        <svg class="w-4 h-4" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 3l8 8M11 3l-8 8"/>
        </svg>
      </button>
    </header>

    <!-- ─── Messages ─── -->
    <div
      id="chat-messages"
      class="relative flex-1 overflow-y-auto overflow-x-hidden px-4 py-5 space-y-3.5 text-[14px] leading-relaxed"
    >
      <!-- Welcome hero-card (текст вставится через typed-эффект скриптом) -->
      <div class="chat-welcome chat-msg-welcome">
        <div class="chat-welcome-card">
          <span class="welcome-accent" aria-hidden="true"></span>
          <h3 id="welcome-line-1" class="welcome-title"></h3>
          <p id="welcome-line-2" class="welcome-text"></p>
          <div class="welcome-hint" aria-hidden="true">
            <svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.7">
              <path d="M7 2v10m0 0L3 8m4 4l4-4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Что вас интересует? Опишите или выберите ниже
          </div>
        </div>
      </div>

      <!-- Стартеры -->
      <div id="chat-starters" class="chat-starters flex flex-col gap-2 pt-1 pb-2">
        {STARTERS.map((starter, i) => (
          <button
            type="button"
            class="chat-starter group/chip relative text-left w-full
                   flex items-center gap-3
                   bg-brand-surface-2 hover:bg-gradient-to-br hover:from-brand-surface-2 hover:to-brand-surface
                   border border-brand-border hover:border-brand-accent/60
                   rounded-2xl pl-3 pr-4 py-3
                   shadow-[inset_0_1px_0_rgba(255,255,255,0.03)]
                   hover:shadow-[0_8px_24px_-8px_rgba(61,142,248,0.35),0_0_0_1px_rgba(61,142,248,0.25),inset_0_1px_0_rgba(255,255,255,0.06)]
                   hover:-translate-y-0.5
                   active:translate-y-0 active:scale-[0.99]
                   transition-all duration-200 ease-out"
            data-starter={starter.text}
            style={`--chip-delay: ${i * 90}ms`}
          >
            <!-- Иконка -->
            <span class="chip-icon w-9 h-9 rounded-xl flex items-center justify-center flex-shrink-0
                         bg-brand-accent-dim text-brand-accent
                         group-hover/chip:bg-brand-accent group-hover/chip:text-white
                         group-hover/chip:shadow-[0_0_16px_rgba(61,142,248,0.5),inset_0_1px_0_rgba(255,255,255,0.2)]
                         transition-all duration-200">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d={starter.iconPath}/>
              </svg>
            </span>

            <span class="flex-1 text-brand-text/90 group-hover/chip:text-brand-text
                         text-[13.5px] font-medium leading-tight">
              {starter.label}
            </span>

            <svg class="w-3.5 h-3.5 text-brand-muted group-hover/chip:text-brand-accent
                        group-hover/chip:translate-x-0.5 transition-all flex-shrink-0"
                 viewBox="0 0 14 14" fill="none">
              <path d="M3 7h8m0 0L8 4m3 3L8 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        ))}
      </div>
    </div>

    <!-- ─── Typing indicator ─── -->
    <div id="chat-typing" class="chat-typing px-4 pb-1 hidden">
      <div class="chat-bubble chat-bubble-assistant inline-flex max-w-fit">
        <span class="typing-skeleton"><span></span><span></span><span></span></span>
      </div>
    </div>

    <!-- ─── New message badge (Fix H: smart-scroll) ─── -->
    <button id="chat-new-msg-badge" class="chat-new-msg-badge" hidden type="button" aria-label="Перейти к новому сообщению">
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M4 6l4 4 4-4" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span>Новое сообщение</span>
    </button>

    <!-- ─── Success card ─── -->
    <div id="chat-success" class="chat-success px-4 pb-3 hidden">
      <div class="relative rounded-2xl px-4 py-4 overflow-hidden
                  bg-gradient-to-br from-brand-cta/15 to-brand-cta/5
                  border border-brand-cta/40
                  shadow-[0_0_32px_rgba(16,185,129,0.18),inset_0_1px_0_rgba(255,255,255,0.06)]">
        <div class="flex items-start gap-3">
          <div class="w-10 h-10 rounded-full flex-shrink-0 flex items-center justify-center
                      bg-brand-cta text-white
                      shadow-[0_0_16px_rgba(16,185,129,0.5),inset_0_1px_0_rgba(255,255,255,0.3)]">
            <svg class="w-5 h-5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 10l4 4 8-8"/>
            </svg>
          </div>
          <div class="flex-1 min-w-0">
            <div class="text-brand-text font-semibold text-[15px] tracking-tight">Контакт у менеджера</div>
            <div class="text-brand-text/75 text-[13px] mt-1 leading-snug">Напишет вам первым в течение ~15 минут.</div>
          </div>
        </div>
      </div>
    </div>

    <!-- ─── Input zone ─── -->
    <!-- relative — якорь для absolute tg/phone-hint внутри inputWrap. -->
    <form id="chat-form" class="chat-input-zone relative px-4 pt-3 pb-3 border-t border-brand-border bg-brand-surface">
      <div id="chat-input-wrap" class="chat-input-wrap relative flex items-end gap-2
                                       bg-brand-surface-2 border border-brand-border
                                       rounded-2xl px-3 py-2.5
                                       transition-all duration-200">
        <textarea
          id="chat-input"
          rows="1"
          placeholder="Опишите ситуацию или задайте вопрос…"
          class="chat-input flex-1 bg-transparent border-0
                 text-brand-text placeholder:text-brand-muted text-[14px]
                 focus:outline-none resize-none max-h-32
                 leading-relaxed"
        ></textarea>
        <button
          type="submit"
          id="chat-send"
          aria-label="Отправить"
          disabled
          class="chat-send w-9 h-9 rounded-xl flex items-center justify-center flex-shrink-0
                 bg-brand-accent-dim text-brand-muted
                 disabled:cursor-not-allowed
                 transition-all duration-200"
        >
          <svg class="w-4 h-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 13V3M3 8l5-5 5 5"/>
          </svg>
        </button>
      </div>

    </form>
  </div>
</div>

<style is:global>
  /* ============== STATE MACHINE ============== */
  #chat-widget[data-state="closed"] #chat-window {
    opacity: 0;
    transform: translateY(16px) scale(0.96);
    pointer-events: none;
    transition: opacity 220ms cubic-bezier(0.16, 1, 0.3, 1),
                transform 280ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  #chat-widget[data-state="open"] #chat-window {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
    transition: opacity 240ms cubic-bezier(0.16, 1, 0.3, 1),
                transform 320ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  #chat-widget[data-state="open"] #chat-toggle {
    opacity: 0;
    transform: scale(0.85);
    pointer-events: none;
    transition: opacity 200ms ease-out, transform 240ms ease-out;
  }
  #chat-widget[data-state="closed"] #chat-toggle {
    opacity: 1;
    transform: scale(1);
    transition: opacity 240ms 80ms ease-out, transform 320ms 80ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Свёрнутое состояние — окно скрыто (как closed), pill показан.
     Контекст диалога сохраняется, badge показывает непрочитанные. */
  #chat-widget[data-state="minimized"] #chat-window {
    opacity: 0;
    transform: translateY(16px) scale(0.96);
    pointer-events: none;
    transition: opacity 220ms cubic-bezier(0.16, 1, 0.3, 1),
                transform 280ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  #chat-widget[data-state="minimized"] #chat-toggle {
    opacity: 1;
    transform: scale(1);
    transition: opacity 240ms 80ms ease-out, transform 320ms 80ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Badge непрочитанных. По умолчанию скрыт (data-count="0"). */
  .chat-unread-badge {
    position: absolute;
    top: -4px;
    right: -4px;
    min-width: 20px;
    height: 20px;
    padding: 0 6px;
    background: #ef4444;
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    line-height: 20px;
    text-align: center;
    border-radius: 999px;
    box-shadow: 0 2px 8px rgba(239, 68, 68, 0.55),
                0 0 0 2px var(--brand-surface, #0b0c10);
    opacity: 0;
    transform: scale(0);
    transition: opacity 200ms ease-out, transform 260ms cubic-bezier(0.34, 1.56, 0.64, 1);
    pointer-events: none;
    z-index: 2;
  }
  .chat-unread-badge[data-count]:not([data-count="0"]) {
    opacity: 1;
    transform: scale(1);
  }

  /* Pulse-анимация на pill когда есть непрочитанные.
     Тонкая, не агрессивная — привлекает внимание не пугая. */
  @keyframes chatPillPulse {
    0%, 100% { box-shadow: 0 8px 32px rgba(0,0,0,0.45),
                            0 0 0 1px rgba(61,142,248,0.15),
                            inset 0 1px 0 rgba(255,255,255,0.04); }
    50%      { box-shadow: 0 8px 32px rgba(0,0,0,0.45),
                            0 0 0 2px rgba(239, 68, 68, 0.55),
                            0 0 24px rgba(239, 68, 68, 0.35),
                            inset 0 1px 0 rgba(255,255,255,0.04); }
  }
  #chat-widget[data-state="minimized"] #chat-toggle:has(.chat-unread-badge[data-count]:not([data-count="0"])) {
    animation: chatPillPulse 2.2s ease-in-out infinite;
  }

  /* После лида прячем только starters (они теряют смысл). Input оставляем
     открытым — клиент может задать дополнительный вопрос. */
  #chat-widget[data-status="submitted"] #chat-starters {
    display: none;
  }
  #chat-widget[data-status="submitted"] #chat-success {
    display: block;
    animation: successIn 380ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes successIn {
    from { opacity: 0; transform: translateY(8px) scale(0.98); }
    to   { opacity: 1; transform: translateY(0)   scale(1); }
  }

  /* ============== PILL: ambient pulse + phrase rotation ============== */
  @keyframes ambientPulse {
    0%, 100% { box-shadow: 0 8px 32px rgba(0,0,0,0.45),
                           0 0 0 1px rgba(61,142,248,0.15),
                           inset 0 1px 0 rgba(255,255,255,0.04),
                           0 0 0 0 rgba(61,142,248,0); }
    50%      { box-shadow: 0 8px 32px rgba(0,0,0,0.45),
                           0 0 0 1px rgba(61,142,248,0.28),
                           inset 0 1px 0 rgba(255,255,255,0.05),
                           0 0 0 8px rgba(61,142,248,0.05); }
  }
  .chat-pill {
    animation: ambientPulse 4.5s ease-in-out infinite;
  }
  .chat-pill:hover { animation-play-state: paused; }

  .chat-pill-phrase {
    display: inline-block;
    transition: opacity 200ms ease-out, transform 200ms ease-out;
  }
  .chat-pill-phrase.is-fading {
    opacity: 0;
    transform: translateY(-4px);
  }
  .chat-pill-phrase.is-entering {
    opacity: 0;
    transform: translateY(4px);
  }

  /* ============== HEADER: live typing indicator ============== */
  .chat-status-text {
    transition: opacity 180ms ease-out;
  }
  #chat-widget[data-status="typing"] #chat-status-line .chat-status-text {
    color: #4DD9FF;
  }
  #chat-widget[data-status="typing"] #chat-status-orb {
    background: #4DD9FF;
    box-shadow: 0 0 12px rgba(77,217,255,0.8);
    animation: orbPulse 1.2s ease-in-out infinite;
  }
  @keyframes orbPulse {
    0%, 100% { transform: scale(1);   opacity: 1;   }
    50%      { transform: scale(1.3); opacity: 0.7; }
  }
  .typing-cursor {
    display: inline-block;
    width: 2px;
    height: 11px;
    background: #4DD9FF;
    margin-left: 2px;
    vertical-align: text-bottom;
    animation: cursorBlink 0.9s steps(2) infinite;
  }
  @keyframes cursorBlink {
    0%, 50%  { opacity: 1; }
    51%,100% { opacity: 0; }
  }

  /* ============== MESSAGE BUBBLES ============== */
  .chat-msg { display: flex; animation: msgIn 320ms cubic-bezier(0.16, 1, 0.3, 1) backwards; }
  .chat-msg-assistant { justify-content: flex-start; }
  .chat-msg-user      { justify-content: flex-end; }

  @keyframes msgIn {
    from { opacity: 0; transform: translateY(8px) scale(0.97); }
    to   { opacity: 1; transform: translateY(0)   scale(1); }
  }

  .chat-bubble {
    max-width: 88%;
    padding: 12px 16px;
    font-size: 14px;
    line-height: 1.55;
    white-space: pre-wrap;
    word-wrap: break-word;
    border-radius: 18px;
  }
  .chat-bubble-assistant {
    background: #0C1530;
    color: #E4ECFF;
    border: 1px solid #1A2B4A;
    border-top-left-radius: 6px;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.04),
                0 2px 12px rgba(0,0,0,0.25);
    white-space: normal;  /* HTML сам обрабатывает пробелы */
  }
  /* ── Markdown в ответах Анастасии ── */
  .chat-bubble-assistant p {
    margin: 0 0 8px 0;
    line-height: 1.55;
  }
  .chat-bubble-assistant p:last-child { margin-bottom: 0; }
  .chat-bubble-assistant strong {
    color: #fff;
    font-weight: 600;
  }
  .chat-bubble-assistant em {
    font-style: italic;
    color: rgba(228,236,255,0.95);
  }
  .chat-bubble-assistant ul,
  .chat-bubble-assistant ol {
    margin: 6px 0;
    padding-left: 18px;
  }
  .chat-bubble-assistant li {
    margin: 3px 0;
    line-height: 1.5;
  }
  .chat-bubble-assistant li::marker {
    color: #3D8EF8;
  }
  .chat-bubble-assistant h1,
  .chat-bubble-assistant h2,
  .chat-bubble-assistant h3,
  .chat-bubble-assistant h4 {
    font-size: 14px;
    font-weight: 600;
    color: #fff;
    margin: 10px 0 4px;
    line-height: 1.3;
    letter-spacing: -0.005em;
  }
  .chat-bubble-assistant h1:first-child,
  .chat-bubble-assistant h2:first-child,
  .chat-bubble-assistant h3:first-child { margin-top: 0; }
  .chat-bubble-assistant code {
    background: rgba(61,142,248,0.15);
    color: #4DD9FF;
    padding: 1px 5px;
    border-radius: 4px;
    font-size: 12.5px;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
  }
  .chat-bubble-assistant pre {
    background: rgba(0,0,0,0.3);
    border: 1px solid rgba(26,43,74,0.6);
    border-radius: 10px;
    padding: 10px 12px;
    margin: 6px 0;
    overflow-x: auto;
    font-size: 12.5px;
  }
  .chat-bubble-assistant pre code {
    background: transparent;
    padding: 0;
    color: #E4ECFF;
  }
  .chat-bubble-assistant a {
    color: #4DD9FF;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
    transition: color 150ms ease;
  }
  .chat-bubble-assistant a:hover {
    color: #fff;
  }
  .chat-bubble-assistant blockquote {
    border-left: 2px solid rgba(61,142,248,0.4);
    padding-left: 10px;
    margin: 6px 0;
    color: rgba(228,236,255,0.7);
  }
  .chat-bubble-assistant s,
  .chat-bubble-assistant del {
    color: rgba(228,236,255,0.5);
  }
  .chat-bubble-user {
    background: linear-gradient(135deg, #3D8EF8 0%, #2B7AE8 100%);
    color: #fff;
    border-top-right-radius: 6px;
    box-shadow: 0 0 24px rgba(61,142,248,0.25),
                inset 0 1px 0 rgba(255,255,255,0.18),
                inset 0 -1px 0 rgba(0,0,0,0.1);
  }

  /* ============== WELCOME hero-card ============== */
  .chat-welcome {
    display: flex;
    animation: msgIn 380ms cubic-bezier(0.16, 1, 0.3, 1) backwards;
  }
  .chat-welcome-card {
    position: relative;
    width: 100%;
    padding: 20px 22px 16px 24px;
    background:
      radial-gradient(120% 80% at 100% 0%, rgba(61,142,248,0.10) 0%, transparent 55%),
      linear-gradient(135deg, rgba(12,21,48,0.7) 0%, rgba(8,15,36,0.95) 100%);
    border: 1px solid rgba(36,58,96,0.7);
    border-radius: 20px;
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,0.06),
      0 4px 20px rgba(0,0,0,0.35),
      0 0 0 1px rgba(61,142,248,0.08);
    overflow: hidden;
  }
  .welcome-accent {
    position: absolute;
    left: 0;
    top: 14px;
    bottom: 14px;
    width: 2px;
    border-radius: 0 2px 2px 0;
    background: linear-gradient(180deg,
      rgba(61,142,248,0.7) 0%,
      rgba(77,217,255,0.3) 100%);
    box-shadow: 0 0 12px rgba(61,142,248,0.35);
  }
  .welcome-title {
    color: #fff;
    font-weight: 600;
    font-size: 16px;
    letter-spacing: -0.01em;
    line-height: 1.3;
    margin: 0;
    /* Fix B: резервируем место под 2 строки заранее — текст может занять
       1 или 2 строки, без этого высота карточки прыгает при typed-эффекте */
    min-height: 44px;
  }
  .welcome-text {
    color: rgba(228,236,255,0.78);
    font-size: 13.5px;
    line-height: 1.55;
    margin: 8px 0 0;
    /* Fix B: то же — место под 2 строки заранее */
    min-height: 44px;
  }
  .welcome-hint {
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid rgba(26,43,74,0.6);
    font-size: 11.5px;
    color: rgba(61,142,248,0.78);
    display: flex;
    align-items: center;
    gap: 6px;
    font-weight: 500;
    letter-spacing: 0.01em;
  }
  .welcome-hint svg {
    width: 12px;
    height: 12px;
    flex-shrink: 0;
    animation: hintBob 2.4s ease-in-out infinite;
  }
  @keyframes hintBob {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(2px); }
  }

  /* ============== STARTER chip-ы — staggered entry ============== */
  .chat-starter {
    opacity: 0;
    transform: translateY(8px);
    animation: starterIn 420ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: var(--chip-delay, 0ms);
  }
  @keyframes starterIn {
    to { opacity: 1; transform: translateY(0); }
  }

  /* ============== INPUT FOCUS ============== */
  .chat-input-wrap:focus-within {
    border-color: rgba(61,142,248,0.6);
    box-shadow: 0 0 0 3px rgba(61,142,248,0.18),
                inset 0 1px 0 rgba(255,255,255,0.04);
  }
  .chat-input-wrap.chat-input-invalid {
    border-color: rgba(239,68,68,0.55);
    box-shadow: 0 0 0 3px rgba(239,68,68,0.12),
                inset 0 1px 0 rgba(255,255,255,0.04);
  }
  .chat-input-wrap.chat-input-invalid:focus-within {
    border-color: rgba(239,68,68,0.7);
    box-shadow: 0 0 0 3px rgba(239,68,68,0.20),
                inset 0 1px 0 rgba(255,255,255,0.04);
  }

  /* ============== Telegram-hint снизу инпута (Fix G: absolute inside wrap) ============== */
  .chat-input-wrap { position: relative; }
  .chat-tg-hint {
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: -22px;
    font-size: 11.5px;
    line-height: 1.4;
    color: rgba(228,236,255,0.55);
    pointer-events: none;
    animation: msgIn 220ms ease-out;
  }
  .chat-tg-hint[data-state="ok"]      { color: #10B981; }
  .chat-tg-hint[data-state="error"]   { color: #F87171; }
  .chat-tg-hint[data-state="pending"] { color: rgba(228,236,255,0.55); }
  /* Когда показан hint, увеличиваем pb формы чтобы trust-bar не перекрылся */
  .chat-input-zone:has(.chat-tg-hint) { padding-bottom: 2.75rem; }

  /* ============== SEND button states ============== */
  .chat-send:not(:disabled) {
    background: linear-gradient(135deg, #3D8EF8 0%, #2B7AE8 100%);
    color: #fff;
    box-shadow: 0 0 16px rgba(61,142,248,0.4),
                inset 0 1px 0 rgba(255,255,255,0.2);
  }
  .chat-send:not(:disabled):hover {
    transform: translateY(-1px);
    box-shadow: 0 0 24px rgba(61,142,248,0.55),
                inset 0 1px 0 rgba(255,255,255,0.25);
  }
  .chat-send:not(:disabled):active { transform: translateY(0) scale(0.94); }

  /* ============== TYPING SKELETON ============== */
  .typing-skeleton {
    display: inline-flex; align-items: center; gap: 5px; padding: 2px 0;
  }
  .typing-skeleton span {
    width: 6px; height: 6px; border-radius: 50%;
    background: rgba(228,236,255,0.5);
    animation: typingPulse 1.4s ease-in-out infinite;
  }
  .typing-skeleton span:nth-child(2) { animation-delay: 0.18s; }
  .typing-skeleton span:nth-child(3) { animation-delay: 0.36s; }
  @keyframes typingPulse {
    0%, 80%, 100% { transform: scale(0.7); opacity: 0.4; }
    40%           { transform: scale(1);   opacity: 1;   }
  }

  /* ============== CONTACT REQUEST block (trust + quick replies) ============== */
  .chat-contact-request {
    margin-top: 10px;
    padding: 14px;
    background: linear-gradient(135deg, rgba(12,21,48,0.6) 0%, rgba(8,15,36,0.9) 100%);
    border: 1px solid rgba(36,58,96,0.7);
    border-radius: 16px;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.04);
    animation: msgIn 320ms cubic-bezier(0.16, 1, 0.3, 1);
    transition: box-shadow 0.4s ease, border-color 0.4s ease, transform 0.4s ease;
  }
  /* Подсветка формы когда клиент нажал «Получить расчёт» в nudge —
     визуальный якорь куда смотреть */
  .chat-contact-request.chat-contact-request-highlighted {
    border-color: rgba(232,185,107,0.85);
    box-shadow: 0 0 0 3px rgba(232,185,107,0.18), inset 0 1px 0 rgba(255,255,255,0.06);
    transform: scale(1.012);
  }

  /* Nudge: статичный блок с 2 кнопками после 40 сек тишины */
  .chat-nudge-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
  }
  .nudge-btn {
    appearance: none;
    border: 1px solid rgba(108,128,170,0.45);
    background: rgba(20,30,55,0.55);
    color: rgba(228,236,255,0.92);
    padding: 8px 12px;
    border-radius: 12px;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.18s ease, border-color 0.18s ease, transform 0.12s ease;
    line-height: 1.2;
  }
  .nudge-btn:hover {
    background: rgba(36,52,90,0.7);
    border-color: rgba(140,160,200,0.6);
  }
  .nudge-btn:active {
    transform: scale(0.97);
  }
  .nudge-btn-primary {
    background: linear-gradient(135deg, rgba(232,185,107,0.92) 0%, rgba(212,160,80,0.92) 100%);
    border-color: rgba(232,185,107,0.7);
    color: #1a1410;
    font-weight: 600;
  }
  .nudge-btn-primary:hover {
    background: linear-gradient(135deg, rgba(244,200,125,1) 0%, rgba(226,175,95,1) 100%);
    border-color: rgba(244,200,125,0.85);
  }
  .contact-trust-title {
    font-size: 11px;
    color: rgba(228,236,255,0.55);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 600;
    margin-bottom: 8px;
  }
  .contact-trust-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 12px;
  }
  .contact-trust-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: #E4ECFF;
    line-height: 1.4;
  }
  .contact-trust-item .check {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    border-radius: 50%;
    background: rgba(16,185,129,0.18);
    color: #10B981;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .contact-trust-item .check svg { width: 10px; height: 10px; }

  /* 3 широкие кнопки на всю ширину чата, стопкой */
  .contact-quick-replies {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 10px;
  }
  .contact-quick-replies button {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 12px 14px;
    background: rgba(61,142,248,0.10);
    border: 1px solid rgba(61,142,248,0.30);
    border-radius: 12px;
    color: #E4ECFF;
    font-size: 13.5px;
    font-weight: 500;
    text-align: left;
    cursor: pointer;
    transition: all 180ms ease;
  }
  .contact-quick-replies button:hover {
    background: rgba(61,142,248,0.20);
    border-color: rgba(61,142,248,0.55);
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(61,142,248,0.15);
  }
  .contact-quick-replies button:active { transform: translateY(0) scale(0.98); }
  /* Активная кнопка — подсветка чтобы клиент видел что переключил режим */
  .contact-quick-replies button.qr-active {
    background: rgba(61,142,248,0.30);
    border-color: rgba(61,142,248,0.85);
    box-shadow: 0 0 0 1px rgba(61,142,248,0.35), 0 4px 16px rgba(61,142,248,0.20);
  }
  .contact-quick-replies .qr-icon {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    border-radius: 8px;
    background: rgba(61,142,248,0.22);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #4DD9FF;
  }
  .contact-quick-replies .qr-icon svg { width: 14px; height: 14px; }

  /* Рекомендованные кнопки (ник + телефон) */
  .contact-quick-replies .qr-recommended {
    background: rgba(61,142,248,0.15);
    border-color: rgba(61,142,248,0.45);
  }
  .contact-quick-replies .qr-recommended:hover {
    background: rgba(61,142,248,0.25);
    border-color: rgba(61,142,248,0.65);
  }

  /* Поле контакта прямо в блоке (появляется после выбора канала) */
  .contact-field-panel { margin-top: 10px; }
  .contact-field-panel[hidden] { display: none; }
  .contact-field-input {
    width: 100%;
    padding: 11px 13px;
    border-radius: 12px;
    border: 1px solid #24385F;
    background: #04091A;
    color: #E4ECFF;
    font-size: 16px;
    outline: none;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .contact-field-input:focus {
    border-color: rgba(61,142,248,0.6);
    box-shadow: 0 0 0 3px rgba(61,142,248,0.16);
  }
  .contact-field-hint {
    min-height: 15px;
    margin: 6px 2px 0;
    font-size: 11.5px;
    line-height: 1.35;
    color: rgba(228,236,255,0.55);
  }
  .contact-field-hint[data-state="ok"]    { color: #10B981; }
  .contact-field-hint[data-state="error"] { color: #F87171; }
  .contact-field-submit {
    width: 100%;
    margin-top: 8px;
    padding: 11px 14px;
    border: 0;
    border-radius: 12px;
    background: linear-gradient(135deg, #3D8EF8 0%, #2B7AE8 100%);
    color: #fff;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 0 16px rgba(61,142,248,0.35), inset 0 1px 0 rgba(255,255,255,0.2);
    transition: opacity 0.15s, transform 0.12s;
  }
  .contact-field-submit:disabled { opacity: 0.4; cursor: not-allowed; box-shadow: none; }
  .contact-field-submit:not(:disabled):hover { opacity: 0.93; }
  .contact-field-submit:not(:disabled):active { transform: scale(0.98); }

  .contact-privacy-note {
    font-size: 10.5px;
    color: rgba(228,236,255,0.5);
    text-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    line-height: 1.3;
  }
  .contact-privacy-note svg {
    width: 10px; height: 10px;
    color: rgba(61,142,248,0.5);
  }

  /* ── QR Quick-reply buttons ── */
  .chat-qr-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 4px;
    animation: msgIn 280ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .chat-qr-btn {
    padding: 8px 14px;
    background: rgba(61,142,248,0.12);
    border: 1px solid rgba(61,142,248,0.35);
    border-radius: 999px;
    color: #E4ECFF;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: all 160ms ease;
    line-height: 1.2;
  }
  .chat-qr-btn:hover {
    background: rgba(61,142,248,0.22);
    border-color: rgba(61,142,248,0.6);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(61,142,248,0.18);
  }
  .chat-qr-btn:active { transform: translateY(0) scale(0.97); }

  /* Idle prompt — отдельный стиль (мягкая подсказка) */
  .chat-idle-prompt {
    margin-top: 8px;
    padding: 10px 14px;
    background: rgba(12,21,48,0.5);
    border: 1px dashed rgba(36,58,96,0.7);
    border-radius: 14px;
    font-size: 13px;
    color: rgba(228,236,255,0.75);
    font-style: italic;
    animation: msgIn 320ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* ============== PROACTIVE NUDGE (#1) ============== */
  .chat-nudge {
    position: fixed;
    right: 24px;
    bottom: 88px;        /* над pill */
    z-index: 55;          /* ниже chat-window (60) */
    max-width: 270px;
    padding: 14px 36px 14px 16px;
    background: linear-gradient(135deg, rgba(12,21,48,0.97) 0%, rgba(8,15,36,0.97) 100%);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(61,142,248,0.45);
    border-radius: 18px;
    color: #E4ECFF;
    font-size: 13px;
    line-height: 1.4;
    cursor: pointer;
    box-shadow: 0 24px 56px -8px rgba(0,0,0,0.55),
                0 0 0 1px rgba(61,142,248,0.18),
                inset 0 1px 0 rgba(255,255,255,0.04);
    animation: nudgeIn 380ms cubic-bezier(0.16, 1, 0.3, 1);
    transition: transform 200ms ease, border-color 200ms ease;
  }
  .chat-nudge:hover {
    transform: translateY(-2px);
    border-color: rgba(61,142,248,0.7);
  }
  .chat-nudge::after {
    content: '';
    position: absolute;
    right: 30px;
    bottom: -7px;
    width: 12px;
    height: 12px;
    background: linear-gradient(135deg, rgba(12,21,48,0.97) 0%, rgba(8,15,36,0.97) 100%);
    border-right: 1px solid rgba(61,142,248,0.45);
    border-bottom: 1px solid rgba(61,142,248,0.45);
    transform: rotate(45deg);
  }
  .chat-nudge-title {
    font-weight: 600;
    color: #fff;
    margin-bottom: 3px;
    font-size: 13.5px;
    letter-spacing: -0.005em;
  }
  .chat-nudge-text {
    color: rgba(228,236,255,0.75);
    font-size: 12.5px;
  }
  .chat-nudge-close {
    position: absolute;
    top: 6px;
    right: 8px;
    width: 22px;
    height: 22px;
    color: rgba(228,236,255,0.55);
    font-size: 18px;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    transition: all 150ms ease;
    background: transparent;
  }
  .chat-nudge-close:hover {
    color: #fff;
    background: rgba(228,236,255,0.1);
  }
  @keyframes nudgeIn {
    from { opacity: 0; transform: translateY(8px) scale(0.96); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }
  .chat-nudge-leaving {
    animation: nudgeOut 280ms ease-out forwards;
  }
  @keyframes nudgeOut {
    to { opacity: 0; transform: translateY(8px) scale(0.96); }
  }
  @media (max-width: 640px) {
    .chat-nudge {
      right: 16px;
      bottom: 76px;
      max-width: 240px;
    }
  }

  /* ============== NEW MESSAGE BADGE (Fix H) ============== */
  .chat-new-msg-badge {
    position: absolute;
    left: 50%;
    bottom: 96px;
    transform: translateX(-50%);
    z-index: 5;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    background: linear-gradient(135deg, #3D8EF8 0%, #2B7AE8 100%);
    color: #fff;
    border: 1px solid rgba(77,217,255,0.45);
    border-radius: 999px;
    font-size: 12.5px;
    font-weight: 500;
    cursor: pointer;
    white-space: nowrap;
    box-shadow: 0 8px 24px rgba(61,142,248,0.45),
                inset 0 1px 0 rgba(255,255,255,0.18);
    animation: badgeIn 280ms cubic-bezier(0.16, 1, 0.3, 1);
    transition: transform 150ms ease, box-shadow 150ms ease;
  }
  .chat-new-msg-badge:hover {
    transform: translateX(-50%) translateY(-2px);
    box-shadow: 0 12px 32px rgba(61,142,248,0.55);
  }
  .chat-new-msg-badge:active { transform: translateX(-50%) translateY(0) scale(0.97); }
  .chat-new-msg-badge svg { width: 13px; height: 13px; flex-shrink: 0; }
  .chat-new-msg-badge[hidden] { display: none !important; }
  @keyframes badgeIn {
    from { opacity: 0; transform: translateX(-50%) translateY(8px); }
    to   { opacity: 1; transform: translateX(-50%) translateY(0); }
  }

  /* ============== SCROLLBAR ============== */
  /* overscroll-behavior: contain — скролл ленты не «протекает» на страницу
     позади: на границе списка основная страница больше НЕ листается. */
  #chat-messages {
    overscroll-behavior: contain;
  }
  #chat-messages::-webkit-scrollbar { width: 6px; }
  #chat-messages::-webkit-scrollbar-track { background: transparent; }
  #chat-messages::-webkit-scrollbar-thumb { background: rgba(102,128,168,0.2); border-radius: 3px; }
  #chat-messages::-webkit-scrollbar-thumb:hover { background: rgba(102,128,168,0.4); }

  /* ============== MOBILE ============== */
  @media (max-width: 640px) {
    /* Чат открыт на весь экран — блокируем скролл страницы позади, чтобы
       палец листал именно чат, а не «уезжающую» основную страницу. */
    html:has(#chat-widget[data-state="open"]) { overflow: hidden; }

    /* Pill — оставляем с текстом и ротацией, чуть компактнее */
    .chat-pill {
      padding: 5px 14px 5px 5px;
      bottom: 16px !important;
      right: 16px !important;
    }
    .chat-pill .chat-pill-text { display: flex; }
    .chat-pill-text > span:first-child { font-size: 13px; }
    .chat-pill-rotation { font-size: 10.5px; }

    /* Окно — fullscreen.
       Fix D: 100dvh (dynamic viewport height) учитывает iOS-клавиатуру и
       нижний UI Safari. С 100% trust-bar и input уходят под клавиатуру —
       юзер не видит куда писать. С 100dvh окно сжимается до видимой части. */
    #chat-widget #chat-window {
      inset: 0 !important;
      width: 100% !important;
      max-width: 100% !important;
      height: 100dvh !important;
      max-height: 100dvh !important;
      border-radius: 0 !important;
      border: none !important;
      bottom: 0 !important;
      right: 0 !important;
    }

    /* Кнопка закрытия — крупнее, контрастнее */
    .chat-close-btn {
      width: 40px !important;
      height: 40px !important;
    }
    .chat-close-btn svg {
      width: 18px;
      height: 18px;
    }
    #chat-reset {
      width: 36px;
      height: 36px;
    }

    /* Welcome-card отступы поменьше */
    .chat-welcome-card {
      padding: 18px 18px 14px 22px;
    }

    /* Поле ввода крупнее на мобиле — удобнее набирать */
    .chat-input {
      font-size: 16px;  /* предотвращает zoom на iOS при focus */
    }
  }

  /* ============== A11Y ============== */
  @media (prefers-reduced-motion: reduce) {
    .chat-pill, .chat-msg, .chat-starter,
    .chat-pill-phrase, #chat-status-orb {
      animation: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  import { marked } from 'marked';
  import DOMPurify from 'dompurify';

  type Role = 'user' | 'assistant';
  interface ChatMessage { role: Role; content: string }

  marked.setOptions({
    breaks: true,  // \n внутри абзаца → <br>
    gfm: true,     // GitHub-Flavored: автоссылки, таблицы, ~~зачёркнутый~~
  });

  const ALLOWED_TAGS = [
    'p', 'br', 'strong', 'em', 'ul', 'ol', 'li',
    'h1', 'h2', 'h3', 'h4', 'h5', 'h6',
    'blockquote', 'code', 'pre', 'a', 's', 'del',
  ];

  // Регулярка маркера CONTACT_REQUEST — case-insensitive, допускает пробелы и переносы
  const CONTACT_MARKER_RE = /\s*\[\s*CONTACT[_\s]?REQUEST\s*\]\s*/gi;
  // Регулярка маркера QR с вариантами: [QR: Вариант1 | Вариант2 | Вариант3]
  const QR_MARKER_RE = /\s*\[\s*QR\s*:\s*([^\]]+?)\s*\]\s*/gi;

  function parseQrOptions(text: string): string[] {
    const matches: string[] = [];
    let m: RegExpExecArray | null;
    const re = new RegExp(QR_MARKER_RE.source, QR_MARKER_RE.flags);
    while ((m = re.exec(text)) !== null) {
      const options = m[1].split('|').map(s => s.trim()).filter(s => s.length > 0);
      matches.push(...options);
    }
    return matches;
  }

  /**
   * #6 Эвристика для quick-replies. Анастасия не всегда ставит [QR:]
   * маркер, но часто задаёт типовые квалификационные вопросы. Если
   * detected — рисуем кнопки автоматом, чтобы юзер не печатал.
   * Используется как fallback когда [QR:] маркера нет.
   */
  function detectHeuristicQr(text: string): string[] {
    const lower = text.toLowerCase();
    // Площадка (WB / OZON / обе)
    if (/wb или ozon|wildberries или ozon|wb,?\s*ozon|какая площад|на каком маркетпле|где вы (сейчас )?(работаете|продаёте)/i.test(lower)) {
      return ['Wildberries', 'OZON', 'И там, и там'];
    }
    // Стадия карточки
    if (/карточка новая|новая карточка|есть продажи|какая стадия|какой этап карточки|карточка только/i.test(lower)) {
      return ['Новая карточка', 'Есть продажи'];
    }
    // Срочность
    if (/насколько срочно|как срочн|сроки горят|сроки поджимают|когда нужен резул/i.test(lower)) {
      return ['Срочно', 'В течение месяца', 'Не срочно'];
    }
    return [];
  }

  function renderMarkdown(text: string): string {
    // Срезаем оба технических маркера — они не должны попасть в видимый текст
    const cleanText = text
      .replace(CONTACT_MARKER_RE, ' ')
      .replace(QR_MARKER_RE, ' ')
      .trim();
    const html = marked.parse(cleanText, { async: false }) as string;
    const clean = DOMPurify.sanitize(html, {
      ALLOWED_TAGS,
      ALLOWED_ATTR: ['href', 'target', 'rel'],
    });
    return clean.replace(/<a\s+/g, '<a target="_blank" rel="noopener noreferrer" ');
  }

  const IDLE_PROMPT_MS = 30000;
  const IDLE_PROMPT_TEXT = 'Ещё что-то уточнить? Или передаю ваш контакт менеджеру?';

  const STORAGE_SID       = 'ubuyer_chat_sid_v3';
  const STORAGE_HIST      = 'ubuyer_chat_hist_v3';
  const STORAGE_SUBMITTED = 'ubuyer_chat_submitted_v3';
  const STORAGE_WELCOMED  = 'ubuyer_chat_welcomed_v3';
  const STORAGE_STATE     = 'ubuyer_chat_state_v3'; // closed | minimized (open не сохраняется — каждый заход = closed)
  const STORAGE_NUDGE     = 'ubuyer_chat_nudge_v1'; // '1' если nudge уже показан в этой сессии

  // Контакт-nudge: статический текст + 2 быстрые кнопки. Показывается ОДИН раз
  // через 40 сек после показа CONTACT_REQUEST если клиент так и не нажал
  // кнопку выбора (Telegram/Phone) и ничего не ввёл. Цель — снять давление,
  // дать выход через готовый вопрос либо подтверждение готовности.
  const NUDGE_DELAY_MS = 40_000;
  const NUDGE_TEXT = `Может остались вопросы? Спрашивайте прямо здесь — про безопасность для алгоритма WB, экономику под ваш бюджет, кейсы по вашей нише.

Мы 3 года поднимаем в топ сотни карточек в разных нишах: рост органического трафика, снижение ДРР, за всё время — 0 пессимизаций и 0 блокировок у клиентов.

Менеджер разберёт ваш товар в переписке и пришлёт расчёт под вашу нишу — с цифрами и примерами из практики.`;
  const NUDGE_BUDGET_QUERY = 'Какой бюджет нужен под мою задачу?';

  const WELCOME_LINE_1 = 'Выведем вашу карточку в топ WB и OZON';
  const WELCOME_LINE_2 = 'UBuyer — живые самовыкупы: рост позиций → органика → продажи без рекламы.';
  const STATUS_DEFAULT = 'Менеджер UBuyer';

  const sleep = (ms: number) => new Promise(r => setTimeout(r, ms));

  const widget = document.getElementById('chat-widget') as HTMLDivElement | null;
  if (widget) {
    const endpoint = widget.dataset.endpoint ?? '';
    const toggleBtn   = document.getElementById('chat-toggle')        as HTMLButtonElement;
    const closeBtn    = document.getElementById('chat-close')         as HTMLButtonElement;
    const minimizeBtn = document.getElementById('chat-minimize')      as HTMLButtonElement;
    const resetBtn    = document.getElementById('chat-reset')         as HTMLButtonElement;
    const unreadBadge = document.getElementById('chat-unread-badge')  as HTMLSpanElement;
    const messagesEl  = document.getElementById('chat-messages')      as HTMLDivElement;
    const startersEl  = document.getElementById('chat-starters')      as HTMLDivElement;
    const typingEl    = document.getElementById('chat-typing')        as HTMLDivElement;
    const form        = document.getElementById('chat-form')          as HTMLFormElement;
    const input       = document.getElementById('chat-input')         as HTMLTextAreaElement;
    const sendBtn     = document.getElementById('chat-send')          as HTMLButtonElement;
    const inputWrap   = document.getElementById('chat-input-wrap')    as HTMLDivElement;
    const welcomeP1   = document.getElementById('welcome-line-1')     as HTMLParagraphElement;
    const welcomeP2   = document.getElementById('welcome-line-2')     as HTMLParagraphElement;
    const statusLine  = document.getElementById('chat-status-line')   as HTMLDivElement;
    const pillPhrase  = toggleBtn.querySelector('.chat-pill-phrase')  as HTMLSpanElement;

    // ──── Session / history ────
    function sid(): string {
      let v = localStorage.getItem(STORAGE_SID);
      if (!v) {
        v = (crypto && 'randomUUID' in crypto) ? crypto.randomUUID() : `s_${Date.now()}_${Math.random().toString(36).slice(2)}`;
        localStorage.setItem(STORAGE_SID, v);
      }
      return v;
    }
    function loadHistory(): ChatMessage[] {
      try { const raw = localStorage.getItem(STORAGE_HIST); const p = raw ? JSON.parse(raw) : []; return Array.isArray(p) ? p : []; }
      catch { return []; }
    }
    function saveHistory(h: ChatMessage[]): void {
      try { localStorage.setItem(STORAGE_HIST, JSON.stringify(h)); } catch {}
    }

    const sessionId = sid();
    const history: ChatMessage[] = loadHistory();
    let leadSubmitted = localStorage.getItem(STORAGE_SUBMITTED) === '1';
    let contactShownFired = false;
    let idleTimer: ReturnType<typeof setTimeout> | null = null;
    let unreadCount = 0;

    function setUnreadBadge(n: number): void {
      unreadCount = Math.max(0, n);
      if (!unreadBadge) return;
      unreadBadge.dataset.count = String(unreadCount);
      unreadBadge.textContent = unreadCount > 9 ? '9+' : String(unreadCount);
    }
    function incrementUnread(): void { setUnreadBadge(unreadCount + 1); }
    function clearUnread(): void { setUnreadBadge(0); }

    function clearIdle(): void {
      if (idleTimer) { clearTimeout(idleTimer); idleTimer = null; }
    }
    function scheduleIdlePrompt(): void {
      clearIdle();
      if (leadSubmitted) return;
      // Не лезем с подсказкой, когда клиент уже видит блок выбора контакта
      if (messagesEl.querySelector('.chat-contact-request')) return;
      idleTimer = setTimeout(() => {
        if (messagesEl.querySelector('.chat-idle-prompt')) return;
        // Повторная проверка — на случай если за 30 сек контакт-блок появился
        if (messagesEl.querySelector('.chat-contact-request') || leadSubmitted) return;
        const block = document.createElement('div');
        block.className = 'chat-idle-prompt';
        block.textContent = IDLE_PROMPT_TEXT;
        messagesEl.appendChild(block);
        scrollToBottom();
      }, IDLE_PROMPT_MS);
    }

    function renderQrButtons(options: string[]): void {
      // Удаляем предыдущие QR-кнопки (если были) — Fix F: с fade-out
      fadeOutRemove(messagesEl.querySelector('.chat-qr-row'));
      fadeOutRemove(messagesEl.querySelector('.chat-idle-prompt'));
      clearIdle();

      const row = document.createElement('div');
      row.className = 'chat-qr-row';
      options.forEach(opt => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'chat-qr-btn';
        btn.textContent = opt;
        btn.addEventListener('click', async () => {
          // Убираем кнопки на время запроса (чтобы не тыкнуть дважды).
          fadeOutRemove(row);
          const ok = await send(opt);
          // Сеть упала / ответ не пришёл — возвращаем кнопки, чтобы клиент
          // мог выбрать повторно, а не остался в тупике без кнопок и без ответа.
          if (!ok) renderQrButtons(options);
        });
        row.appendChild(btn);
      });
      messagesEl.appendChild(row);
      scrollToBottom();
    }

    function renderContactRequest(): void {
      // Отменяем idle — клиенту дают выбор, не отвлекать подсказкой
      clearIdle();
      // Замер воронки: Анастасия предложила оставить контакт (показала кнопки).
      // Один раз за сессию — функция может вызываться повторно.
      if (!contactShownFired) {
        contactShownFired = true;
        (window as any).ymGoal?.('chat_contact_shown');
      }
      // Fix F: мягкое удаление прежних блоков вместо мгновенного prune
      fadeOutRemove(messagesEl.querySelector('.chat-idle-prompt'));
      fadeOutRemove(messagesEl.querySelector('.chat-qr-row'));
      // Не дублируем — если блок уже есть, удаляем старый
      fadeOutRemove(messagesEl.querySelector('.chat-contact-request'));

      const block = document.createElement('div');
      block.className = 'chat-contact-request';
      block.innerHTML = `
        <div class="contact-trust-title">МЕНЕДЖЕР НАПИШЕТ ПЕРВЫМ — С ВАШИМ КОНТЕКСТОМ</div>
        <div class="contact-trust-list">
          <div class="contact-trust-item"><span class="check"><svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2"><path d="M2.5 6.5l2 2 5-5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Расчёт под ваш товар</div>
          <div class="contact-trust-item"><span class="check"><svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2"><path d="M2.5 6.5l2 2 5-5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Стратегию по ключам</div>
          <div class="contact-trust-item"><span class="check"><svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2"><path d="M2.5 6.5l2 2 5-5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Пример кейса в вашей нише</div>
        </div>
        <div class="contact-quick-replies">
          <button data-qr="telegram" class="qr-recommended"><span class="qr-icon"><svg viewBox="0 0 16 16" fill="currentColor"><path d="M14 2L1.5 7l4 1.5L12 4 7 9l-.5 4 3-3 4 2.5z"/></svg></span>Telegram-ник</button>
          <button data-qr="phone" class="qr-recommended"><span class="qr-icon"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 4c0-1 1-2 2-2h1l2 3-1.5 1.5c1 2 2 3 4 4L12 9l3 2v1c0 1-1 2-2 2C8 14 2 8 2 4z"/></svg></span>Телефон</button>
        </div>
        <div class="contact-field-panel" hidden>
          <input class="contact-field-input" type="text" autocomplete="off" spellcheck="false" aria-label="Контакт" />
          <div class="contact-field-hint"></div>
          <button type="button" class="contact-field-submit" disabled>Получить расчёт →</button>
        </div>
        <div class="contact-privacy-note">
          <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 1L2 3v3.5c0 2 1.5 4 4 4.5 2.5-.5 4-2.5 4-4.5V3L6 1z" stroke-linejoin="round"/></svg>
          Не передаём третьим, спам не шлём
        </div>`;

      // Кнопки-табы канала. По клику раскрывается поле ПРЯМО В БЛОКЕ (не внизу,
      // не окно) + своя кнопка отправки. Контакт уходит через общий send() —
      // так markLeadSubmitted и аналитика работают ровно как раньше.
      const qrBtns    = block.querySelectorAll<HTMLButtonElement>('[data-qr]');
      const fieldPanel  = block.querySelector('.contact-field-panel')  as HTMLDivElement;
      const fieldInput  = block.querySelector('.contact-field-input')  as HTMLInputElement;
      const fieldHint   = block.querySelector('.contact-field-hint')   as HTMLDivElement;
      const fieldSubmit = block.querySelector('.contact-field-submit') as HTMLButtonElement;
      let channel: 'telegram' | 'phone' | null = null;

      function validateField(): boolean {
        const v = fieldInput.value.trim();
        let valid = false, hint = '', state = 'pending';
        if (channel === 'telegram') {
          valid = TG_USERNAME_RE.test(v);
          if (valid) { hint = '✓ Ник корректный'; state = 'ok'; }
          else if (v.length > 1 && v.length < 6) { hint = `Ещё ${6 - v.length} символ(а) — минимум 5`; }
          else if (v.length > 1) { hint = 'Только латиница, цифры и _'; state = 'error'; }
          else { hint = 'Где взять: Telegram → Настройки → Имя пользователя'; }
        } else if (channel === 'phone') {
          const digits = v.replace(/\D/g, '').replace(/^[78]/, '').slice(0, 10);
          valid = digits.length === 10;
          if (valid) { hint = '✓ Номер полный'; state = 'ok'; }
          else { const left = 10 - digits.length; hint = `Ещё ${left} ${left === 1 ? 'цифра' : left < 5 ? 'цифры' : 'цифр'} номера`; }
        }
        fieldHint.textContent = hint;
        fieldHint.dataset.state = state;
        fieldSubmit.disabled = !valid;
        return valid;
      }

      function setChannel(ch: 'telegram' | 'phone'): void {
        channel = ch;
        fieldPanel.hidden = false;
        if (ch === 'telegram') { fieldInput.value = '@'; fieldInput.placeholder = '@ваш_ник'; fieldInput.setAttribute('inputmode', 'text'); }
        else { fieldInput.value = '+7 '; fieldInput.placeholder = '+7 ___ ___ __ __'; fieldInput.setAttribute('inputmode', 'tel'); }
        // blur→focus форсит правильную клавиатуру на iOS/Android
        fieldInput.blur(); fieldInput.focus();
        const len = fieldInput.value.length; fieldInput.setSelectionRange(len, len);
        validateField();
        scrollToBottom();
      }

      function submitField(): void {
        if (!channel || !validateField()) return;
        const v = fieldInput.value.trim();
        // Прогоняем через общий send(): выставляем режим, чтобы send зафиксировал
        // лид (wasContactMode) + отправил аналитику + отдал контакт на бэкенд.
        input.dataset.inputMode = channel;
        void send(v);
      }

      qrBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const action = btn.dataset.qr as 'telegram' | 'phone';
          qrBtns.forEach(b => b.classList.remove('qr-active'));
          btn.classList.add('qr-active');
          setChannel(action);
          (window as any).ymGoal?.(action === 'telegram' ? 'chat_picked_telegram' : 'chat_picked_phone');
        });
      });

      fieldInput.addEventListener('input', () => {
        if (channel === 'telegram') {
          let v = fieldInput.value.replace(/[^@a-zA-Z0-9_]/g, '');
          if (!v.startsWith('@')) v = '@' + v.replace(/^@+/, '');
          if (v.length > 33) v = v.slice(0, 33);
          fieldInput.value = v;
        } else if (channel === 'phone') {
          fieldInput.value = formatPhoneMask(fieldInput.value);
        }
        validateField();
      });
      fieldInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') { e.preventDefault(); submitField(); }
      });
      fieldSubmit.addEventListener('click', submitField);

      messagesEl.appendChild(block);
      scrollToBottom();

      // Стартуем nudge-таймер: если за 40 сек клиент не выбрал способ контакта
      // и ничего не ввёл — Анастасия пришлёт мягкое доп-сообщение с 2
      // кнопками (бюджет / получить расчёт).
      scheduleContactNudge();
    }

    let nudgeTimer: ReturnType<typeof setTimeout> | null = null;

    function clearNudgeTimer(): void {
      if (nudgeTimer) { clearTimeout(nudgeTimer); nudgeTimer = null; }
    }

    function scheduleContactNudge(): void {
      clearNudgeTimer();
      // Уже показывали в этой сессии — не дублируем (психологически: один nudge ОК, два — спам)
      if (localStorage.getItem(STORAGE_NUDGE) === '1') return;
      // Если контакт уже получен — nudge не нужен
      if (leadSubmitted) return;

      nudgeTimer = setTimeout(() => {
        nudgeTimer = null;
        // Перед показом ещё раз проверяем актуальные условия — за 40 сек
        // могло поменяться: клиент кликнул кнопку, начал печатать, оставил
        // контакт, или окно вообще закрыто.
        if (localStorage.getItem(STORAGE_NUDGE) === '1') return;
        if (leadSubmitted) return;
        // Форма CONTACT_REQUEST уже исчезла — клиент пошёл дальше
        if (!messagesEl.querySelector('.chat-contact-request')) return;
        // Клиент начал что-то печатать — не лезем
        if (input.value.trim().length > 0) return;
        // Клиент уже выбрал режим (TG/Phone активна) — не лезем, форма
        // ждёт ввод
        if (messagesEl.querySelector('.chat-contact-request .qr-active')) return;

        renderContactNudge();
      }, NUDGE_DELAY_MS);
    }

    function renderContactNudge(): void {
      const row = document.createElement('div');
      row.className = 'chat-msg chat-msg-assistant chat-nudge-row';

      const bubble = document.createElement('div');
      bubble.className = 'chat-bubble chat-bubble-assistant';
      bubble.innerHTML = renderMarkdown(NUDGE_TEXT);

      const actions = document.createElement('div');
      actions.className = 'chat-nudge-actions';
      actions.innerHTML = `
        <button data-nudge="budget" class="nudge-btn">💰 Какой бюджет нужен?</button>
        <button data-nudge="ready" class="nudge-btn nudge-btn-primary">✅ Получить расчёт</button>`;

      actions.querySelectorAll<HTMLButtonElement>('[data-nudge]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const action = btn.dataset.nudge;
          // Кнопки одноразовые — после клика удаляем actions, текст nudge остаётся
          fadeOutRemove(actions);
          if (action === 'budget') {
            (window as any).ymGoal?.('chat_nudge_click_budget');
            void send(NUDGE_BUDGET_QUERY);
          } else if (action === 'ready') {
            (window as any).ymGoal?.('chat_nudge_click_ready');
            const contactReq = messagesEl.querySelector<HTMLElement>('.chat-contact-request');
            if (contactReq) {
              contactReq.classList.add('chat-contact-request-highlighted');
              contactReq.scrollIntoView({ behavior: 'smooth', block: 'center' });
              setTimeout(() => contactReq.classList.remove('chat-contact-request-highlighted'), 1800);
              input.focus();
            }
          }
        });
      });

      bubble.appendChild(actions);
      row.appendChild(bubble);
      messagesEl.appendChild(row);
      scrollToBottom();
      localStorage.setItem(STORAGE_NUDGE, '1');
      (window as any).ymGoal?.('chat_nudge_shown');
    }

    // ──── PILL: динамическая ротация фраз ────
    function startPillRotation(): void {
      let phrases: string[] = [];
      try { phrases = JSON.parse(toggleBtn.dataset.phrases ?? '[]'); }
      catch { phrases = []; }
      if (phrases.length < 2) return;

      let idx = 0;
      let paused = false;
      toggleBtn.addEventListener('mouseenter', () => { paused = true; });
      toggleBtn.addEventListener('mouseleave', () => { paused = false; });

      setInterval(() => {
        if (paused || widget!.dataset.state === 'open') return;
        idx = (idx + 1) % phrases.length;
        pillPhrase.classList.add('is-fading');
        setTimeout(() => {
          pillPhrase.textContent = phrases[idx];
          pillPhrase.classList.remove('is-fading');
          pillPhrase.classList.add('is-entering');
          requestAnimationFrame(() => { pillPhrase.classList.remove('is-entering'); });
        }, 200);
      }, 3500);
    }

    // ──── PILL: меняем текст на «Контакт передан» когда лид
    function setPillSubmitted(): void {
      pillPhrase.previousElementSibling?.remove();
      const pillTextWrap = toggleBtn.querySelector('.chat-pill-text') as HTMLSpanElement;
      pillTextWrap.innerHTML = `
        <span class="text-brand-text font-semibold text-sm tracking-tight">Менеджер свяжется</span>
        <span class="text-brand-cta text-[11px] flex items-center gap-1">✓ Контакт передан</span>`;
    }

    // ──── Единая ИДЕМПОТЕНТНАЯ фиксация лида ────
    // Цель chat_lead_submitted срабатывает ровно один раз, по ЛЮБОМУ пути:
    // кнопка телефон/телеграм, контакт текстом в чате, или флаг от бэкенда.
    function markLeadSubmitted(): void {
      if (leadSubmitted) return;
      leadSubmitted = true;
      localStorage.setItem(STORAGE_SUBMITTED, '1');
      widget!.dataset.status = 'submitted';
      setPillSubmitted();
      (window as any).ymGoal?.('chat_lead_submitted');
    }

    // Детект контакта в СВОБОДНОМ тексте (когда пишут ник/телефон сами, без
    // кнопки). Строго — чтобы не путать с артикулами WB (8–10 голых цифр).
    // Телефон: РФ-мобильный, префикс +7/8/7 и код 9xx, разделители любые.
    const FREE_PHONE_RE = /(?:\+7|\b8|\b7)[\s\-(]*9\d{2}[\s\-)]*\d{3}[\s\-]*\d{2}[\s\-]*\d{2}/;
    // Telegram: @ник 5–32 симв. (в начале/после разделителя) либо ссылка t.me/…
    const FREE_TG_RE = /(?:^|[\s,;:.(])@[a-zA-Z][a-zA-Z0-9_]{4,31}\b|t\.me\/[a-zA-Z0-9_]{4,}/i;
    function looksLikeContact(text: string): boolean {
      return FREE_PHONE_RE.test(text) || FREE_TG_RE.test(text);
    }

