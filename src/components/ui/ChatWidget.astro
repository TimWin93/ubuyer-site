---
// Endpoint через Yandex Cloud Function. yandexcloud.net не блокируется в РФ —
// мобильные сети, операторы и DPI стабильно пропускают. Cloudflare Worker
// (ai.u-buyer.ru) и Cloud Run напрямую — режется частью провайдеров,
// особенно на мобильных устройствах с iOS WebKit (fetch failed: Load failed).
const CHAT_ENDPOINT = import.meta.env.PUBLIC_CHAT_ENDPOINT
  ?? 'https://functions.yandexcloud.net/d4ee9o608pangl2m3fii';

const STARTERS = [
  {
    label: 'Сколько стоит и что входит',
    text: 'Сколько стоит ваша услуга и что входит в цену?',
    iconPath: 'M12 8c-2.5 0-4 1-4 2.5s1.5 2.5 4 2.5 4 1 4 2.5-1.5 2.5-4 2.5m0-10v10m0 0v2m0-12V4',
  },
  {
    label: 'Расскажите про стратегию',
    text: 'Расскажите подробнее про вашу стратегию роста карточки.',
    iconPath: 'M3 17l6-6 4 4 8-8M14 7h7v7',
  },
  {
    label: 'Расскажите о себе, как работаете',
    text: 'Расскажите о себе — кто вы и как работаете?',
    iconPath: 'M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zm13 10v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75',
  },
];

const PILL_PHRASES = [
  'Расчёт под вашу нишу',
  'Подскажу стратегию',
  'Помогу с задачей',
];
---

<div id="chat-widget" data-endpoint={CHAT_ENDPOINT} data-state="closed" data-status="ready">

  <!-- ──────────────── PILL ──────────────── -->
  <button
    id="chat-toggle"
    type="button"
    aria-label="Открыть консультацию"
    data-phrases={JSON.stringify(PILL_PHRASES)}
    class="chat-pill fixed bottom-6 right-6 z-[60] group
           flex items-center gap-3 pl-1.5 pr-5 py-1.5
           bg-brand-surface/95 backdrop-blur-md
           border border-brand-border-2 rounded-full
           shadow-[0_8px_32px_rgba(0,0,0,0.45),0_0_0_1px_rgba(61,142,248,0.15),inset_0_1px_0_rgba(255,255,255,0.04)]
           hover:shadow-[0_12px_40px_rgba(0,0,0,0.55),0_0_0_1px_rgba(61,142,248,0.4),inset_0_1px_0_rgba(255,255,255,0.08)]
           hover:border-brand-accent/50
           active:scale-[0.98]
           transition-all duration-300 ease-out
           will-change-transform"
  >
    <!-- Аватар (фото) -->
    <span class="relative w-11 h-11 rounded-full flex-shrink-0 overflow-hidden
                 ring-1 ring-brand-accent/40
                 shadow-[0_0_20px_rgba(61,142,248,0.45)]">
      <img src="/images/anastasiya.jpg" alt="Анастасия, менеджер UBuyer"
           class="w-full h-full object-cover" loading="lazy" decoding="async" />
      <span class="absolute -bottom-0.5 -right-0.5 w-3 h-3 rounded-full bg-brand-cta
                   ring-2 ring-brand-surface
                   shadow-[0_0_8px_rgba(16,185,129,0.6)]"></span>
    </span>

    <!-- Текст с ротацией -->
    <span class="chat-pill-text flex flex-col items-start leading-tight">
      <span class="text-brand-text font-semibold text-sm tracking-tight">Анастасия</span>
      <span class="chat-pill-rotation text-brand-muted text-[11px] flex items-center gap-1 min-h-[14px]">
        <span class="chat-pill-phrase">Расчёт под вашу нишу</span>
        <svg class="w-2.5 h-2.5 -mr-0.5 group-hover:translate-x-0.5 transition-transform" viewBox="0 0 12 12" fill="none">
          <path d="M3 6h6m0 0L7 4m2 2L7 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
    </span>
  </button>

  <!-- ──────────────── WINDOW ──────────────── -->
  <div
    id="chat-window"
    class="chat-window fixed bottom-6 right-6 z-[60]
           w-[calc(100vw-3rem)] max-w-[400px] h-[640px] max-h-[calc(100vh-3rem)]
           flex flex-col overflow-hidden
           bg-brand-surface
           border border-brand-border-2 rounded-3xl
           shadow-[0_32px_64px_-12px_rgba(0,0,0,0.7),0_0_0_1px_rgba(61,142,248,0.15),inset_0_1px_0_rgba(255,255,255,0.05)]"
    role="dialog"
    aria-label="Консультация с Анастасией"
  >
    <!-- Фоновое свечение -->
    <div class="absolute inset-x-0 top-0 h-32 bg-hero-radial pointer-events-none opacity-60"></div>

    <!-- ─── Header ─── -->
    <header class="relative flex items-center gap-3 px-5 pt-5 pb-4 border-b border-brand-border">
      <div class="relative w-12 h-12 rounded-full flex-shrink-0 overflow-hidden
                  ring-1 ring-brand-accent/50
                  shadow-[0_0_24px_rgba(61,142,248,0.5)]">
        <img src="/images/anastasiya.jpg" alt="Анастасия, менеджер UBuyer"
             class="w-full h-full object-cover" loading="lazy" decoding="async" />
        <span id="chat-status-orb"
              class="absolute -bottom-0.5 -right-0.5 w-3.5 h-3.5 rounded-full bg-brand-cta
                     ring-[3px] ring-brand-surface
                     shadow-[0_0_10px_rgba(16,185,129,0.7)]"></span>
      </div>

      <div class="flex-1 min-w-0">
        <div class="text-brand-text font-semibold text-[15px] tracking-tight leading-tight">Анастасия</div>
        <div id="chat-status-line"
             class="text-brand-muted text-xs mt-0.5 leading-tight flex items-center gap-1.5">
          <span class="chat-status-text">Менеджер UBuyer</span>
        </div>
      </div>

      <button
        id="chat-reset"
        type="button"
        aria-label="Начать заново"
        title="Начать заново"
        class="chat-reset-btn text-brand-muted hover:text-brand-text active:scale-90
               w-8 h-8 rounded-full flex items-center justify-center
               hover:bg-brand-surface-2 transition-all"
      >
        <svg class="w-4 h-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7">
          <path stroke-linecap="round" stroke-linejoin="round"
                d="M2 8a6 6 0 0 1 10.5-4M14 3v3.5h-3.5M14 8a6 6 0 0 1-10.5 4M2 13v-3.5h3.5"/>
        </svg>
      </button>

      <button
        id="chat-close"
        type="button"
        aria-label="Закрыть"
        title="Закрыть"
        class="chat-close-btn text-brand-text hover:text-white active:scale-90
               w-9 h-9 rounded-full flex items-center justify-center flex-shrink-0
               bg-brand-surface-2 hover:bg-brand-border
               border border-brand-border hover:border-brand-accent/60
               transition-all"
      >
        <svg class="w-4 h-4" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 3l8 8M11 3l-8 8"/>
        </svg>
      </button>
    </header>

    <!-- ─── Messages ─── -->
    <div
      id="chat-messages"
      class="relative flex-1 overflow-y-auto overflow-x-hidden px-4 py-5 space-y-3.5 text-[14px] leading-relaxed"
    >
      <!-- Welcome hero-card (текст вставится через typed-эффект скриптом) -->
      <div class="chat-welcome chat-msg-welcome">
        <div class="chat-welcome-card">
          <span class="welcome-accent" aria-hidden="true"></span>
          <h3 id="welcome-line-1" class="welcome-title"></h3>
          <p id="welcome-line-2" class="welcome-text"></p>
          <div class="welcome-hint" aria-hidden="true">
            <svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.7">
              <path d="M7 2v10m0 0L3 8m4 4l4-4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Что вас интересует? Опишите или выберите ниже
          </div>
        </div>
      </div>

      <!-- Стартеры -->
      <div id="chat-starters" class="chat-starters flex flex-col gap-2 pt-1 pb-2">
        {STARTERS.map((starter, i) => (
          <button
            type="button"
            class="chat-starter group/chip relative text-left w-full
                   flex items-center gap-3
                   bg-brand-surface-2 hover:bg-gradient-to-br hover:from-brand-surface-2 hover:to-brand-surface
                   border border-brand-border hover:border-brand-accent/60
                   rounded-2xl pl-3 pr-4 py-3
                   shadow-[inset_0_1px_0_rgba(255,255,255,0.03)]
                   hover:shadow-[0_8px_24px_-8px_rgba(61,142,248,0.35),0_0_0_1px_rgba(61,142,248,0.25),inset_0_1px_0_rgba(255,255,255,0.06)]
                   hover:-translate-y-0.5
                   active:translate-y-0 active:scale-[0.99]
                   transition-all duration-200 ease-out"
            data-starter={starter.text}
            style={`--chip-delay: ${i * 90}ms`}
          >
            <!-- Иконка -->
            <span class="chip-icon w-9 h-9 rounded-xl flex items-center justify-center flex-shrink-0
                         bg-brand-accent-dim text-brand-accent
                         group-hover/chip:bg-brand-accent group-hover/chip:text-white
                         group-hover/chip:shadow-[0_0_16px_rgba(61,142,248,0.5),inset_0_1px_0_rgba(255,255,255,0.2)]
                         transition-all duration-200">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d={starter.iconPath}/>
              </svg>
            </span>

            <span class="flex-1 text-brand-text/90 group-hover/chip:text-brand-text
                         text-[13.5px] font-medium leading-tight">
              {starter.label}
            </span>

            <svg class="w-3.5 h-3.5 text-brand-muted group-hover/chip:text-brand-accent
                        group-hover/chip:translate-x-0.5 transition-all flex-shrink-0"
                 viewBox="0 0 14 14" fill="none">
              <path d="M3 7h8m0 0L8 4m3 3L8 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        ))}
      </div>
    </div>

    <!-- ─── Typing indicator ─── -->
    <div id="chat-typing" class="chat-typing px-4 pb-1 hidden">
      <div class="chat-bubble chat-bubble-assistant inline-flex max-w-fit">
        <span class="typing-skeleton"><span></span><span></span><span></span></span>
      </div>
    </div>

    <!-- ─── Success card ─── -->
    <div id="chat-success" class="chat-success px-4 pb-3 hidden">
      <div class="relative rounded-2xl px-4 py-4 overflow-hidden
                  bg-gradient-to-br from-brand-cta/15 to-brand-cta/5
                  border border-brand-cta/40
                  shadow-[0_0_32px_rgba(16,185,129,0.18),inset_0_1px_0_rgba(255,255,255,0.06)]">
        <div class="flex items-start gap-3">
          <div class="w-10 h-10 rounded-full flex-shrink-0 flex items-center justify-center
                      bg-brand-cta text-white
                      shadow-[0_0_16px_rgba(16,185,129,0.5),inset_0_1px_0_rgba(255,255,255,0.3)]">
            <svg class="w-5 h-5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 10l4 4 8-8"/>
            </svg>
          </div>
          <div class="flex-1 min-w-0">
            <div class="text-brand-text font-semibold text-[15px] tracking-tight">Контакт у менеджера</div>
            <div class="text-brand-text/75 text-[13px] mt-1 leading-snug">Напишет вам первым в течение ~15 минут.</div>
          </div>
        </div>
      </div>
    </div>

    <!-- ─── Input zone ─── -->
    <form id="chat-form" class="chat-input-zone relative px-4 pb-2 pt-3 border-t border-brand-border bg-brand-surface">
      <div id="chat-input-wrap" class="chat-input-wrap relative flex items-end gap-2
                                       bg-brand-surface-2 border border-brand-border
                                       rounded-2xl px-3 py-2.5
                                       transition-all duration-200">
        <textarea
          id="chat-input"
          rows="1"
          placeholder="Опишите ситуацию или задайте вопрос…"
          class="chat-input flex-1 bg-transparent border-0
                 text-brand-text placeholder:text-brand-muted text-[14px]
                 focus:outline-none resize-none max-h-32
                 leading-relaxed"
        ></textarea>
        <button
          type="submit"
          id="chat-send"
          aria-label="Отправить"
          disabled
          class="chat-send w-9 h-9 rounded-xl flex items-center justify-center flex-shrink-0
                 bg-brand-accent-dim text-brand-muted
                 disabled:cursor-not-allowed
                 transition-all duration-200"
        >
          <svg class="w-4 h-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 13V3M3 8l5-5 5 5"/>
          </svg>
        </button>
      </div>

      <!-- ─── Trust-bar ─── -->
      <div class="trust-bar flex items-center justify-center gap-4 mt-2.5 px-1">
        <span class="trust-item">
          <svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M7 1 1.5 3v4.5c0 3 2.5 5 5.5 5.5 3-.5 5.5-2.5 5.5-5.5V3L7 1z" stroke-linejoin="round"/>
            <path d="M5 7l1.5 1.5L9 6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Договор
        </span>
        <span class="trust-dot"></span>
        <span class="trust-item">
          <svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M7 1v6l4 2" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="7" cy="7" r="6"/>
          </svg>
          Ответ за 15 мин
        </span>
        <span class="trust-dot"></span>
        <span class="trust-item">
          <svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M3 5l3 3 5-5" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M12 7v3a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h6" stroke-linecap="round"/>
          </svg>
          0 блокировок
        </span>
      </div>
    </form>
  </div>
</div>

<style is:global>
  /* ============== STATE MACHINE ============== */
  #chat-widget[data-state="closed"] #chat-window {
    opacity: 0;
    transform: translateY(16px) scale(0.96);
    pointer-events: none;
    transition: opacity 220ms cubic-bezier(0.16, 1, 0.3, 1),
                transform 280ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  #chat-widget[data-state="open"] #chat-window {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
    transition: opacity 240ms cubic-bezier(0.16, 1, 0.3, 1),
                transform 320ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  #chat-widget[data-state="open"] #chat-toggle {
    opacity: 0;
    transform: scale(0.85);
    pointer-events: none;
    transition: opacity 200ms ease-out, transform 240ms ease-out;
  }
  #chat-widget[data-state="closed"] #chat-toggle {
    opacity: 1;
    transform: scale(1);
    transition: opacity 240ms 80ms ease-out, transform 320ms 80ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* После лида прячем только starters (они теряют смысл). Input оставляем
     открытым — клиент может задать дополнительный вопрос. */
  #chat-widget[data-status="submitted"] #chat-starters {
    display: none;
  }
  #chat-widget[data-status="submitted"] #chat-success {
    display: block;
    animation: successIn 380ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes successIn {
    from { opacity: 0; transform: translateY(8px) scale(0.98); }
    to   { opacity: 1; transform: translateY(0)   scale(1); }
  }

  /* ============== PILL: ambient pulse + phrase rotation ============== */
  @keyframes ambientPulse {
    0%, 100% { box-shadow: 0 8px 32px rgba(0,0,0,0.45),
                           0 0 0 1px rgba(61,142,248,0.15),
                           inset 0 1px 0 rgba(255,255,255,0.04),
                           0 0 0 0 rgba(61,142,248,0); }
    50%      { box-shadow: 0 8px 32px rgba(0,0,0,0.45),
                           0 0 0 1px rgba(61,142,248,0.28),
                           inset 0 1px 0 rgba(255,255,255,0.05),
                           0 0 0 8px rgba(61,142,248,0.05); }
  }
  .chat-pill {
    animation: ambientPulse 4.5s ease-in-out infinite;
  }
  .chat-pill:hover { animation-play-state: paused; }

  .chat-pill-phrase {
    display: inline-block;
    transition: opacity 200ms ease-out, transform 200ms ease-out;
  }
  .chat-pill-phrase.is-fading {
    opacity: 0;
    transform: translateY(-4px);
  }
  .chat-pill-phrase.is-entering {
    opacity: 0;
    transform: translateY(4px);
  }

  /* ============== HEADER: live typing indicator ============== */
  .chat-status-text {
    transition: opacity 180ms ease-out;
  }
  #chat-widget[data-status="typing"] #chat-status-line .chat-status-text {
    color: #4DD9FF;
  }
  #chat-widget[data-status="typing"] #chat-status-orb {
    background: #4DD9FF;
    box-shadow: 0 0 12px rgba(77,217,255,0.8);
    animation: orbPulse 1.2s ease-in-out infinite;
  }
  @keyframes orbPulse {
    0%, 100% { transform: scale(1);   opacity: 1;   }
    50%      { transform: scale(1.3); opacity: 0.7; }
  }
  .typing-cursor {
    display: inline-block;
    width: 2px;
    height: 11px;
    background: #4DD9FF;
    margin-left: 2px;
    vertical-align: text-bottom;
    animation: cursorBlink 0.9s steps(2) infinite;
  }
  @keyframes cursorBlink {
    0%, 50%  { opacity: 1; }
    51%,100% { opacity: 0; }
  }

  /* ============== MESSAGE BUBBLES ============== */
  .chat-msg { display: flex; animation: msgIn 320ms cubic-bezier(0.16, 1, 0.3, 1) backwards; }
  .chat-msg-assistant { justify-content: flex-start; }
  .chat-msg-user      { justify-content: flex-end; }

  @keyframes msgIn {
    from { opacity: 0; transform: translateY(8px) scale(0.97); }
    to   { opacity: 1; transform: translateY(0)   scale(1); }
  }

  .chat-bubble {
    max-width: 88%;
    padding: 12px 16px;
    font-size: 14px;
    line-height: 1.55;
    white-space: pre-wrap;
    word-wrap: break-word;
    border-radius: 18px;
  }
  .chat-bubble-assistant {
    background: #0C1530;
    color: #E4ECFF;
    border: 1px solid #1A2B4A;
    border-top-left-radius: 6px;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.04),
                0 2px 12px rgba(0,0,0,0.25);
    white-space: normal;  /* HTML сам обрабатывает пробелы */
  }
  /* ── Markdown в ответах Анастасии ── */
  .chat-bubble-assistant p {
    margin: 0 0 8px 0;
    line-height: 1.55;
  }
  .chat-bubble-assistant p:last-child { margin-bottom: 0; }
  .chat-bubble-assistant strong {
    color: #fff;
    font-weight: 600;
  }
  .chat-bubble-assistant em {
    font-style: italic;
    color: rgba(228,236,255,0.95);
  }
  .chat-bubble-assistant ul,
  .chat-bubble-assistant ol {
    margin: 6px 0;
    padding-left: 18px;
  }
  .chat-bubble-assistant li {
    margin: 3px 0;
    line-height: 1.5;
  }
  .chat-bubble-assistant li::marker {
    color: #3D8EF8;
  }
  .chat-bubble-assistant h1,
  .chat-bubble-assistant h2,
  .chat-bubble-assistant h3,
  .chat-bubble-assistant h4 {
    font-size: 14px;
    font-weight: 600;
    color: #fff;
    margin: 10px 0 4px;
    line-height: 1.3;
    letter-spacing: -0.005em;
  }
  .chat-bubble-assistant h1:first-child,
  .chat-bubble-assistant h2:first-child,
  .chat-bubble-assistant h3:first-child { margin-top: 0; }
  .chat-bubble-assistant code {
    background: rgba(61,142,248,0.15);
    color: #4DD9FF;
    padding: 1px 5px;
    border-radius: 4px;
    font-size: 12.5px;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
  }
  .chat-bubble-assistant pre {
    background: rgba(0,0,0,0.3);
    border: 1px solid rgba(26,43,74,0.6);
    border-radius: 10px;
    padding: 10px 12px;
    margin: 6px 0;
    overflow-x: auto;
    font-size: 12.5px;
  }
  .chat-bubble-assistant pre code {
    background: transparent;
    padding: 0;
    color: #E4ECFF;
  }
  .chat-bubble-assistant a {
    color: #4DD9FF;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
    transition: color 150ms ease;
  }
  .chat-bubble-assistant a:hover {
    color: #fff;
  }
  .chat-bubble-assistant blockquote {
    border-left: 2px solid rgba(61,142,248,0.4);
    padding-left: 10px;
    margin: 6px 0;
    color: rgba(228,236,255,0.7);
  }
  .chat-bubble-assistant s,
  .chat-bubble-assistant del {
    color: rgba(228,236,255,0.5);
  }
  .chat-bubble-user {
    background: linear-gradient(135deg, #3D8EF8 0%, #2B7AE8 100%);
    color: #fff;
    border-top-right-radius: 6px;
    box-shadow: 0 0 24px rgba(61,142,248,0.25),
                inset 0 1px 0 rgba(255,255,255,0.18),
                inset 0 -1px 0 rgba(0,0,0,0.1);
  }

  /* ============== WELCOME hero-card ============== */
  .chat-welcome {
    display: flex;
    animation: msgIn 380ms cubic-bezier(0.16, 1, 0.3, 1) backwards;
  }
  .chat-welcome-card {
    position: relative;
    width: 100%;
    padding: 20px 22px 16px 24px;
    background:
      radial-gradient(120% 80% at 100% 0%, rgba(61,142,248,0.10) 0%, transparent 55%),
      linear-gradient(135deg, rgba(12,21,48,0.7) 0%, rgba(8,15,36,0.95) 100%);
    border: 1px solid rgba(36,58,96,0.7);
    border-radius: 20px;
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,0.06),
      0 4px 20px rgba(0,0,0,0.35),
      0 0 0 1px rgba(61,142,248,0.08);
    overflow: hidden;
  }
  .welcome-accent {
    position: absolute;
    left: 0;
    top: 14px;
    bottom: 14px;
    width: 2px;
    border-radius: 0 2px 2px 0;
    background: linear-gradient(180deg,
      rgba(61,142,248,0.7) 0%,
      rgba(77,217,255,0.3) 100%);
    box-shadow: 0 0 12px rgba(61,142,248,0.35);
  }
  .welcome-title {
    color: #fff;
    font-weight: 600;
    font-size: 16px;
    letter-spacing: -0.01em;
    line-height: 1.3;
    margin: 0;
    min-height: 22px;
  }
  .welcome-text {
    color: rgba(228,236,255,0.78);
    font-size: 13.5px;
    line-height: 1.55;
    margin: 8px 0 0;
    min-height: 21px;
  }
  .welcome-hint {
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid rgba(26,43,74,0.6);
    font-size: 11.5px;
    color: rgba(61,142,248,0.78);
    display: flex;
    align-items: center;
    gap: 6px;
    font-weight: 500;
    letter-spacing: 0.01em;
  }
  .welcome-hint svg {
    width: 12px;
    height: 12px;
    flex-shrink: 0;
    animation: hintBob 2.4s ease-in-out infinite;
  }
  @keyframes hintBob {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(2px); }
  }

  /* ============== STARTER chip-ы — staggered entry ============== */
  .chat-starter {
    opacity: 0;
    transform: translateY(8px);
    animation: starterIn 420ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: var(--chip-delay, 0ms);
  }
  @keyframes starterIn {
    to { opacity: 1; transform: translateY(0); }
  }

  /* ============== INPUT FOCUS ============== */
  .chat-input-wrap:focus-within {
    border-color: rgba(61,142,248,0.6);
    box-shadow: 0 0 0 3px rgba(61,142,248,0.18),
                inset 0 1px 0 rgba(255,255,255,0.04);
  }
  .chat-input-wrap.chat-input-invalid {
    border-color: rgba(239,68,68,0.55);
    box-shadow: 0 0 0 3px rgba(239,68,68,0.12),
                inset 0 1px 0 rgba(255,255,255,0.04);
  }
  .chat-input-wrap.chat-input-invalid:focus-within {
    border-color: rgba(239,68,68,0.7);
    box-shadow: 0 0 0 3px rgba(239,68,68,0.20),
                inset 0 1px 0 rgba(255,255,255,0.04);
  }

  /* ============== Telegram-hint снизу инпута ============== */
  .chat-tg-hint {
    font-size: 11.5px;
    line-height: 1.4;
    margin: 6px 4px 0;
    padding: 0 2px;
    color: rgba(228,236,255,0.55);
    animation: msgIn 220ms ease-out;
  }
  .chat-tg-hint[data-state="ok"]      { color: #10B981; }
  .chat-tg-hint[data-state="error"]   { color: #F87171; }
  .chat-tg-hint[data-state="pending"] { color: rgba(228,236,255,0.55); }

  /* ============== SEND button states ============== */
  .chat-send:not(:disabled) {
    background: linear-gradient(135deg, #3D8EF8 0%, #2B7AE8 100%);
    color: #fff;
    box-shadow: 0 0 16px rgba(61,142,248,0.4),
                inset 0 1px 0 rgba(255,255,255,0.2);
  }
  .chat-send:not(:disabled):hover {
    transform: translateY(-1px);
    box-shadow: 0 0 24px rgba(61,142,248,0.55),
                inset 0 1px 0 rgba(255,255,255,0.25);
  }
  .chat-send:not(:disabled):active { transform: translateY(0) scale(0.94); }

  /* ============== TYPING SKELETON ============== */
  .typing-skeleton {
    display: inline-flex; align-items: center; gap: 5px; padding: 2px 0;
  }
  .typing-skeleton span {
    width: 6px; height: 6px; border-radius: 50%;
    background: rgba(228,236,255,0.5);
    animation: typingPulse 1.4s ease-in-out infinite;
  }
  .typing-skeleton span:nth-child(2) { animation-delay: 0.18s; }
  .typing-skeleton span:nth-child(3) { animation-delay: 0.36s; }
  @keyframes typingPulse {
    0%, 80%, 100% { transform: scale(0.7); opacity: 0.4; }
    40%           { transform: scale(1);   opacity: 1;   }
  }

  /* ============== CONTACT REQUEST block (trust + quick replies) ============== */
  .chat-contact-request {
    margin-top: 10px;
    padding: 14px;
    background: linear-gradient(135deg, rgba(12,21,48,0.6) 0%, rgba(8,15,36,0.9) 100%);
    border: 1px solid rgba(36,58,96,0.7);
    border-radius: 16px;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.04);
    animation: msgIn 320ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .contact-trust-title {
    font-size: 11px;
    color: rgba(228,236,255,0.55);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 600;
    margin-bottom: 8px;
  }
  .contact-trust-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 12px;
  }
  .contact-trust-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: #E4ECFF;
    line-height: 1.4;
  }
  .contact-trust-item .check {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    border-radius: 50%;
    background: rgba(16,185,129,0.18);
    color: #10B981;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .contact-trust-item .check svg { width: 10px; height: 10px; }

  .contact-quick-replies {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
    margin-bottom: 10px;
  }
  .contact-quick-replies button {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 9px 10px;
    background: rgba(61,142,248,0.10);
    border: 1px solid rgba(61,142,248,0.25);
    border-radius: 12px;
    color: #E4ECFF;
    font-size: 12.5px;
    font-weight: 500;
    text-align: left;
    cursor: pointer;
    transition: all 180ms ease;
  }
  .contact-quick-replies button:hover {
    background: rgba(61,142,248,0.20);
    border-color: rgba(61,142,248,0.50);
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(61,142,248,0.15);
  }
  .contact-quick-replies button:active { transform: translateY(0) scale(0.98); }
  .contact-quick-replies .qr-icon {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    border-radius: 7px;
    background: rgba(61,142,248,0.20);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #4DD9FF;
  }
  .contact-quick-replies .qr-icon svg { width: 12px; height: 12px; }
  .contact-quick-replies .qr-direct-tg {
    grid-column: 1 / -1;  /* на всю ширину */
    background: linear-gradient(135deg, rgba(61,142,248,0.20) 0%, rgba(77,217,255,0.10) 100%);
    border-color: rgba(77,217,255,0.40);
  }
  .contact-quick-replies .qr-direct-tg:hover {
    background: linear-gradient(135deg, rgba(61,142,248,0.30) 0%, rgba(77,217,255,0.20) 100%);
    box-shadow: 0 4px 16px rgba(77,217,255,0.25);
  }
  .contact-privacy-note {
    font-size: 10.5px;
    color: rgba(228,236,255,0.5);
    text-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    line-height: 1.3;
  }
  .contact-privacy-note svg {
    width: 10px; height: 10px;
    color: rgba(61,142,248,0.5);
  }

  /* ── QR Quick-reply buttons ── */
  .chat-qr-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 4px;
    animation: msgIn 280ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .chat-qr-btn {
    padding: 8px 14px;
    background: rgba(61,142,248,0.12);
    border: 1px solid rgba(61,142,248,0.35);
    border-radius: 999px;
    color: #E4ECFF;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: all 160ms ease;
    line-height: 1.2;
  }
  .chat-qr-btn:hover {
    background: rgba(61,142,248,0.22);
    border-color: rgba(61,142,248,0.6);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(61,142,248,0.18);
  }
  .chat-qr-btn:active { transform: translateY(0) scale(0.97); }

  /* Idle prompt — отдельный стиль (мягкая подсказка) */
  .chat-idle-prompt {
    margin-top: 8px;
    padding: 10px 14px;
    background: rgba(12,21,48,0.5);
    border: 1px dashed rgba(36,58,96,0.7);
    border-radius: 14px;
    font-size: 13px;
    color: rgba(228,236,255,0.75);
    font-style: italic;
    animation: msgIn 320ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* ============== TRUST BAR ============== */
  .trust-bar { user-select: none; }
  .trust-item {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 10.5px;
    color: rgba(228,236,255,0.55);
    letter-spacing: 0.01em;
    font-weight: 500;
  }
  .trust-item svg {
    width: 11px; height: 11px;
    color: rgba(61,142,248,0.65);
    flex-shrink: 0;
  }
  .trust-dot {
    width: 2px; height: 2px;
    border-radius: 50%;
    background: rgba(228,236,255,0.2);
  }

  /* ============== SCROLLBAR ============== */
  #chat-messages::-webkit-scrollbar { width: 6px; }
  #chat-messages::-webkit-scrollbar-track { background: transparent; }
  #chat-messages::-webkit-scrollbar-thumb { background: rgba(102,128,168,0.2); border-radius: 3px; }
  #chat-messages::-webkit-scrollbar-thumb:hover { background: rgba(102,128,168,0.4); }

  /* ============== MOBILE ============== */
  @media (max-width: 640px) {
    /* Pill — оставляем с текстом и ротацией, чуть компактнее */
    .chat-pill {
      padding: 5px 14px 5px 5px;
      bottom: 16px !important;
      right: 16px !important;
    }
    .chat-pill .chat-pill-text { display: flex; }
    .chat-pill-text > span:first-child { font-size: 13px; }
    .chat-pill-rotation { font-size: 10.5px; }

    /* Окно — fullscreen */
    #chat-widget #chat-window {
      inset: 0 !important;
      width: 100% !important;
      max-width: 100% !important;
      height: 100% !important;
      max-height: 100% !important;
      border-radius: 0 !important;
      border: none !important;
      bottom: 0 !important;
      right: 0 !important;
    }

    /* Кнопка закрытия — крупнее, контрастнее */
    .chat-close-btn {
      width: 40px !important;
      height: 40px !important;
    }
    .chat-close-btn svg {
      width: 18px;
      height: 18px;
    }
    #chat-reset {
      width: 36px;
      height: 36px;
    }

    /* Trust-bar чуть компактнее */
    .trust-bar { gap: 8px; }
    .trust-item { font-size: 10px; }

    /* Welcome-card отступы поменьше */
    .chat-welcome-card {
      padding: 18px 18px 14px 22px;
    }

    /* Поле ввода крупнее на мобиле — удобнее набирать */
    .chat-input {
      font-size: 16px;  /* предотвращает zoom на iOS при focus */
    }
  }

  /* ============== A11Y ============== */
  @media (prefers-reduced-motion: reduce) {
    .chat-pill, .chat-msg, .chat-starter,
    .chat-pill-phrase, #chat-status-orb {
      animation: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  import { marked } from 'marked';
  import DOMPurify from 'dompurify';

  type Role = 'user' | 'assistant';
  interface ChatMessage { role: Role; content: string }

  marked.setOptions({
    breaks: true,  // \n внутри абзаца → <br>
    gfm: true,     // GitHub-Flavored: автоссылки, таблицы, ~~зачёркнутый~~
  });

  const ALLOWED_TAGS = [
    'p', 'br', 'strong', 'em', 'ul', 'ol', 'li',
    'h1', 'h2', 'h3', 'h4', 'h5', 'h6',
    'blockquote', 'code', 'pre', 'a', 's', 'del',
  ];

  // Регулярка маркера CONTACT_REQUEST — case-insensitive, допускает пробелы и переносы
  const CONTACT_MARKER_RE = /\s*\[\s*CONTACT[_\s]?REQUEST\s*\]\s*/gi;
  // Регулярка маркера QR с вариантами: [QR: Вариант1 | Вариант2 | Вариант3]
  const QR_MARKER_RE = /\s*\[\s*QR\s*:\s*([^\]]+?)\s*\]\s*/gi;

  function parseQrOptions(text: string): string[] {
    const matches: string[] = [];
    let m: RegExpExecArray | null;
    const re = new RegExp(QR_MARKER_RE.source, QR_MARKER_RE.flags);
    while ((m = re.exec(text)) !== null) {
      const options = m[1].split('|').map(s => s.trim()).filter(s => s.length > 0);
      matches.push(...options);
    }
    return matches;
  }

  function renderMarkdown(text: string): string {
    // Срезаем оба технических маркера — они не должны попасть в видимый текст
    const cleanText = text
      .replace(CONTACT_MARKER_RE, ' ')
      .replace(QR_MARKER_RE, ' ')
      .trim();
    const html = marked.parse(cleanText, { async: false }) as string;
    const clean = DOMPurify.sanitize(html, {
      ALLOWED_TAGS,
      ALLOWED_ATTR: ['href', 'target', 'rel'],
    });
    return clean.replace(/<a\s+/g, '<a target="_blank" rel="noopener noreferrer" ');
  }

  const MANAGER_TG = 'Manager_UBuyer';
  const IDLE_PROMPT_MS = 30000;
  const IDLE_PROMPT_TEXT = 'Ещё что-то уточнить? Или передаю ваш контакт менеджеру?';

  /** Проверка доступности Telegram — image probe (≤3 сек). */
  function detectTelegram(): Promise<boolean> {
    return new Promise((resolve) => {
      const img = new Image();
      const timer = setTimeout(() => resolve(false), 3000);
      img.onload = () => { clearTimeout(timer); resolve(true); };
      img.onerror = () => { clearTimeout(timer); resolve(false); };
      img.src = `https://telegram.org/img/t_logo.png?_=${Date.now()}`;
    });
  }

  /** Собирает короткое саммари диалога для prefilled Telegram-ссылки. */
  function buildTelegramSummary(history: ChatMessage[]): string {
    const userMsgs = history.filter(m => m.role === 'user').slice(-3);
    const lines = ['Здравствуйте! Я с сайта u-buyer.ru, общался с Анастасией в чате.'];
    if (userMsgs.length > 0) {
      lines.push('', 'Кратко обсуждали:');
      userMsgs.forEach(m => {
        const s = m.content.length > 120 ? m.content.slice(0, 117) + '…' : m.content;
        lines.push(`— ${s}`);
      });
    }
    return lines.join('\n');
  }

  const STORAGE_SID       = 'ubuyer_chat_sid_v3';
  const STORAGE_HIST      = 'ubuyer_chat_hist_v3';
  const STORAGE_SUBMITTED = 'ubuyer_chat_submitted_v3';
  const STORAGE_WELCOMED  = 'ubuyer_chat_welcomed_v3';

  const WELCOME_LINE_1 = 'По какому вопросу помочь?';
  const WELCOME_LINE_2 = 'Подскажу по тарифам, кейсам и стратегии под вашу нишу.';
  const STATUS_DEFAULT = 'Менеджер UBuyer';

  const sleep = (ms: number) => new Promise(r => setTimeout(r, ms));

  const widget = document.getElementById('chat-widget') as HTMLDivElement | null;
  if (widget) {
    const endpoint = widget.dataset.endpoint ?? '';
    const toggleBtn   = document.getElementById('chat-toggle')        as HTMLButtonElement;
    const closeBtn    = document.getElementById('chat-close')         as HTMLButtonElement;
    const resetBtn    = document.getElementById('chat-reset')         as HTMLButtonElement;
    const messagesEl  = document.getElementById('chat-messages')      as HTMLDivElement;
    const startersEl  = document.getElementById('chat-starters')      as HTMLDivElement;
    const typingEl    = document.getElementById('chat-typing')        as HTMLDivElement;
    const form        = document.getElementById('chat-form')          as HTMLFormElement;
    const input       = document.getElementById('chat-input')         as HTMLTextAreaElement;
    const sendBtn     = document.getElementById('chat-send')          as HTMLButtonElement;
    const inputWrap   = document.getElementById('chat-input-wrap')    as HTMLDivElement;
    const welcomeP1   = document.getElementById('welcome-line-1')     as HTMLParagraphElement;
    const welcomeP2   = document.getElementById('welcome-line-2')     as HTMLParagraphElement;
    const statusLine  = document.getElementById('chat-status-line')   as HTMLDivElement;
    const pillPhrase  = toggleBtn.querySelector('.chat-pill-phrase')  as HTMLSpanElement;

    // ──── Session / history ────
    function sid(): string {
      let v = localStorage.getItem(STORAGE_SID);
      if (!v) {
        v = (crypto && 'randomUUID' in crypto) ? crypto.randomUUID() : `s_${Date.now()}_${Math.random().toString(36).slice(2)}`;
        localStorage.setItem(STORAGE_SID, v);
      }
      return v;
    }
    function loadHistory(): ChatMessage[] {
      try { const raw = localStorage.getItem(STORAGE_HIST); const p = raw ? JSON.parse(raw) : []; return Array.isArray(p) ? p : []; }
      catch { return []; }
    }
    function saveHistory(h: ChatMessage[]): void {
      try { localStorage.setItem(STORAGE_HIST, JSON.stringify(h)); } catch {}
    }

    const sessionId = sid();
    const history: ChatMessage[] = loadHistory();
    let leadSubmitted = localStorage.getItem(STORAGE_SUBMITTED) === '1';
    let telegramAvailable: boolean | null = null;
    let idleTimer: ReturnType<typeof setTimeout> | null = null;

    // Параллельно проверяем доступность Telegram
    void detectTelegram().then(ok => { telegramAvailable = ok; });

    function clearIdle(): void {
      if (idleTimer) { clearTimeout(idleTimer); idleTimer = null; }
    }
    function scheduleIdlePrompt(): void {
      clearIdle();
      if (leadSubmitted) return;
      // Не лезем с подсказкой, когда клиент уже видит блок выбора контакта
      if (messagesEl.querySelector('.chat-contact-request')) return;
      idleTimer = setTimeout(() => {
        if (messagesEl.querySelector('.chat-idle-prompt')) return;
        // Повторная проверка — на случай если за 30 сек контакт-блок появился
        if (messagesEl.querySelector('.chat-contact-request') || leadSubmitted) return;
        const block = document.createElement('div');
        block.className = 'chat-idle-prompt';
        block.textContent = IDLE_PROMPT_TEXT;
        messagesEl.appendChild(block);
        scrollToBottom();
      }, IDLE_PROMPT_MS);
    }

    function renderQrButtons(options: string[]): void {
      // Удаляем предыдущие QR-кнопки (если были)
      messagesEl.querySelector('.chat-qr-row')?.remove();
      messagesEl.querySelector('.chat-idle-prompt')?.remove();
      clearIdle();

      const row = document.createElement('div');
      row.className = 'chat-qr-row';
      options.forEach(opt => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'chat-qr-btn';
        btn.textContent = opt;
        btn.addEventListener('click', () => {
          row.remove();
          void send(opt);
        });
        row.appendChild(btn);
      });
      messagesEl.appendChild(row);
      scrollToBottom();
    }

    function renderContactRequest(): void {
      // Отменяем idle — клиенту дают выбор, не отвлекать подсказкой
      clearIdle();
      messagesEl.querySelector('.chat-idle-prompt')?.remove();
      messagesEl.querySelector('.chat-qr-row')?.remove();
      // Не дублируем — если блок уже есть, удаляем старый
      messagesEl.querySelector('.chat-contact-request')?.remove();

      const block = document.createElement('div');
      block.className = 'chat-contact-request';
      // Кнопка «Я в Telegram» — только если detect точно подтвердил доступность.
      // null (detect не успел / fail) или false → кнопку не показываем.
      const showDirectTg = telegramAvailable === true;
      block.innerHTML = `
        <div class="contact-trust-title">МЕНЕДЖЕР ПРИШЛЁТ</div>
        <div class="contact-trust-list">
          <div class="contact-trust-item"><span class="check"><svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2"><path d="M2.5 6.5l2 2 5-5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Расчёт под ваш товар</div>
          <div class="contact-trust-item"><span class="check"><svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2"><path d="M2.5 6.5l2 2 5-5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Стратегию по ключам</div>
          <div class="contact-trust-item"><span class="check"><svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2"><path d="M2.5 6.5l2 2 5-5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Пример кейса в вашей нише</div>
        </div>
        <div class="contact-quick-replies">
          <button data-qr="telegram"><span class="qr-icon"><svg viewBox="0 0 16 16" fill="currentColor"><path d="M14 2L1.5 7l4 1.5L12 4 7 9l-.5 4 3-3 4 2.5z"/></svg></span>Telegram-ник</button>
          <button data-qr="phone"><span class="qr-icon"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 4c0-1 1-2 2-2h1l2 3-1.5 1.5c1 2 2 3 4 4L12 9l3 2v1c0 1-1 2-2 2C8 14 2 8 2 4z"/></svg></span>Телефон</button>
          ${showDirectTg ? `<button data-qr="direct-tg" class="qr-direct-tg"><span class="qr-icon"><svg viewBox="0 0 16 16" fill="currentColor"><path d="M14 2L1.5 7l4 1.5L12 4 7 9l-.5 4 3-3 4 2.5z"/></svg></span>Я в Telegram — открыть чат с менеджером</button>` : ''}
        </div>
        <div class="contact-privacy-note">
          <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 1L2 3v3.5c0 2 1.5 4 4 4.5 2.5-.5 4-2.5 4-4.5V3L6 1z" stroke-linejoin="round"/></svg>
          Не передаём третьим, спам не шлём
        </div>`;

      block.querySelectorAll<HTMLButtonElement>('[data-qr]').forEach(btn => {
        btn.addEventListener('click', () => {
          const action = btn.dataset.qr;
          if (action === 'direct-tg') {
            const summary = buildTelegramSummary(history);
            const url = `https://t.me/${MANAGER_TG}?text=${encodeURIComponent(summary)}`;
            window.open(url, '_blank', 'noopener,noreferrer');
            (window as any).ymGoal?.('chat_open_direct_tg');
          } else if (action === 'telegram') {
            enableTelegramValidation(input);
            input.focus();
            // Каретку — в конец
            input.setSelectionRange(input.value.length, input.value.length);
            (window as any).ymGoal?.('chat_picked_telegram');
          } else if (action === 'phone') {
            enablePhoneMask(input);
            input.focus();
            input.setSelectionRange(input.value.length, input.value.length);
            (window as any).ymGoal?.('chat_picked_phone');
          }
          updateSendState();
        });
      });

      messagesEl.appendChild(block);
      scrollToBottom();
    }

    // ──── PILL: динамическая ротация фраз ────
    function startPillRotation(): void {
      let phrases: string[] = [];
      try { phrases = JSON.parse(toggleBtn.dataset.phrases ?? '[]'); }
      catch { phrases = []; }
      if (phrases.length < 2) return;

      let idx = 0;
      let paused = false;
      toggleBtn.addEventListener('mouseenter', () => { paused = true; });
      toggleBtn.addEventListener('mouseleave', () => { paused = false; });

      setInterval(() => {
        if (paused || widget!.dataset.state === 'open') return;
        idx = (idx + 1) % phrases.length;
        pillPhrase.classList.add('is-fading');
        setTimeout(() => {
          pillPhrase.textContent = phrases[idx];
          pillPhrase.classList.remove('is-fading');
          pillPhrase.classList.add('is-entering');
          requestAnimationFrame(() => { pillPhrase.classList.remove('is-entering'); });
        }, 200);
      }, 3500);
    }

    // ──── PILL: меняем текст на «Контакт передан» когда лид
    function setPillSubmitted(): void {
      pillPhrase.previousElementSibling?.remove();
      const pillTextWrap = toggleBtn.querySelector('.chat-pill-text') as HTMLSpanElement;
      pillTextWrap.innerHTML = `
        <span class="text-brand-text font-semibold text-sm tracking-tight">Менеджер свяжется</span>
        <span class="text-brand-cta text-[11px] flex items-center gap-1">✓ Контакт передан</span>`;
    }

    // ──── HEADER: статус (default / typing) ────
    function setHeaderTyping(typing: boolean): void {
      const statusEl = statusLine.querySelector('.chat-status-text') as HTMLSpanElement;
      if (typing) {
        widget!.dataset.status = 'typing';
        statusEl.innerHTML = `Печатает<span class="typing-cursor"></span>`;
      } else {
        widget!.dataset.status = leadSubmitted ? 'submitted' : 'ready';
        statusEl.textContent = STATUS_DEFAULT;
      }
    }

    // ──── WELCOME: typed-эффект word-by-word ────
    async function playTypedWelcome(): Promise<void> {
      // typing skeleton сначала (как будто Анастасия "печатает")
      typingEl.classList.remove('hidden');
      setHeaderTyping(true);
      await sleep(700);
      typingEl.classList.add('hidden');

      // печатаем первую строку
      await typeWords(welcomeP1, WELCOME_LINE_1, 55);
      await sleep(280);
      // вторая строка
      await typeWords(welcomeP2, WELCOME_LINE_2, 50);

      setHeaderTyping(false);
      localStorage.setItem(STORAGE_WELCOMED, '1');

      // показать стартеры (они сами появятся со stagger через CSS)
      startersEl.style.display = 'flex';
    }

    async function typeWords(el: HTMLElement, text: string, perWord = 60): Promise<void> {
      el.textContent = '';
      const words = text.split(' ');
      for (let i = 0; i < words.length; i++) {
        el.textContent += (i > 0 ? ' ' : '') + words[i];
        // быстрая печать, замедление на знаках препинания
        const w = words[i];
        const extra = /[.,!?:]$/.test(w) ? 80 : 0;
        await sleep(perWord + extra);
      }
    }

    function setInstantWelcome(): void {
      welcomeP1.textContent = WELCOME_LINE_1;
      welcomeP2.textContent = WELCOME_LINE_2;
    }

    // ──── Сообщения ────
    function renderMessage(msg: ChatMessage): void {
      const row = document.createElement('div');
      row.className = `chat-msg chat-msg-${msg.role}`;
      const bubble = document.createElement('div');
      bubble.className = `chat-bubble chat-bubble-${msg.role}`;
      if (msg.role === 'assistant') {
        bubble.innerHTML = renderMarkdown(msg.content);
      } else {
        bubble.textContent = msg.content;
      }
      row.appendChild(bubble);
      messagesEl.appendChild(row);
    }
    function scrollToBottom(): void {
      requestAnimationFrame(() => { messagesEl.scrollTop = messagesEl.scrollHeight; });
    }
    function hideStarters(): void { startersEl?.remove(); }

    // ──── Открытие / закрытие ────
    function setOpen(open: boolean): void {
      widget!.dataset.state = open ? 'open' : 'closed';
      if (!open) return;

      // Если есть сохранённая история — отрисуем её
      if (history.length > 0 && !messagesEl.dataset.hydrated) {
        messagesEl.querySelector('.chat-msg-welcome')?.remove();
        hideStarters();
        history.forEach(renderMessage);
        messagesEl.dataset.hydrated = '1';
        scrollToBottom();
      } else if (history.length === 0) {
        // Свежий клиент. Решаем — typed welcome или мгновенный
        const wasWelcomed = localStorage.getItem(STORAGE_WELCOMED) === '1';
        if (!wasWelcomed) {
          // стартеры скрываем до окончания welcome
          startersEl.style.display = 'none';
          void playTypedWelcome();
        } else {
          setInstantWelcome();
        }
      }

      if (leadSubmitted) widget!.dataset.status = 'submitted';
      scrollToBottom();
      setTimeout(() => input.focus(), 220);
      (window as any).ymGoal?.('chat_opened');
    }

    function autoResize(): void {
      input.style.height = 'auto';
      input.style.height = `${Math.min(input.scrollHeight, 128)}px`;
    }
    function updateSendState(): void {
      sendBtn.disabled = input.value.trim().length === 0;
    }

    // Флаг — идёт ли сейчас запрос. Защищает от двойной отправки, при этом
    // input остаётся разблокированным — клиент может печатать следующий
    // вопрос, пока ждёт ответ на предыдущий.
    let isSending = false;

    async function send(text: string): Promise<void> {
      const trimmed = text.trim();
      if (!trimmed) return;
      if (isSending) return;  // уже летит запрос — игнорируем повторный submit
      isSending = true;
      clearIdle();
      // Убираем idle-подсказку и старый contact-request блок если есть
      messagesEl.querySelector('.chat-idle-prompt')?.remove();
      messagesEl.querySelector('.chat-contact-request')?.remove();
      // Клиент может писать и после лида — отправляем как обычно.
      // Защита от двойного submit_lead — на бэкенде.
      hideStarters();
      messagesEl.querySelector('.chat-msg-welcome')?.remove();

      const userMsg: ChatMessage = { role: 'user', content: trimmed };
      history.push(userMsg);
      renderMessage(userMsg);
      scrollToBottom();

      // Сбрасываем активные маски (телефон / @ник) — следующий ввод
      // будет обычным текстовым сообщением.
      resetContactMasks();
      input.value = '';
      autoResize();
      updateSendState();
      // input НЕ блокируем — клиент может печатать следующее сообщение
      typingEl.classList.remove('hidden');
      setHeaderTyping(true);
      scrollToBottom();

      // Готовим пустой ассистентский bubble — наполним по мере стрима
      const row = document.createElement('div');
      row.className = 'chat-msg chat-msg-assistant';
      const bubble = document.createElement('div');
      bubble.className = 'chat-bubble chat-bubble-assistant';
      row.appendChild(bubble);

      let assistantText = '';
      let bubbleMounted = false;
      let leadFlag = false;

      function mountBubble(): void {
        if (bubbleMounted) return;
        typingEl.classList.add('hidden');
        messagesEl.appendChild(row);
        bubbleMounted = true;
      }

      // Чистим устаревший fallback-кеш если был
      try { localStorage.removeItem('ubuyer_chat_endpoint_v1'); } catch {}

      // Обычный POST → JSON. Никакого стриминга — Cloud Function отдаёт готовый
      // ответ {reply, leadSubmitted}. Таймаут 60 сек — Claude иногда долго
      // отвечает на длинных диалогах. ВАЖНО: один общий try/catch/finally
      // вокруг всего — иначе при сетевой ошибке finally не выполняется и
      // typing-skeleton висит бесконечно.
      const ctrl = new AbortController();
      const timeoutId = setTimeout(() => ctrl.abort(), 60000);

      // Не шлём всю историю — Claude получает только последние 12 сообщений.
      // Это снижает latency и стоимость, и избегает таймаутов на длинных
      // диалогах. Системный промпт на бэке остаётся полным (контекст бренда).
      const trimmedHistory = history.slice(-12);

      try {
        let payload: { reply?: string; leadSubmitted?: boolean; error?: string };
        // Контекст с CTA — отправляем только при первом запросе сессии,
        // дальше зануляем. Claude уже знает откуда юзер пришёл.
        const ctxToSend = pendingCtaContext;
        pendingCtaContext = null;
        try {
          // ВАЖНО: Content-Type: text/plain делает это "simple CORS request" —
          // браузер НЕ шлёт OPTIONS preflight. На мобильных сетях preflight к
          // ai.u-buyer.ru виснет (GET к тому же endpoint проходит за 1 сек).
          // Тело по-прежнему JSON-string, Cloud Function парсит вручную.
          const res = await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'text/plain;charset=UTF-8' },
            body: JSON.stringify({
              sessionId,
              messages: trimmedHistory,
              ...(ctxToSend ? { ctaContext: ctxToSend } : {}),
            }),
            signal: ctrl.signal,
            credentials: 'omit',
            cache: 'no-store',
          });
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          payload = await res.json();
          if (payload.error) throw new Error(payload.error);
        } catch (e) {
          const msg = e instanceof Error
            ? (e.name === 'AbortError' ? 'Превышено время ожидания (30 сек)' : e.message)
            : String(e);
          throw new Error(`fetch failed: ${msg}`);
        }

        assistantText = (payload.reply ?? '').trim();
        leadFlag = payload.leadSubmitted === true;

        if (assistantText) {
          mountBubble();
          bubble.innerHTML = renderMarkdown(assistantText);
        }

        scrollToBottom();

        if (!assistantText.trim()) {
          mountBubble();
          bubble.textContent = 'Связь временно недоступна. Попробуйте ещё раз.';
          return;
        }

        // Срезаем технический маркер из сохраняемой истории (визуально его и так не было)
        const cleanedReply = assistantText.replace(CONTACT_MARKER_RE, ' ').trim();
        history.push({ role: 'assistant', content: cleanedReply });
        saveHistory(history);

        // Триггер contact-блока: либо явный маркер от Claude, либо эвристика
        const hasMarker = CONTACT_MARKER_RE.test(assistantText);
        CONTACT_MARKER_RE.lastIndex = 0;  // сброс — regex с /g сохраняет state
        const lowered = assistantText.toLowerCase();
        const hasContactHint =
          /как удобнее связаться/.test(lowered) ||
          /как с вами связаться/.test(lowered) ||
          /оставьте.{0,20}(контакт|telegram|телефон|ник)/.test(lowered) ||
          /(telegram-?ник|telegram\s+ник|телеграм-?ник)/.test(lowered) ||
          (/номер телефона/.test(lowered) && /telegram/.test(lowered));

        if ((hasMarker || hasContactHint) && !leadSubmitted) {
          renderContactRequest();
        } else {
          // QR-кнопки на простой квалификационный вопрос
          const qrOptions = parseQrOptions(assistantText);
          if (qrOptions.length > 0 && !leadSubmitted) {
            renderQrButtons(qrOptions);
          }
        }

        if (leadFlag) {
          leadSubmitted = true;
          localStorage.setItem(STORAGE_SUBMITTED, '1');
          widget!.dataset.status = 'submitted';
          setPillSubmitted();
          (window as any).ymGoal?.('chat_lead_submitted');
        } else {
          // Запускаем idle-таймер только если ещё нет лида
          scheduleIdlePrompt();
        }
      } catch (err) {
        console.error('[chat] request failed', err);
        mountBubble();
        const errMsg = err instanceof Error ? err.message : String(err);
        bubble.textContent = `Связь временно недоступна (${errMsg}). Попробуйте отправить сообщение ещё раз — обычно помогает.`;
      } finally {
        clearTimeout(timeoutId);
        isSending = false;
        typingEl.classList.add('hidden');
        setHeaderTyping(false);
        scrollToBottom();
        // НЕ фокусируем input принудительно — клиент мог уже сам набрать
        // следующий вопрос пока ждал ответ, фокус-смена сбила бы каретку.
      }
    }

    function resetChat(): void {
      localStorage.removeItem(STORAGE_SID);
      localStorage.removeItem(STORAGE_HIST);
      localStorage.removeItem(STORAGE_SUBMITTED);
      localStorage.removeItem(STORAGE_WELCOMED);
      // Перезагрузка — самый надёжный способ вернуть виджет в исходное состояние
      window.location.reload();
    }

    // ──── Wiring ────
    toggleBtn.addEventListener('click', () => setOpen(widget!.dataset.state !== 'open'));
    closeBtn.addEventListener('click', () => setOpen(false));
    resetBtn.addEventListener('click', resetChat);

    input.addEventListener('input', () => { autoResize(); updateSendState(); });
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); void send(input.value); }
    });
    form.addEventListener('submit', (e) => { e.preventDefault(); void send(input.value); });

    startersEl?.querySelectorAll<HTMLButtonElement>('.chat-starter').forEach(btn => {
      btn.addEventListener('click', () => void send(btn.dataset.starter ?? ''));
    });

    // Initial
    if (leadSubmitted) { widget!.dataset.status = 'submitted'; setPillSubmitted(); }
    if (history.length === 0 && localStorage.getItem(STORAGE_WELCOMED) === '1') {
      setInstantWelcome();
    }
    updateSendState();
    startPillRotation();

    // ──── Перехват ВСЕХ CTA-кнопок сайта на менеджеров ────
    // Все ссылки на личные чаты менеджеров UBuyer открывают виджет с контекстом.
    // Клиент не уходит со страницы, не ждёт t.me — сразу попадает в живой диалог.
    const MANAGER_USERNAMES = [
      'Manager_UBuyer',
      'ROP_Helen_UBuyer',
      'nastya_UBuyerr',
      'Alexander_Ubuyer',
    ];

    interface CtaContext {
      source: 'pricing' | 'quiz' | 'hero' | 'comparison' | 'safety' | 'faq' | 'generic';
      prefill?: string;        // первое сообщение клиента (если есть смысл)
      autoSend?: boolean;      // отправить prefill автоматически
      triggerText?: string;    // текст кликнутой кнопки/chip — для бэка
      sectionId?: string;      // id секции откуда пришёл — для бэка
    }

    // Контекст текущего перехода с сайта. Шлём на бэк ОДИН РАЗ при первом
    // send после клика на CTA. Дальше Claude уже знает откуда юзер пришёл —
    // повторять нет смысла.
    let pendingCtaContext: { source: CtaContext['source']; triggerText?: string; sectionId?: string } | null = null;

    // ── Контактные маски: один input, два режима (телефон / @ник).
    // Активируются по клику на "Телефон" или "Telegram-ник" в contact-request
    // блоке. После отправки сообщения — обе сбрасываются.
    let phoneMaskHandler: ((e: Event) => void) | null = null;
    let telegramValidateHandler: ((e: Event) => void) | null = null;

    function formatPhoneMask(raw: string): string {
      // Нормализуем: только цифры, без ведущих 7/8 (всё после +7).
      const digits = raw.replace(/\D/g, '').replace(/^[78]/, '').slice(0, 10);
      let f = '+7';
      if (digits.length > 0) f += ' ' + digits.slice(0, 3);
      if (digits.length > 3) f += ' ' + digits.slice(3, 6);
      if (digits.length > 6) f += ' ' + digits.slice(6, 8);
      if (digits.length > 8) f += ' ' + digits.slice(8, 10);
      return f;
    }
    function enablePhoneMask(el: HTMLTextAreaElement): void {
      disablePhoneMask(el);
      disableTelegramValidation(el);
      el.placeholder = '+7 ___ ___ __ __';
      el.value = '+7 ';
      el.dataset.inputMode = 'phone';
      phoneMaskHandler = () => { el.value = formatPhoneMask(el.value); updateSendState(); };
      el.addEventListener('input', phoneMaskHandler);
    }
    function disablePhoneMask(el: HTMLTextAreaElement): void {
      if (phoneMaskHandler) {
        el.removeEventListener('input', phoneMaskHandler);
        phoneMaskHandler = null;
      }
      if (el.dataset.inputMode === 'phone') delete el.dataset.inputMode;
    }

    // Telegram-ник: автоматически держим '@' префиксом, валидируем формат
    // [a-zA-Z0-9_]{5,32}. Подсветка ошибки — через классы на inputWrap.
    const TG_USERNAME_RE = /^@[a-zA-Z0-9_]{5,32}$/;
    function enableTelegramValidation(el: HTMLTextAreaElement): void {
      disableTelegramValidation(el);
      disablePhoneMask(el);
      el.placeholder = '@ваш_ник';
      el.value = '@';
      el.dataset.inputMode = 'telegram';
      telegramValidateHandler = () => {
        // Принудительно держим '@' первым символом — кириллица/пробелы вырезаем.
        let v = el.value.replace(/[^@a-zA-Z0-9_]/g, '');
        if (!v.startsWith('@')) v = '@' + v.replace(/^@+/, '');
        if (v.length > 33) v = v.slice(0, 33);  // @ + 32 символа
        el.value = v;
        const valid = TG_USERNAME_RE.test(v);
        const tooShort = v.length > 1 && v.length < 6;
        // Показываем подсветку ошибки только когда юзер уже что-то ввёл
        inputWrap.classList.toggle('chat-input-invalid', !valid && v.length > 1);
        sendBtn.disabled = !valid;
        // Если ник полностью валиден — даём send-кнопке стать активной
        // даже при отсутствии других триггеров (override updateSendState).
        if (valid) sendBtn.disabled = false;
        // Подсказка снизу — динамически
        let hintEl = inputWrap.querySelector('.chat-tg-hint') as HTMLDivElement | null;
        if (!hintEl) {
          hintEl = document.createElement('div');
          hintEl.className = 'chat-tg-hint';
          inputWrap.parentElement?.insertBefore(hintEl, inputWrap.nextSibling);
        }
        if (valid) {
          hintEl.textContent = '✓ Ник корректный — можно отправлять';
          hintEl.dataset.state = 'ok';
        } else if (tooShort) {
          hintEl.textContent = `Ещё ${6 - v.length} символ(а) — Telegram требует минимум 5`;
          hintEl.dataset.state = 'pending';
        } else if (v.length > 1) {
          hintEl.textContent = 'Только латиница, цифры и подчёркивание';
          hintEl.dataset.state = 'error';
        } else {
          hintEl.textContent = 'Где взять: Telegram → Настройки → Имя пользователя';
          hintEl.dataset.state = 'pending';
        }
      };
      el.addEventListener('input', telegramValidateHandler);
      // Триггерим один раз чтобы показать стартовую подсказку
      telegramValidateHandler(new Event('input'));
    }
    function disableTelegramValidation(el: HTMLTextAreaElement): void {
      if (telegramValidateHandler) {
        el.removeEventListener('input', telegramValidateHandler);
        telegramValidateHandler = null;
      }
      if (el.dataset.inputMode === 'telegram') delete el.dataset.inputMode;
      inputWrap.classList.remove('chat-input-invalid');
      inputWrap.parentElement?.querySelector('.chat-tg-hint')?.remove();
    }
    function resetContactMasks(): void {
      disablePhoneMask(input);
      disableTelegramValidation(input);
      input.placeholder = 'Опишите ситуацию или задайте вопрос…';
    }

    function detectCtaContext(link: HTMLAnchorElement, href: string): CtaContext {
      const labelRaw = (link.textContent ?? '').trim();
      const labelLower = labelRaw.toLowerCase();
      const sectionId = link.closest('section')?.id ?? '';
      const dataCta = link.dataset.cta ?? '';
      let prefill: string | undefined;

      // 1. ?text=... из href (например, Quiz собирает выбранные цели)
      try {
        const url = new URL(href, window.location.href);
        const tParam = url.searchParams.get('text')?.trim();
        if (tParam && !/^Привет,?\s+пишу с сайта/i.test(tParam)) {
          prefill = tParam;
        }
      } catch {}

      // 2. Определяем источник: явный data-cta → section id → текст кнопки
      let source: CtaContext['source'] = 'generic';
      let autoSend = false;
      if (dataCta === 'hero_primary') {
        source = 'hero';
        autoSend = !!prefill;  // если в href есть ?text=... → шлём автоматом
      } else if (dataCta === 'pricing_primary') {
        source = 'pricing';
        autoSend = !!prefill;
      } else if (dataCta === 'final_primary') {
        source = 'generic';     // финальный CTA — общая квалификация
        autoSend = !!prefill;
      } else if (dataCta === 'chip') {
        // Chip — готовый вопрос. Источник — из id секции, отправляется автоматом.
        if (sectionId === 'comparison') source = 'comparison';
        else if (sectionId === 'safety') source = 'safety';
        else if (sectionId === 'pricing') source = 'pricing';
        else if (sectionId === 'faq') source = 'faq';
        else if (sectionId === 'hero') source = 'hero';
        else source = 'generic';
        autoSend = !!prefill;  // у chip всегда есть prefill в href ?text=
      } else if (prefill) {
        source = 'quiz';  // если есть prefill — это квиз/конфигуратор
        autoSend = true;
      } else if (sectionId === 'comparison' || /сравнен/i.test(labelLower)) {
        source = 'comparison';
      } else if (sectionId === 'safety' || /безопас|забанят|блокиров/i.test(labelLower)) {
        source = 'safety';
      } else if (sectionId === 'faq') {
        source = 'faq';
      } else if (sectionId === 'pricing' || /рассчит|стоимост|тариф|цен/i.test(labelLower)) {
        source = 'pricing';
      } else if (/получить расчёт|получить расчет/i.test(labelLower)) {
        source = 'quiz';
      } else if (sectionId === 'hero' || link.closest('section')?.querySelector('h1')) {
        source = 'hero';
      }

      return {
        source,
        prefill,
        autoSend,
        triggerText: labelRaw || undefined,
        sectionId: sectionId || undefined,
      };
    }

    /** Применяет контекст CTA к виджету: подменяет welcome или авто-отправляет prefill. */
    function applyCtaContext(ctx: CtaContext): void {
      // Сохраняем для отправки на бэк при первом send() — Claude получит
      // структурированный контекст в системном промпте.
      pendingCtaContext = {
        source: ctx.source,
        triggerText: ctx.triggerText,
        sectionId: ctx.sectionId,
      };

      // Не трогаем существующий диалог — клиент уже общался, не сбрасываем
      if (history.length > 0) {
        if (ctx.prefill) {
          setTimeout(() => {
            input.value = ctx.prefill!;
            autoResize();
            updateSendState();
            input.focus();
          }, 350);
        }
        return;
      }

      // Welcome card подменяем в зависимости от источника
      const welcomeMap: Record<CtaContext['source'], { title: string; text: string }> = {
        pricing: {
          title: 'Помогу с расчётом стоимости',
          text: 'Подскажите, что продаёте и какая задача — посчитаю масштаб под вашу нишу.',
        },
        quiz: {
          title: 'Принял ваш запрос',
          text: 'Сейчас уточню пару деталей и передам менеджеру с расчётом.',
        },
        hero: {
          title: 'Помогу разобраться',
          text: 'По тарифам, стратегии, кейсам — что интересует?',
        },
        comparison: {
          title: 'Разберу отличия от альтернатив',
          text: 'Часто спрашивают про софты и дешёвые сервисы — расскажу честно, в чём подвох.',
        },
        safety: {
          title: 'Расскажу про безопасность',
          text: 'Почему у нас 0 блокировок за 3 года — на конкретных параметрах. Что интересует?',
        },
        faq: {
          title: 'Отвечу на ваш вопрос',
          text: 'Спросите — отвечу коротко и по делу.',
        },
        generic: {
          title: WELCOME_LINE_1,
          text: WELCOME_LINE_2,
        },
      };
      // Перед подменой welcome — отмечаем что typed-эффект не нужен и останавливаем его
      localStorage.setItem(STORAGE_WELCOMED, '1');
      // Применяем подмену через requestAnimationFrame, чтобы перебить
      // возможный typed-эффект который мог стартовать одновременно
      requestAnimationFrame(() => {
        const w = welcomeMap[ctx.source];
        welcomeP1.textContent = w.title;
        welcomeP2.textContent = w.text;
      });

      // Prefill: для chip / quiz (где есть autoSend) — отправляем автоматом,
      // юзер кликнул готовый вопрос и ждёт ответа. Иначе кладём в input —
      // клиент сам жмёт Enter, может отредактировать.
      if (ctx.prefill) {
        if (ctx.autoSend) {
          // Небольшая задержка чтобы welcome успел подмениться визуально
          setTimeout(() => { void send(ctx.prefill!); }, 350);
        } else {
          setTimeout(() => {
            input.value = ctx.prefill!;
            autoResize();
            updateSendState();
            input.focus();
          }, 400);
        }
      }
    }

    document.addEventListener('click', (e) => {
      const targetEl = e.target as HTMLElement | null;
      if (!targetEl) return;
      const link = targetEl.closest('a') as HTMLAnchorElement | null;
      if (!link) return;
      const href = link.getAttribute('href') ?? '';
      const isManagerLink = MANAGER_USERNAMES.some(u =>
        href.includes(`t.me/${u}`) || href.includes(`tg://resolve?domain=${u}`)
      );
      if (!isManagerLink) return;

      e.preventDefault();
      e.stopPropagation();

      const ctx = detectCtaContext(link, href);
      setOpen(true);
      applyCtaContext(ctx);
      (window as any).ymGoal?.(`site_cta_to_widget_${ctx.source}`);
    }, true);
    void inputWrap;
  }
</script>
