    function scrollToBottom(force = false): void {
      // Fix H: smart-scroll. Если юзер прокрутил вверх читать историю —
      // не дёргаем его. Показываем «↓ Новое сообщение» кнопкой, по клику —
      // скроллим. Это стандартный паттерн мессенджеров (Telegram, WhatsApp).
      if (!force && !isAtBottom()) {
        showNewMsgBadge();
        return;
      }
      hideNewMsgBadge();
      // Fix C: smooth scroll вместо моментального — большие блоки больше
      // не «прыгают»
      requestAnimationFrame(() => {
        messagesEl.scrollTo({ top: messagesEl.scrollHeight, behavior: 'smooth' });
      });
    }
    /** Fix F: мягкое удаление через fade-out вместо instant remove() */
    function fadeOutRemove(el: Element | null, ms = 200): void {
      if (!el) return;
      const node = el as HTMLElement;
      node.style.transition = `opacity ${ms}ms ease-out, transform ${ms}ms ease-out`;
      node.style.opacity = '0';
      node.style.transform = 'translateY(-4px)';
      setTimeout(() => node.remove(), ms);
