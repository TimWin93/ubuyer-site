---
import { NAV_LINKS, SITE_NAME, CONTACTS } from '@/consts';
---

<header class="fixed top-0 left-0 right-0 z-50 border-b border-brand-border bg-brand-bg/90 backdrop-blur-md">
  <div class="container flex items-center justify-between h-16">

    <!-- лого -->
    <a href="/" class="flex items-center gap-1 shrink-0 group">
      <span class="font-bold text-xl text-brand-text tracking-tight">
        <span class="text-brand-accent">U</span>Buyer
      </span>
      <img
        src="/images/logo-hand.png"
        alt=""
        class="logo-hand h-[52px] w-[52px] object-contain shrink-0"
      />
    </a>

    <!-- desktop nav -->
    <nav class="hidden md:flex items-center gap-7 text-sm font-medium text-brand-muted">
      {NAV_LINKS.map((link) => (
        <a href={link.href} class="hover:text-brand-text transition-colors">{link.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <!-- телефон -->
      <a href={`tel:${CONTACTS.phoneTel}`}
         class="phone-btn hidden sm:inline-flex items-center gap-2 text-sm font-semibold
                text-brand-text hover:text-brand-accent transition-colors">
        <span class="phone-icon-wrap relative flex items-center justify-center w-8 h-8 rounded-lg
                     bg-brand-accent/10 border border-brand-accent/30">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24"
               fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
               class="text-brand-accent relative z-10">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.41 2 2 0 0 1 3.6 1.24h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 8.8a16 16 0 0 0 6.29 6.29l.96-.96a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          <!-- свечение -->
          <span class="absolute inset-0 rounded-lg bg-brand-accent/20 animate-phone-glow"></span>
        </span>
        {CONTACTS.phone}
      </a>

      <!-- desktop CTA -->
      <a href={CONTACTS.telegram} target="_blank" rel="noopener"
         class="hidden md:inline-flex btn-primary text-sm py-2.5 px-5">
        Получить расчёт
      </a>

      <!-- mobile: кнопка-звонок -->
      <a href={`tel:${CONTACTS.phoneTel}`}
         class="sm:hidden flex items-center justify-center w-10 h-10 rounded-xl
                border border-brand-accent/30 bg-brand-accent/10 hover:bg-brand-accent/20 transition-colors"
         aria-label="Позвонить">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
             class="text-brand-accent">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.41 2 2 0 0 1 3.6 1.24h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 8.8a16 16 0 0 0 6.29 6.29l.96-.96a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
        </svg>
      </a>

      <!-- mobile burger -->
      <button
        id="burger"
        class="md:hidden flex flex-col justify-center items-center w-10 h-10 gap-1.5 rounded-xl
               border border-brand-border hover:border-brand-border-2 transition-colors"
        aria-label="Меню"
      >
        <span class="burger-line w-5 h-0.5 bg-brand-text rounded transition-all duration-200"></span>
        <span class="burger-line w-5 h-0.5 bg-brand-text rounded transition-all duration-200"></span>
        <span class="burger-line w-5 h-0.5 bg-brand-text rounded transition-all duration-200"></span>
      </button>
    </div>
  </div>

  <!-- mobile menu -->
  <div
    id="mobile-menu"
    class="md:hidden hidden border-t border-brand-border bg-brand-bg/95 backdrop-blur-md"
  >
    <nav class="container py-4 flex flex-col gap-1">
      {NAV_LINKS.map((link) => (
        <a href={link.href}
           class="text-brand-muted hover:text-brand-text py-3 px-3 rounded-xl
                  hover:bg-brand-surface transition-colors text-sm font-medium">
          {link.label}
        </a>
      ))}
      <div class="pt-3 border-t border-brand-border mt-2 flex flex-col gap-2">
        <a href={CONTACTS.telegram} target="_blank" rel="noopener"
           class="btn-primary w-full justify-center text-sm">
          Написать менеджеру
        </a>
        <a href={CONTACTS.channel} target="_blank" rel="noopener"
           class="btn-ghost w-full justify-center text-sm">
          Telegram-канал
        </a>
      </div>
    </nav>
  </div>
</header>

<script is:inline>
  const burger = document.getElementById('burger');
  const menu = document.getElementById('mobile-menu');
  const lines = burger?.querySelectorAll('.burger-line');

  burger?.addEventListener('click', () => {
    const open = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    if (lines) {
      if (!open) {
        lines[0].classList.add('rotate-45', 'translate-y-2');
        lines[1].classList.add('opacity-0');
        lines[2].classList.add('-rotate-45', '-translate-y-2');
      } else {
        lines[0].classList.remove('rotate-45', 'translate-y-2');
        lines[1].classList.remove('opacity-0');
        lines[2].classList.remove('-rotate-45', '-translate-y-2');
      }
    }
  });

  // закрывать при клике на ссылку
  menu?.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => {
      menu.classList.add('hidden');
      lines?.[0].classList.remove('rotate-45', 'translate-y-2');
      lines?.[1].classList.remove('opacity-0');
      lines?.[2].classList.remove('-rotate-45', '-translate-y-2');
    });
  });
</script>

<style>
  .logo-hand {
    -webkit-mask-image: radial-gradient(ellipse 78% 82% at 50% 50%, black 58%, transparent 80%);
    mask-image: radial-gradient(ellipse 78% 82% at 50% 50%, black 58%, transparent 80%);
    filter: drop-shadow(0 6px 14px rgba(0, 0, 0, 0.35));
    transition: filter 0.2s ease, transform 0.2s ease;
  }
  .group:hover .logo-hand {
    filter: drop-shadow(0 8px 18px rgba(0, 0, 0, 0.45));
    transform: translateY(-1px);
  }
</style>
