---
import '@/styles/global.css';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import ChatWidget from '@/components/ui/ChatWidget.astro';  // временно вернул для просмотра
import { buildSeo } from '@/lib/seo';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  path?: string;
}

const seo = buildSeo(Astro.props);
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <link rel="canonical" href={seo.canonical} />
    {seo.noindex
      ? <meta name="robots" content="noindex,nofollow" />
      : <meta name="robots" content="index,follow" />
    }

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" />

    <!-- OpenGraph -->
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:image" content={seo.image} />
    <meta property="og:url" content={seo.canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={seo.image} />

    <link rel="icon" type="image/png" sizes="64x64" href="/favicon-64.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#04091A" />
    <meta name="yandex-verification" content="ef8c0cf052fc9f25" />
    <meta name="yandex-verification" content="7641db8649bd999d" />
    <meta name="google-site-verification" content="q5O7wB4Av6X3vuOr95K2auaV1iRpNRvCeAuWMLfdVAA" />
    <meta name="google-site-verification" content="_zBZgpqLlahZCE7NSLvTM9yI6pv8FXTZQBXbD-EhaLQ" />

    <!-- Schema.org: LocalBusiness + Services + WebSite -->
    <script type="application/ld+json" is:inline>
    [
      {
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        "@id": "https://u-buyer.ru/#organization",
        "name": "UBuyer",
        "alternateName": "ЮБаер — самовыкупы WB и OZON",
        "description": "Поднимаем карточки селлеров в топ Wildberries и OZON через живые самовыкупы. 3 000+ покупательских профилей с историей 3+ лет — WB видит реальных людей, не ботов. Товар не сжигается: после выкупа возвращается на ваш склад WB. Управляем конкретными ключевыми запросами. 0 блокировок клиентов за 3 года. Договор, акты, закрывающие документы.",
        "url": "https://u-buyer.ru",
        "logo": "https://u-buyer.ru/favicon.png",
        "image": "https://u-buyer.ru/images/og/default.jpg",
        "telephone": "+7-978-567-27-45",
        "email": "info@ubuyer.ru",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Москва",
          "addressRegion": "Московская область",
          "addressCountry": "RU"
        },
        "contactPoint": {
          "@type": "ContactPoint",
          "contactType": "customer service",
          "telephone": "+7-978-567-27-45",
          "url": "https://t.me/Manager_UBuyer",
          "availableLanguage": "Russian"
        },
        "makesOffer": [
          {
            "@type": "Offer",
            "name": "Самовыкупы Wildberries",
            "description": "Карточка не растёт без оборота — мы создаём оборот живыми людьми. 3 000+ профилей, 3 000+ ПВЗ в Москве и МО. Каждый заказ с отдельного устройства, IP и района. WB не видит паттерна.",
            "url": "https://u-buyer.ru/#pricing"
          },
          {
            "@type": "Offer",
            "name": "Самовыкупы OZON",
            "description": "Продвижение карточек OZON через живые выкупы. Тот же принцип: алгоритм видит оборот — карточка растёт в выдаче. Договор и отчётность.",
            "url": "https://u-buyer.ru/#pricing"
          },
          {
            "@type": "Offer",
            "name": "Управление ключевыми запросами",
            "description": "Распределяем объём по конкретным ключевым словам с нужной скоростью. Можем поднять карточку по конкретному запросу, а не просто нагнать оборот.",
            "url": "https://u-buyer.ru/kak-rabotaem"
          },
          {
            "@type": "Offer",
            "name": "Перехват полок конкурентов",
            "description": "Встаём в рекомендации к топовым конкурентам. Часть их трафика уходит в ваши полки — бесплатно для вас.",
            "url": "https://u-buyer.ru/kak-rabotaem"
          }
        ],
        "sameAs": [
          "https://t.me/+zTWXRN30e6UzYWZi"
        ]
      },
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "@id": "https://u-buyer.ru/#website",
        "url": "https://u-buyer.ru",
        "name": "UBuyer — Самовыкупы на Wildberries и OZON",
        "publisher": { "@id": "https://u-buyer.ru/#organization" }
      }
    ]
    </script>
    <link rel="preconnect" href="https://mc.yandex.ru" />

    <!-- Yandex Metrica -->
    {import.meta.env.YANDEX_METRICA_ID && (
      <script is:inline define:vars={{ ymId: import.meta.env.YANDEX_METRICA_ID }}>
        (function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
        m[i].l=1*new Date();k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,
        k.src=r,a.parentNode.insertBefore(k,a)})(window,document,'script',
        'https://mc.yandex.ru/metrika/tag.js','ym');
        ym(ymId,'init',{clickmap:true,trackLinks:true,accurateTrackBounce:true,webvisor:true});
        window.__ymId = ymId;
        window.ymGoal = function(goal) { if (typeof ym === 'function') ym(ymId, 'reachGoal', goal); };

        document.addEventListener('click', function(e) {
          var a = e.target.closest('a');
          if (!a) return;
          var href = a.getAttribute('href') || '';
          if (href.indexOf('t.me') !== -1)  ym(ymId,'reachGoal','click_telegram');
          if (href.indexOf('tel:') !== -1)   ym(ymId,'reachGoal','click_phone');
          if (href.indexOf('#pricing') !== -1) ym(ymId,'reachGoal','click_pricing');
        });
      </script>
    )}
  </head>
  <body>
    <Header />
    <main class="pt-16">
      <slot />
    </main>
    <Footer />
    <ChatWidget />
  </body>
</html>
